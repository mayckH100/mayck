{
  "name": "mckbot",
  "version": "1.0.0",
  "private": true,
  "description": "MCKBOT — plataforma SaaS de automação de atendimento no WhatsApp (QR code via Baileys; Cloud API oficial opcional) com IA",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "SQLITE_URL=file:./dev.db tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "db:sqlite": "node scripts/sqlite-schema.mjs && prisma generate --schema prisma/sqlite/schema.prisma",
    "db:pg": "prisma generate --schema prisma/schema.prisma",
    "build": "prisma generate --schema prisma/schema.prisma && vite build --config web/vite.config.ts && tsc -p tsconfig.server.json",
    "start": "prisma migrate deploy --schema prisma/schema.prisma && node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "npm run db:sqlite && vitest run",
    "test:e2e": "npm run db:sqlite && npm run build:local && NO_PROXY=127.0.0.1,localhost no_proxy=127.0.0.1,localhost playwright test",
    "build:local": "vite build --config web/vite.config.ts && tsc -p tsconfig.server.json",
    "db:migration:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "test:pg": "npm run db:pg && TEST_DB=postgres vitest run tests/integration; npm run db:sqlite",
    "dev:setup": "npm run db:sqlite && SQLITE_URL=file:./dev.db prisma db push --schema prisma/sqlite/schema.prisma --skip-generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@whiskeysockets/baileys": "^6.7.24",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.2.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "undici": "^6.29.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
