# ===== MCKBOT — variáveis de ambiente =====
# Produção (PostgreSQL). Neon: copie a "connection string" e mantenha ?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/mckbot?sslmode=require

# Chave mestra para cifrar tokens e chaves (AES-256-GCM). 32 bytes em base64.
# Gere com: openssl rand -base64 32   — guarde em local seguro; trocar torna os segredos salvos ilegíveis.
MASTER_KEY=

NODE_ENV=production
PORT=3000
# URL pública (opcional no Render: RENDER_EXTERNAL_URL é usada automaticamente)
PUBLIC_URL=

# Opcionais
GRAPH_API_VERSION=v26.0
FLOW_MAX_STEPS=50
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=300
WEBHOOK_RATE_LIMIT=600
ENABLE_SCHEDULER=true

# Desenvolvimento local com SQLite (npm run db:sqlite gera o cliente SQLite)
# SQLITE_URL=file:./dev.db
