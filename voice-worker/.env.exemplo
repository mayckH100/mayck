# Copie para .env NA VM (nunca no repositório) e preencha:
# Domínio grátis a partir do IP público da VM, ex.: 129-146-10-20.sslip.io
VOICE_DOMAIN=
# Mesmo valor que vai no Render em VOICE_WORKER_SECRET (openssl rand -hex 32)
VOICE_WORKER_SECRET=
# Chave que cifra as vozes no disco do worker (openssl rand -base64 32). Só existe na VM.
VOICE_DATA_KEY=
# Opcional: ajuste fino do português do Brasil (MIT)
# VOICE_T3_REPO=ResembleAI/Chatterbox-Multilingual-pt-br
VOICE_THREADS=2
# Modo qualidade (Chatterbox, fala o texto direto na voz clonada): ~3,9 GB de RAM e lento em 2 núcleos
# (medido: ~26x o tempo real no sandbox ARM de 2 vCPU). Deixe 0 na VM grátis de 2 OCPU; o modo rápido
# (OpenVoice v2, ~1,3x o tempo real, 1,1 GB) atende as conversas. Ligue (1) só em máquina com 8+ núcleos.
VOICE_QUALITY=0
VOICE_MAX_QUEUE=40
