// MCKBOT — schema principal (PostgreSQL em produção).
// Para dev/testes, scripts/sqlite-schema.mjs gera prisma/sqlite/schema.prisma trocando o provider.
// Campos JSON são armazenados como texto (String) para manter compatibilidade entre PostgreSQL e SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String
  phone            String?
  passwordHash     String
  isSuperAdmin     Boolean       @default(false)
  disabledAt       DateTime?
  emailVerifiedAt  DateTime?
  /// CPF (11) ou CNPJ (14) do titular, só dígitos. Dado pessoal: nunca em log/auditoria; mascarado na interface.
  documento        String?       @unique
  /// Celular do titular em E.164 (+5511912345678); também serve de identificador no login.
  celular          String?       @unique
  /// Verificação em duas etapas (TOTP): segredo cifrado (AES-GCM com MASTER_KEY); pendente = em configuração.
  totpSecretEnc    String?
  totpPendingEnc   String?
  totpEnabledAt    DateTime?
  totpLastStep     Int?
  /// Hashes SHA-256 dos códigos de recuperação ainda não usados (JSON).
  recoveryCodes    String        @default("[]")
  /// Bloqueio temporário após senhas/códigos errados seguidos.
  failedLogins     Int           @default(0)
  lockedUntil      DateTime?
  /// Lembrete por e-mail 3 dias e 1 dia antes de vencer o teste/plano (titular pode desligar no Perfil).
  renewalReminders Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  memberships      Membership[]
  sessions         Session[]
  authTokens       AuthToken[]
  knownDevices     KnownDevice[]
  /// Receber por e-mail o alerta de WhatsApp desconectado (Proprietário/Administrador). Padrão: sim.
  waDownEmail      Boolean       @default(true)
}

/// Aparelhos (navegadores) já usados para entrar; login de aparelho novo gera alerta por e-mail.
model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceHash  String // sha256 do cookie mck_did
  userAgent   String?
  ip          String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
}

/// Execuções do backup diário do banco.
model BackupRun {
  id          String    @id @default(cuid())
  trigger     String    @default("AUTO") // AUTO | MANUAL
  status      String    @default("RUNNING") // RUNNING | OK | FAILED
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  sizeBytes   Int?
  rows        Int?
  destination String?
  location    String?
  error       String?

  @@index([startedAt])
}

/// Tokens de uso único enviados por e-mail (redefinição de senha e verificação de e-mail). Só o hash fica salvo.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  kind      String // RESET_PASSWORD | VERIFY_EMAIL
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// Cadastro aguardando o código enviado por e-mail. Nada é criado em User/Organization antes da confirmação.
model PendingSignup {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  email        String
  name         String
  passwordHash String
  orgName      String
  documento    String
  celular      String
  app          String   @default("mckbot")
  codeHash     String
  attempts     Int      @default(0)
  sends        Int      @default(1)
  /// E-mail já tem conta: nenhum código é enviado (o e-mail avisa "você já tem conta"); a resposta é igual para não vazar.
  existingUser Boolean  @default(false)
  /// Código de indicação (?indica=) informado no cadastro; vira uma Referral quando a conta é criada.
  referralCode String?
  expiresAt    DateTime
  lastSentAt   DateTime @default(now())
  ip           String?
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Organization {
  id                  String       @id @default(cuid())
  name                String
  timezone            String       @default("America/Sao_Paulo")
  plan                String       @default("gratis")
  // Aviso "Aguardando atendente": número de WhatsApp reserva (E.164 BR) e minutos de espera até o aviso.
  backupPhone         String?
  handoffAlertMinutes Int          @default(5)
  /// Números que recebem o aviso no momento da transferência para humano (JSON: ["+55..."]). Nulo = usa backupPhone.
  handoffNotifyPhones String?
  /// Resultado do último aviso de atendimento (JSON: { at, ok, detail }), mostrado no Perfil.
  handoffNotifyStatus String?
  /// O que os números de aviso recebem no WhatsApp (Perfil › Organização): transferência, reunião, tarefa, pedido, falha da IA.
  alertHandoff        Boolean      @default(true)
  alertMeeting        Boolean      @default(true)
  alertTask           Boolean      @default(true)
  alertOrder          Boolean      @default(true)
  /// Falha da IA (não conseguiu responder um cliente): WhatsApp + e-mail ao Proprietário/Admin, máx. 1 por conversa a cada 30 min.
  alertAiFailure      Boolean      @default(true)
  /// Programa de indicação: código do link /cadastro?indica=CODIGO (gerado na primeira vez que o link é pedido).
  referralCode        String?      @unique
  createdAt           DateTime     @default(now())
  memberships         Membership[]
}

model Membership {
  id         String       @id @default(cuid())
  userId     String
  orgId      String
  role       String // OWNER | ADMIN | AGENT
  /// Módulos que o membro pode acessar (JSON: ["inbox","kanban",...]). Nulo = tudo o que o papel permite (comportamento antigo).
  modules    String?
  /// Canais WhatsApp que o membro pode atender (JSON: [channelId,...]). Nulo = todos os canais.
  channelIds String?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        String
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  /// Permissões que o membro recebe ao aceitar (mesmo formato de Membership.modules/channelIds; nulo = padrão do papel/todos).
  modules     String?
  channelIds  String?
  /// Envio do e-mail do convite: último envio e quantidade (limite de reenvio).
  lastSentAt  DateTime?
  sendCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([orgId])
}

model Session {
  id         String    @id // sha256 do token do cookie
  userId     String
  orgId      String?
  csrfToken  String
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      String   @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

model Channel {
  id                  String    @id @default(cuid())
  orgId               String
  name                String
  provider            String    @default("whatsapp_cloud") // whatsapp_cloud (API oficial) | whatsapp_qr (WhatsApp Web via QR code)
  phoneNumberId       String?
  wabaId              String?
  displayPhone        String?
  accessTokenEnc      String?
  appSecretEnc        String?
  verifyToken         String
  status              String    @default("NOT_CONNECTED") // NOT_CONNECTED | CONNECTING | QR_PENDING | CONNECTED | ERROR
  waJid               String? // modo QR: JID do aparelho conectado
  connectedAt         DateTime? // modo QR: quando a sessão foi aberta pela última vez
  lastError           String?
  lastWebhookAt       DateTime?
  lastCheckedAt       DateTime?
  qrLeaseOwner        String? // modo QR: instância do servidor que segura a sessão (evita 2 conexões no deploy)
  qrLeaseUntil        DateTime? // modo QR: validade da trava; expira sozinha se a instância cair
  replySavedContacts  Boolean   @default(false) // modo QR: responder automaticamente contatos salvos na agenda do celular (padrão: não)
  addressBookSyncedAt DateTime? // modo QR: quando a agenda do celular foi sincronizada por completo pela última vez
  autoReplyMode       String    @default("both") // quem responde automaticamente neste canal: flows (só fluxos) | ai (só IA) | both (fluxos + IA, padrão)
  /// Alerta de WhatsApp desconectado: última vez que o monitor viu o canal conectado (canal "armado"; vazio = nunca conectou ou foi desconectado de propósito).
  waUpSeenAt          DateTime?
  /// Início do episódio de desconexão observado pelo monitor (vazio = conectado).
  waDownSince         DateTime?
  /// Alerta (e-mail + aviso no app) enviado neste episódio; lembrete único após 24 h.
  waDownAlertAt       DateTime?
  waDownReminderAt    DateTime?
  /// Voltou a conectar depois de um alerta (aviso "voltou a conectar" no app por 24 h).
  waBackAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([orgId])
}

/// v1.42.0: proteção contra bloqueio de um número conectado por QR (sem registro = padrões seguros).
model ChannelProtection {
  channelId       String    @id
  orgId           String
  /// Limites e ritmo para envios em massa (campanhas, cadências, automações).
  enabled         Boolean   @default(true)
  hourLimit       Int       @default(60)
  dayLimit        Int       @default(300)
  minGapSec       Int       @default(20)
  maxGapSec       Int       @default(60)
  /// Aquecimento: número novo começa com poucos envios por dia e sobe aos poucos.
  warmupEnabled   Boolean   @default(true)
  warmupDays      Int       @default(14)
  /// Início do aquecimento (vazio = data de criação do canal).
  warmupStartedAt DateTime?
  /// "digitando..." antes das respostas automáticas.
  typingEnabled   Boolean   @default(true)
  updatedAt       DateTime  @updatedAt

  @@index([orgId])
}

/// v1.42.0: eventos de saúde do número (desconexões, sessão encerrada, restrição do WhatsApp). Guardados por 30 dias.
model ChannelHealthEvent {
  id        String   @id @default(cuid())
  channelId String
  orgId     String
  /// desconexao | sessao_encerrada | restricao
  type      String
  detail    String?
  createdAt DateTime @default(now())

  @@index([channelId, createdAt])
}

/// v1.45.0: aquecimento ATIVO do número QR (conversas automáticas entre os números da própria empresa).
model WarmupConfig {
  channelId      String    @id
  orgId          String
  enabled        Boolean   @default(false)
  /// Duração em dias (padrão 14), contada a partir de startedAt.
  days           Int       @default(14)
  startedAt      DateTime?
  /// Janela de horário (Brasília): início incluído, fim excluído.
  startHour      Int       @default(8)
  endHour        Int       @default(21)
  /// Ids dos números (canais) que podem ser par deste, separados por vírgula. Vazio = todos os números próprios.
  peerChannelIds String    @default("")
  /// Este número pode responder/ajudar a aquecer os outros números da empresa.
  allowAsPeer    Boolean   @default(true)
  /// Gerar as frases com a IA da empresa (sem IA/cota: banco de frases local).
  useAi          Boolean   @default(true)
  /// Incluir os números próprios extras (celular pessoal etc.) cadastrados pela empresa.
  useExtras      Boolean   @default(true)
  /// Próxima conversa iniciada por este número (o agendador usa como trava atômica).
  nextAt         DateTime?
  /// Motivo da pausa automática (risco, desconectado...). Vazio = rodando.
  pausedReason   String?
  pausedAt       DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([orgId])
}

/// v1.45.0: números próprios extras (até 5 por empresa) declarados pela empresa como dela, para o aquecimento.
model WarmupExtraNumber {
  id                String   @id @default(cuid())
  orgId             String
  /// Só dígitos com DDI (ex.: 5511999990000).
  phone             String
  label             String?
  confirmedByUserId String?
  confirmedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  @@unique([orgId, phone])
}

/// v1.45.0: mensagens do aquecimento. Ficam FORA de Message (não aparecem no Inbox, relatórios, IA ou fluxos).
model WarmupMessage {
  id            String   @id @default(cuid())
  orgId         String
  channelId     String
  /// OUT = enviada por este número | IN = recebida por este número
  direction     String
  /// text | reaction
  kind          String   @default("text")
  peerChannelId String?
  peerPhone     String?
  body          String
  waMessageId   String?
  jid           String?
  exchangeId    String?
  /// ia | local
  source        String?
  createdAt     DateTime @default(now())

  @@index([channelId, createdAt])
  @@index([orgId, waMessageId])
}

/// v1.45.0: conversa de aquecimento em andamento (ida e volta entre dois números próprios).
model WarmupExchange {
  id                 String    @id @default(cuid())
  orgId              String
  initiatorChannelId String
  peerChannelId      String
  /// JSON: lista de falas; pares saem do número que iniciou, ímpares do par.
  lines              String
  nextIndex          Int       @default(1)
  /// PENDENTE | ENVIANDO | CONCLUIDA | CANCELADA
  status             String    @default("PENDENTE")
  dueAt              DateTime
  claimedAt          DateTime?
  source             String    @default("local")
  note               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, dueAt])
  @@index([initiatorChannelId])
  @@index([peerChannelId])
}

/// Estado de autenticação do Baileys (modo QR), cifrado com a MASTER_KEY. Nada de sessão em disco local.
/// type = "creds" (keyId vazio) ou o tipo de chave do Signal (pre-key, session, sender-key, app-state-sync-key...).
model WaAuthState {
  id        String   @id @default(cuid())
  channelId String
  type      String
  keyId     String
  dataEnc   String
  updatedAt DateTime @updatedAt

  @@unique([channelId, type, keyId])
  @@index([channelId])
}

/// Agenda do celular conectado (modo QR): quais números/LIDs estão salvos como contato no aparelho.
/// Vem da sincronização do WhatsApp (app-state "contactAction"). Só o fato de estar salvo — o nome não é guardado.
/// jidKey = dígitos do número (5511999990000) ou "lid:<id>" para contatos identificados por LID.
model WaPhoneContact {
  id        String   @id @default(cuid())
  channelId String
  jidKey    String
  saved     Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([channelId, jidKey])
  @@index([channelId])
}

/// Mensagens enviadas pelo modo QR (conteúdo completo, cifrado), para reenvio fiel quando o celular
/// do cliente pede de novo ("Aguardando mensagem"). Guardadas por 14 dias.
model WaSentMessage {
  id          String   @id @default(cuid())
  channelId   String
  waMessageId String
  dataEnc     String
  createdAt   DateTime @default(now())

  @@unique([channelId, waMessageId])
  @@index([createdAt])
}

model KanbanStage {
  id       String @id @default(cuid())
  orgId    String
  name     String
  position Int
  color    String @default("#64748b")

  @@index([orgId])
}

model Contact {
  id            String    @id @default(cuid())
  orgId         String
  waId          String
  phone         String
  name          String?
  email         String?
  tags          String    @default("[]")
  notes         String?
  vars          String    @default("{}")
  stageId       String?
  optOut        Boolean   @default(false)
  savedInPhone  Boolean   @default(false) // salvo na agenda do celular de algum número QR conectado (informativo)
  lastMessageAt DateTime?
  /// v1.41.0: última mensagem automática de "fora do horário" enviada a este contato (máx. 1 a cada X horas).
  awayMessageAt DateTime?
  /// v1.44.0: origem do lead (1º contato): código do link de origem ("instagram-bio") ou "anuncio" (Click-to-WhatsApp).
  origem        String?
  origemEm      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([orgId, waId])
  @@index([orgId, stageId])
}

// Nota para a IA: observação interna do vendedor sobre o CONTATO (vale em todas as conversas/canais dele na organização).
// Nunca é enviada ao cliente; entra no prompt da IA como dado (não como instrução).
model ContactAiNote {
  id           String   @id @default(cuid())
  orgId        String
  contactId    String
  authorUserId String?
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId, contactId, createdAt])
}

model Conversation {
  id                 String    @id @default(cuid())
  orgId              String
  contactId          String
  channelId          String?
  status             String    @default("OPEN") // OPEN | PENDING | CLOSED
  mode               String    @default("BOT") // BOT | HUMAN
  assignedUserId     String?
  unreadCount        Int       @default(0)
  lastInboundAt      DateTime?
  lastMessageAt      DateTime?
  firstResponseAt    DateTime?
  closedAt           DateTime?
  // "Aguardando atendente": quando a IA/fluxo transferiu para humano (limpo quando o atendente responde).
  waitingSince       DateTime?
  handoffAlertSentAt DateTime?
  /// Aviso imediato da transferência (números de atendimento): quando saiu e quantas tentativas.
  handoffNotifyAt    DateTime?
  handoffNotifyTries Int       @default(0)
  /// Tentativas do lembrete "aguardando há N min" (repete até 3 vezes se o envio falhar).
  handoffAlertTries  Int       @default(0)
  /// Classificação da IA: do que trata a conversa — REUNIAO | PEDIDO | AMBOS (nulo = ainda não classificada).
  aiIntent           String?
  /// Voz: preferência do cliente nesta conversa — 'audio' | 'texto' (nulo = segue o modo da empresa). Migração 0053.
  voicePreference    String?
  /// v1.41.0: quando a conversa foi distribuída automaticamente para o atendente (rodízio / menos ocupado).
  assignedAt         DateTime?
  /// v1.44.0: origem desta conversa (link de origem, anúncio Click-to-WhatsApp ou "site") e detalhe (JSON do anúncio).
  origem             String?
  origemDetalhe      String?
  createdAt          DateTime  @default(now())

  @@index([orgId, status])
  @@index([contactId])
  @@index([orgId, waitingSince])
}

model Message {
  id             String   @id @default(cuid())
  orgId          String
  conversationId String
  channelId      String?
  direction      String // IN | OUT
  sender         String // contact | bot | ai | agent | system
  type           String   @default("text")
  body           String?
  mediaUrl       String?
  waMessageId    String?
  status         String // RECEIVED | QUEUED | SENT | DELIVERED | READ | FAILED
  error          String?
  attempts       Int      @default(0)
  authorUserId   String?
  /// v1.23.0: transcrição do áudio recebido (ou texto falado na nota de voz enviada pela IA).
  transcript     String?
  /// v1.42.0: envio em massa (campanha, cadência do SDR, automação, nova tentativa): conta nos limites de proteção do número.
  bulk           Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([channelId, waMessageId])
  @@index([orgId, createdAt])
  @@index([conversationId, createdAt])
  @@index([channelId, createdAt])
}

model Flow {
  id             String        @id @default(cuid())
  orgId          String
  name           String
  description    String?
  status         String        @default("DRAFT") // DRAFT | ACTIVE | PAUSED
  priority       Int           @default(0)
  currentVersion Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  versions       FlowVersion[]

  @@index([orgId, status])
}

model FlowVersion {
  id          String   @id @default(cuid())
  flowId      String
  version     Int
  graph       String
  createdById String?
  createdAt   DateTime @default(now())
  flow        Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, version])
}

model FlowRun {
  id               String    @id @default(cuid())
  orgId            String
  flowId           String
  flowVersion      Int
  conversationId   String
  contactId        String
  status           String // RUNNING | WAITING | COMPLETED | FAILED | HANDOFF | CANCELLED
  currentNodeId    String?
  waitType         String? // reply | timer
  resumeAt         DateTime?
  vars             String    @default("{}")
  stepCount        Int       @default(0)
  error            String?
  triggerMessageId String?   @unique
  startedAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  finishedAt       DateTime?

  @@index([orgId, status])
  @@index([conversationId, status])
}

model FlowRunStep {
  id        String   @id @default(cuid())
  orgId     String
  runId     String
  flowId    String
  nodeId    String
  nodeType  String
  status    String // ok | warn | error
  detail    String?
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([flowId, nodeId])
}

model AiSettings {
  orgId                String   @id
  enabled              Boolean  @default(false)
  autoReply            Boolean  @default(false)
  provider             String   @default("gemini") // openai | gemini | fake (somente testes)
  model                String   @default("gemini-3.5-flash-lite")
  baseUrl              String?
  apiKeyEnc            String?
  instructions         String   @default("")
  tone                 String   @default("cordial e objetivo")
  temperature          Float    @default(0.3)
  maxTokens            Int      @default(400)
  /// v1.27.1: false = IA sem limite de uso (ignora dailyLimit e monthlyTokenLimit).
  usageLimitEnabled    Boolean  @default(true)
  dailyLimit           Int      @default(200)
  monthlyTokenLimit    Int      @default(500000)
  handoffKeywords      String   @default("[\"atendente\",\"humano\",\"pessoa\"]")
  fallbackMessage      String   @default("Vou transferir você para um atendente humano. Aguarde um momento, por favor.")
  /// Texto enviado quando a IA falha (sem transferir). Vazio = texto padrão.
  failureMessage       String   @default("")
  /// Diferenciais da empresa frente aos concorrentes (a IA usa ao comparar). Qualquer organização.
  competitorNotes      String   @default("")
  /// Usa as páginas do site da MCK DESENVOLVIMENTO e os preços atuais como conhecimento (só o superadmin liga).
  useMckSite           Boolean  @default(false)
  /// Pesquisa no Google (Gemini grounding) quando o cliente compara com concorrentes; só em modelos com cota grátis.
  webSearch            Boolean  @default(false)
  /// A IA pode mover o contato entre as etapas do Kanban pela análise da conversa (padrão desligado).
  kanbanAuto           Boolean  @default(false)
  /// v1.23.0 Voz: responder com nota de voz (padrão desligado).
  voiceEnabled         Boolean  @default(false)
  /// espelhar (áudio responde áudio, texto responde texto) | sempre_audio | nunca_audio
  voiceReplyMode       String   @default("espelhar")
  /// Motor da voz: gemini (padrão, grátis, chave do Gemini da IA) | openai (chave da OpenAI da IA) | elevenlabs (chave própria).
  voiceProvider        String   @default("gemini")
  /// Voz do motor escolhido: nome do Gemini (Kore, Puck...), da OpenAI (coral, ash...) ou voice_id da ElevenLabs.
  voiceName            String   @default("Kore")
  /// Modelo de voz (ElevenLabs: eleven_multilingual_v2 | eleven_flash_v2_5). Vazio = padrão do motor.
  voiceModel           String   @default("")
  /// Chave da ElevenLabs (cifrada, nunca volta para o navegador).
  voiceApiKeyEnc       String?
  /// Jeito de falar (instrução de estilo para a voz).
  voiceStyle           String   @default("Fale de forma natural, calorosa e simpática, em ritmo de conversa, como um atendente brasileiro.")
  /// Duração máxima do áudio (s); resposta mais longa vai por escrito.
  voiceMaxSeconds      Int      @default(45)
  /// Ouvir (transcrever) os áudios dos clientes quando a IA está ativada (padrão ligado).
  transcribeAudio      Boolean  @default(true)
  /// v1.47.0: biblioteca de áudios gravados pelo vendedor (a IA escolhe o certo pelo contexto e manda como áudio gravado).
  voiceLibraryEnabled  Boolean  @default(false)
  /// v1.47.0: voz clonada ativa (VoiceProfile.id) usada quando voiceProvider = "clone".
  voiceCloneProfileId  String?
  /// Motor da transcrição: auto (o mesmo da IA de texto) | gemini | openai | elevenlabs.
  transcribeProvider   String   @default("auto")
  /// v1.42.0: duração máxima do áudio do cliente para transcrever (s). Padrão 2 minutos.
  transcribeMaxSeconds Int      @default(120)
  /// v1.46.0: quando o assistente "Monte sua IA conversando" foi aplicado pela última vez (nulo = nunca).
  assistenteAplicadoEm DateTime?
  /// v1.24.0 De onde a IA consulta os produtos: catalogo (padrão, só Produtos) | erp (só ERP com saldo) | ambos.
  productSource        String   @default("catalogo")
  /// ERP: false = só a situação (disponível / poucas unidades / sem estoque / sob encomenda); true = quantidade exata.
  erpShowQuantity      Boolean  @default(false)
  /// ERP: restringe o saldo a um depósito (ErpDeposito da mesma organização). Nulo = todos.
  erpDepositoId        String?
  /// v1.35.0: troca preço/percentual/prazo que não está nas Instruções/base por "confirmo com a equipe" (padrão desligado).
  guardValues          Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  orgId     String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model KnowledgeChunk {
  id    String @id @default(cuid())
  orgId String
  docId String
  idx   Int
  text  String

  @@index([orgId])
  @@index([docId])
}

model AiUsage {
  id               String   @id @default(cuid())
  orgId            String
  conversationId   String?
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  success          Boolean
  handoff          Boolean  @default(false)
  error            String?
  latencyMs        Int      @default(0)
  /// v1.35.0: finalidade da chamada (atendimento, sdr-extracao, sdr-followup, campanha, erp-aprovacao, autoresposta, voz...). Nulo = antigo.
  purpose          String?
  /// v1.35.0: versão do prompt usado (server/ai/prompts.ts).
  promptVersion    String?
  /// v1.35.0: sinal de qualidade da resposta (ex.: "valor_fora_base"). Nulo = nada a observar.
  quality          String?
  createdAt        DateTime @default(now())

  @@index([orgId, createdAt])
}

/// v1.35.0: "IA respondeu mal" — correção da equipe que vira item da base de conhecimento.
model AiFeedback {
