// MCKBOT — schema principal (PostgreSQL em produção).
// Para dev/testes, scripts/sqlite-schema.mjs gera prisma/sqlite/schema.prisma trocando o provider.
// Campos JSON são armazenados como texto (String) para manter compatibilidade entre PostgreSQL e SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String
  phone            String?
  passwordHash     String
  isSuperAdmin     Boolean       @default(false)
  disabledAt       DateTime?
  emailVerifiedAt  DateTime?
  /// CPF (11) ou CNPJ (14) do titular, só dígitos. Dado pessoal: nunca em log/auditoria; mascarado na interface.
  documento        String?       @unique
  /// Celular do titular em E.164 (+5511912345678); também serve de identificador no login.
  celular          String?       @unique
  /// Verificação em duas etapas (TOTP): segredo cifrado (AES-GCM com MASTER_KEY); pendente = em configuração.
  totpSecretEnc    String?
  totpPendingEnc   String?
  totpEnabledAt    DateTime?
  totpLastStep     Int?
  /// Hashes SHA-256 dos códigos de recuperação ainda não usados (JSON).
  recoveryCodes    String        @default("[]")
  /// Bloqueio temporário após senhas/códigos errados seguidos.
  failedLogins     Int           @default(0)
  lockedUntil      DateTime?
  /// Lembrete por e-mail 3 dias e 1 dia antes de vencer o teste/plano (titular pode desligar no Perfil).
  renewalReminders Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  memberships      Membership[]
  sessions         Session[]
  authTokens       AuthToken[]
  knownDevices     KnownDevice[]
  /// Receber por e-mail o alerta de WhatsApp desconectado (Proprietário/Administrador). Padrão: sim.
  waDownEmail      Boolean       @default(true)
}

/// Aparelhos (navegadores) já usados para entrar; login de aparelho novo gera alerta por e-mail.
model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceHash  String // sha256 do cookie mck_did
  userAgent   String?
  ip          String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
}

/// Execuções do backup diário do banco.
model BackupRun {
  id          String    @id @default(cuid())
  trigger     String    @default("AUTO") // AUTO | MANUAL
  status      String    @default("RUNNING") // RUNNING | OK | FAILED
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  sizeBytes   Int?
  rows        Int?
  destination String?
  location    String?
  error       String?

  @@index([startedAt])
}

/// Tokens de uso único enviados por e-mail (redefinição de senha e verificação de e-mail). Só o hash fica salvo.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  kind      String // RESET_PASSWORD | VERIFY_EMAIL
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// Cadastro aguardando o código enviado por e-mail. Nada é criado em User/Organization antes da confirmação.
model PendingSignup {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  email        String
  name         String
  passwordHash String
  orgName      String
  documento    String
  celular      String
  app          String   @default("mckbot")
  codeHash     String
  attempts     Int      @default(0)
  sends        Int      @default(1)
  /// E-mail já tem conta: nenhum código é enviado (o e-mail avisa "você já tem conta"); a resposta é igual para não vazar.
  existingUser Boolean  @default(false)
  expiresAt    DateTime
  lastSentAt   DateTime @default(now())
  ip           String?
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Organization {
  id                  String       @id @default(cuid())
  name                String
  timezone            String       @default("America/Sao_Paulo")
  plan                String       @default("gratis")
  // Aviso "Aguardando atendente": número de WhatsApp reserva (E.164 BR) e minutos de espera até o aviso.
  backupPhone         String?
  handoffAlertMinutes Int          @default(5)
  /// Números que recebem o aviso no momento da transferência para humano (JSON: ["+55..."]). Nulo = usa backupPhone.
  handoffNotifyPhones String?
  /// Resultado do último aviso de atendimento (JSON: { at, ok, detail }), mostrado no Perfil.
  handoffNotifyStatus String?
  /// O que os números de aviso recebem no WhatsApp (Perfil › Organização): transferência, reunião, tarefa, pedido, falha da IA.
  alertHandoff        Boolean      @default(true)
  alertMeeting        Boolean      @default(true)
  alertTask           Boolean      @default(true)
  alertOrder          Boolean      @default(true)
  /// Falha da IA (não conseguiu responder um cliente): WhatsApp + e-mail ao Proprietário/Admin, máx. 1 por conversa a cada 30 min.
  alertAiFailure      Boolean      @default(true)
  createdAt           DateTime     @default(now())
  memberships         Membership[]
}

model Membership {
  id         String       @id @default(cuid())
  userId     String
  orgId      String
  role       String // OWNER | ADMIN | AGENT
  /// Módulos que o membro pode acessar (JSON: ["inbox","kanban",...]). Nulo = tudo o que o papel permite (comportamento antigo).
  modules    String?
  /// Canais WhatsApp que o membro pode atender (JSON: [channelId,...]). Nulo = todos os canais.
  channelIds String?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        String
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  /// Permissões que o membro recebe ao aceitar (mesmo formato de Membership.modules/channelIds; nulo = padrão do papel/todos).
  modules     String?
  channelIds  String?
  /// Envio do e-mail do convite: último envio e quantidade (limite de reenvio).
  lastSentAt  DateTime?
  sendCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([orgId])
}

model Session {
  id         String    @id // sha256 do token do cookie
  userId     String
  orgId      String?
  csrfToken  String
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      String   @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

model Channel {
  id                  String    @id @default(cuid())
  orgId               String
  name                String
  provider            String    @default("whatsapp_cloud") // whatsapp_cloud (API oficial) | whatsapp_qr (WhatsApp Web via QR code)
  phoneNumberId       String?
  wabaId              String?
  displayPhone        String?
  accessTokenEnc      String?
  appSecretEnc        String?
  verifyToken         String
  status              String    @default("NOT_CONNECTED") // NOT_CONNECTED | CONNECTING | QR_PENDING | CONNECTED | ERROR
  waJid               String? // modo QR: JID do aparelho conectado
  connectedAt         DateTime? // modo QR: quando a sessão foi aberta pela última vez
  lastError           String?
  lastWebhookAt       DateTime?
  lastCheckedAt       DateTime?
  qrLeaseOwner        String? // modo QR: instância do servidor que segura a sessão (evita 2 conexões no deploy)
  qrLeaseUntil        DateTime? // modo QR: validade da trava; expira sozinha se a instância cair
  replySavedContacts  Boolean   @default(false) // modo QR: responder automaticamente contatos salvos na agenda do celular (padrão: não)
  addressBookSyncedAt DateTime? // modo QR: quando a agenda do celular foi sincronizada por completo pela última vez
  autoReplyMode       String    @default("both") // quem responde automaticamente neste canal: flows (só fluxos) | ai (só IA) | both (fluxos + IA, padrão)
  /// Alerta de WhatsApp desconectado: última vez que o monitor viu o canal conectado (canal "armado"; vazio = nunca conectou ou foi desconectado de propósito).
  waUpSeenAt          DateTime?
  /// Início do episódio de desconexão observado pelo monitor (vazio = conectado).
  waDownSince         DateTime?
  /// Alerta (e-mail + aviso no app) enviado neste episódio; lembrete único após 24 h.
  waDownAlertAt       DateTime?
  waDownReminderAt    DateTime?
  /// Voltou a conectar depois de um alerta (aviso "voltou a conectar" no app por 24 h).
  waBackAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([orgId])
}

/// Estado de autenticação do Baileys (modo QR), cifrado com a MASTER_KEY. Nada de sessão em disco local.
/// type = "creds" (keyId vazio) ou o tipo de chave do Signal (pre-key, session, sender-key, app-state-sync-key...).
model WaAuthState {
  id        String   @id @default(cuid())
  channelId String
  type      String
  keyId     String
  dataEnc   String
  updatedAt DateTime @updatedAt

  @@unique([channelId, type, keyId])
  @@index([channelId])
}

/// Agenda do celular conectado (modo QR): quais números/LIDs estão salvos como contato no aparelho.
/// Vem da sincronização do WhatsApp (app-state "contactAction"). Só o fato de estar salvo — o nome não é guardado.
/// jidKey = dígitos do número (5511999990000) ou "lid:<id>" para contatos identificados por LID.
model WaPhoneContact {
  id        String   @id @default(cuid())
  channelId String
  jidKey    String
  saved     Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([channelId, jidKey])
  @@index([channelId])
}

/// Mensagens enviadas pelo modo QR (conteúdo completo, cifrado), para reenvio fiel quando o celular
/// do cliente pede de novo ("Aguardando mensagem"). Guardadas por 14 dias.
model WaSentMessage {
  id          String   @id @default(cuid())
  channelId   String
  waMessageId String
  dataEnc     String
  createdAt   DateTime @default(now())

  @@unique([channelId, waMessageId])
  @@index([createdAt])
}

model KanbanStage {
  id       String @id @default(cuid())
  orgId    String
  name     String
  position Int
  color    String @default("#64748b")

  @@index([orgId])
}

model Contact {
  id            String    @id @default(cuid())
  orgId         String
  waId          String
  phone         String
  name          String?
  email         String?
  tags          String    @default("[]")
  notes         String?
  vars          String    @default("{}")
  stageId       String?
  optOut        Boolean   @default(false)
  savedInPhone  Boolean   @default(false) // salvo na agenda do celular de algum número QR conectado (informativo)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([orgId, waId])
  @@index([orgId, stageId])
}

// Nota para a IA: observação interna do vendedor sobre o CONTATO (vale em todas as conversas/canais dele na organização).
// Nunca é enviada ao cliente; entra no prompt da IA como dado (não como instrução).
model ContactAiNote {
  id           String   @id @default(cuid())
  orgId        String
  contactId    String
  authorUserId String?
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId, contactId, createdAt])
}

model Conversation {
  id                 String    @id @default(cuid())
  orgId              String
  contactId          String
  channelId          String?
  status             String    @default("OPEN") // OPEN | PENDING | CLOSED
  mode               String    @default("BOT") // BOT | HUMAN
  assignedUserId     String?
  unreadCount        Int       @default(0)
  lastInboundAt      DateTime?
  lastMessageAt      DateTime?
  firstResponseAt    DateTime?
  closedAt           DateTime?
  // "Aguardando atendente": quando a IA/fluxo transferiu para humano (limpo quando o atendente responde).
  waitingSince       DateTime?
  handoffAlertSentAt DateTime?
  /// Aviso imediato da transferência (números de atendimento): quando saiu e quantas tentativas.
  handoffNotifyAt    DateTime?
  handoffNotifyTries Int       @default(0)
  /// Tentativas do lembrete "aguardando há N min" (repete até 3 vezes se o envio falhar).
  handoffAlertTries  Int       @default(0)
  /// Classificação da IA: do que trata a conversa — REUNIAO | PEDIDO | AMBOS (nulo = ainda não classificada).
  aiIntent           String?
  createdAt          DateTime  @default(now())

  @@index([orgId, status])
  @@index([contactId])
  @@index([orgId, waitingSince])
}

model Message {
  id             String   @id @default(cuid())
  orgId          String
  conversationId String
  channelId      String?
  direction      String // IN | OUT
  sender         String // contact | bot | ai | agent | system
  type           String   @default("text")
  body           String?
  mediaUrl       String?
  waMessageId    String?
  status         String // RECEIVED | QUEUED | SENT | DELIVERED | READ | FAILED
  error          String?
  attempts       Int      @default(0)
  authorUserId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([channelId, waMessageId])
  @@index([orgId, createdAt])
  @@index([conversationId, createdAt])
}

model Flow {
  id             String        @id @default(cuid())
  orgId          String
  name           String
  description    String?
  status         String        @default("DRAFT") // DRAFT | ACTIVE | PAUSED
  priority       Int           @default(0)
  currentVersion Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  versions       FlowVersion[]

  @@index([orgId, status])
}

model FlowVersion {
  id          String   @id @default(cuid())
  flowId      String
  version     Int
  graph       String
  createdById String?
  createdAt   DateTime @default(now())
  flow        Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, version])
}

model FlowRun {
  id               String    @id @default(cuid())
  orgId            String
  flowId           String
  flowVersion      Int
  conversationId   String
  contactId        String
  status           String // RUNNING | WAITING | COMPLETED | FAILED | HANDOFF | CANCELLED
  currentNodeId    String?
  waitType         String? // reply | timer
  resumeAt         DateTime?
  vars             String    @default("{}")
  stepCount        Int       @default(0)
  error            String?
  triggerMessageId String?   @unique
  startedAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  finishedAt       DateTime?

  @@index([orgId, status])
  @@index([conversationId, status])
}

model FlowRunStep {
  id        String   @id @default(cuid())
  orgId     String
  runId     String
  flowId    String
  nodeId    String
  nodeType  String
  status    String // ok | warn | error
  detail    String?
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([flowId, nodeId])
}

model AiSettings {
  orgId             String   @id
  enabled           Boolean  @default(false)
  autoReply         Boolean  @default(false)
  provider          String   @default("gemini") // openai | gemini | fake (somente testes)
  model             String   @default("gemini-3.5-flash-lite")
  baseUrl           String?
  apiKeyEnc         String?
  instructions      String   @default("")
  tone              String   @default("cordial e objetivo")
  temperature       Float    @default(0.3)
  maxTokens         Int      @default(400)
  dailyLimit        Int      @default(200)
  monthlyTokenLimit Int      @default(500000)
  handoffKeywords   String   @default("[\"atendente\",\"humano\",\"pessoa\"]")
  fallbackMessage   String   @default("Vou transferir você para um atendente humano. Aguarde um momento, por favor.")
  /// Texto enviado quando a IA falha (sem transferir). Vazio = texto padrão.
  failureMessage    String   @default("")
  /// Diferenciais da empresa frente aos concorrentes (a IA usa ao comparar). Qualquer organização.
  competitorNotes   String   @default("")
  /// Usa as páginas do site da MCK DESENVOLVIMENTO e os preços atuais como conhecimento (só o superadmin liga).
  useMckSite        Boolean  @default(false)
  /// Pesquisa no Google (Gemini grounding) quando o cliente compara com concorrentes; só em modelos com cota grátis.
  webSearch         Boolean  @default(false)
  /// A IA pode mover o contato entre as etapas do Kanban pela análise da conversa (padrão desligado).
  kanbanAuto        Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  orgId     String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model KnowledgeChunk {
  id    String @id @default(cuid())
  orgId String
  docId String
  idx   Int
  text  String

  @@index([orgId])
  @@index([docId])
}

model AiUsage {
  id               String   @id @default(cuid())
  orgId            String
  conversationId   String?
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  success          Boolean
  handoff          Boolean  @default(false)
  error            String?
  latencyMs        Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([orgId, createdAt])
}

model Integration {
  id             String    @id @default(cuid())
  orgId          String
  name           String
  slug           String
  baseUrl        String
  authHeaderName String?
  authValueEnc   String?
  lastTestAt     DateTime?
  lastTestStatus String?
  createdAt      DateTime  @default(now())

  @@unique([orgId, slug])
}

// ---------- MCKMENSAGEM: disparo para leads com consentimento ----------

model Lead {
  id              String    @id @default(cuid())
  orgId           String
  phone           String // E.164, ex.: +5511999998888
  name            String?
  tags            String    @default("[]")
  status          String    @default("NOVO") // NOVO | CONTATADO | RESPONDEU | CONVERTIDO | DESCARTADO
  consentSource   String // FORMULARIO | IMPORTACAO | ANUNCIO_CTWA | MANUAL | MCKBOT (veio do MCKBOT, consentimento pendente)
  consentAt       DateTime? // null = consentimento ainda não registrado (contato vindo do MCKBOT): não recebe campanhas
  optOutAt        DateTime?
  campaignId      String?
  contactId       String? // contato do MCKBOT (mesma pessoa): nome, telefone e opt-out ficam sincronizados
  // IA de qualificação (MCK Mensagens)
  qualifyAttempts Int       @default(0) // respostas negativas recebidas (cada uma gera uma nova tentativa)
  nextAttemptAt   DateTime? // quando AGUARDANDO: próxima tentativa automática
  lastIntent      String? // POSITIVO | NEGATIVO | DUVIDA | SAIR
  aiSummary       String? // resumo curto da IA sobre o lead
  qualifiedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([orgId, phone])
  @@index([orgId, status])
  @@index([contactId])
  @@index([status, nextAttemptAt])
}

/**
 * IA de qualificação de leads do MCK Mensagens (usa o provedor/chave configurados em IA do MCKBOT).
 */
model LeadAiSettings {
  orgId           String   @id
  enabled         Boolean  @default(false)
  instructions    String   @default("") // o que a empresa vende, público, como abordar
  offer           String   @default("") // próximo passo oferecido a quem tem interesse (ex.: teste grátis de 1h)
  positiveAction  String   @default("HANDOFF") // HANDOFF (atendente) | FLOW (inicia um fluxo do MCKBOT) | BOT (segue no robô/IA)
  positiveFlowId  String?
  promptTemplate  String? // prompt editável pelo cliente; vazio = padrão do sistema
  positiveMessage String   @default("") // mensagem fixa extra enviada depois da resposta da IA no positivo
  negativeAction  String   @default("RETRY") // RETRY | FLOW | HANDOFF | DISCARD
  negativeFlowId  String?
  doubtAction     String   @default("AI") // AI | FLOW | HANDOFF
  doubtFlowId     String?
  tagPositive     String   @default("lead-qualificado")
  tagWaiting      String   @default("lead-aguardando")
  tagDiscarded    String   @default("lead-descartado")
  retryDays       Int      @default(3)
  maxAttempts     Int      @default(3)
  retryMessage    String   @default("Oi {nome}! Passando de novo por aqui 😊 Ainda posso te ajudar? Se quiser, libero um teste grátis pra você conhecer, sem compromisso.")
  updatedAt       DateTime @updatedAt
}

model Campaign {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  message        String
  channelId      String
  status         String   @default("RASCUNHO") // RASCUNHO | AGENDADA | EM_ANDAMENTO | PAUSADA | CONCLUIDA
  dailyLimit     Int      @default(50)
  minIntervalSec Int      @default(45)
  maxIntervalSec Int      @default(120)
  windowStart    String   @default("09:00")
  windowEnd      String   @default("20:00")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId, status])
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  leadId     String
  status     String    @default("PENDENTE") // PENDENTE | ENVIADA | FALHOU | IGNORADA
  sentAt     DateTime?
  error      String?

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
  @@index([leadId])
}

// ---------- Cobrança (Mercado Pago) ----------

model Subscription {
  id         String   @id @default(cuid())
  orgId      String
  product    String // MCKBOT | MCKMENSAGEM
  status     String   @default("TRIAL") // TRIAL | ATIVA | VENCIDA | BLOQUEADA
  cycle      String   @default("MENSAL") // MENSAL | ANUAL
  validUntil DateTime
  source     String   @default("TRIAL") // TRIAL | MANUAL | MP
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([orgId, product])
}

model BillingEvent {
  id             String    @id @default(cuid())
  orgId          String
  product        String // MCKBOT | MCKMENSAGEM | COMBO
  kind           String // TRIAL | MANUAL | MP | BLOCK | UNBLOCK
  cycle          String?
  amountCents    Int?
  mpPaymentId    String?   @unique
  actorUserId    String?
  prevValidUntil DateTime?
  newValidUntil  DateTime?
  createdAt      DateTime  @default(now())

  @@index([orgId, createdAt])
}

/// Lembrete "seu plano vence em X dias": uma linha por (organização, produto, aviso D3/D1, vencimento).
/// A chave única impede enviar o mesmo lembrete duas vezes; renovar muda o vencimento e libera novos avisos.
model RenewalReminder {
  id         String    @id @default(cuid())
  orgId      String
  product    String // MCKBOT | MCKMENSAGEM
  kind       String // D3 | D1
  validUntil DateTime
  status     String    @default("ENVIANDO") // ENVIANDO | ENVIADO | FALHOU
  channel    String    @default("EMAIL")
  attempts   Int       @default(0)
  lastError  String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([orgId, product, kind, validUntil])
  @@index([status, updatedAt])
}

model PlatformSettings {
  id                 String   @id @default("default")
  trialDays          Int      @default(7)
  pricesJson         String   @default("{\"MCKBOT\":{\"MENSAL\":3990,\"ANUAL\":39900},\"MCKMENSAGEM\":{\"MENSAL\":4500,\"ANUAL\":45000},\"COMBO\":{\"MENSAL\":6990,\"ANUAL\":69900}}")
  mpWebhookSecretEnc String?
  siteJson           String   @default("{}") // Site oficial (/empresa): contato, Facebook, tutoriais públicos, promoção em destaque
  waDigestDay        String? // último dia (AAAA-MM-DD, Brasília) do resumo diário de WhatsApp desconectado para o superadmin
  updatedAt          DateTime @updatedAt
}

// ---------- Cupons de desconto (parcerias com influenciadores/empresas) ----------
model Coupon {
  id          String             @id @default(cuid())
  code        String             @unique // MAIÚSCULO, ex.: INFLU10
  partner     String? // influenciador ou empresa parceira
  type        String // PERCENT | FIXED
  value       Int // PERCENT: 1..99 (%); FIXED: centavos
  product     String             @default("ALL") // ALL | MCKBOT | MCKMENSAGEM | COMBO
  cycles      String             @default("ALL") // ALL | MENSAL | ANUAL
  validUntil  DateTime?
  maxUses     Int?
  active      Boolean            @default(true)
  createdBy   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  redemptions CouponRedemption[]
}

// Uso do cupom: gravado só quando o pagamento é confirmado (webhook/confirm do Mercado Pago).
model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id])
  orgId         String
  product       String
  cycle         String
  mpPaymentId   String   @unique
  originalCents Int
  discountCents Int
  finalCents    Int
  status        String   @default("CONFIRMADO") // CONFIRMADO | ESTORNADO
  createdAt     DateTime @default(now())

  @@index([couponId, status])
}

/// "Voltar ao menu": comando global do cliente final do WhatsApp (por organização).
model FlowSettings {
  orgId              String   @id
  menuCommandEnabled Boolean  @default(true)
  menuCommandWords   String   @default("0,menu,voltar") // separadas por vírgula; comparação sem maiúsculas/acentos
  menuFooterEnabled  Boolean  @default(true)
  menuFooterText     String   @default("↩️ Digite 0 para voltar ao menu")
  menuButtonEnabled  Boolean  @default(true) // botão "Voltar ao menu" na Cloud API (no QR usa-se o texto)
  menuFlowId         String? // fluxo do menu; vazio = automático
  updatedAt          DateTime @updatedAt
}

// ---------- MCK MENSAGENS: Automações e Cobranças (FASE 1: clientes, lembretes, marketing) ----------

/// Cliente do módulo Automações e Cobranças. Deduplicado (no código) por telefone/WhatsApp, e-mail e CPF/CNPJ dentro da organização.
model Cliente {
  id                  String    @id @default(cuid())
  orgId               String
  nome                String
  documento           String? // CPF/CNPJ só com dígitos
  telefone            String? // E.164
  whatsapp            String? // E.164 (com código do país)
  email               String? // minúsculo
  emailSecundario     String?
  empresa             String?
  plano               String?
  dataContratacao     DateTime?
  dataVencimento      DateTime?
  valorCentavos       Int?
  parcelas            Int?
  formaPagamento      String?
  status              String    @default("ATIVO") // ATIVO | INATIVO | INADIMPLENTE | CANCELADO
  observacoes         String?
  prefWhatsapp        Boolean   @default(true)
  prefEmail           Boolean   @default(true)
  consentimentoAt     DateTime?
  consentimentoOrigem String? // FORMULARIO | IMPORTACAO | ANUNCIO_CTWA | MANUAL
  marketingOptOutAt   DateTime?
  contactId           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([orgId, nome])
  @@index([orgId, telefone])
  @@index([orgId, whatsapp])
  @@index([orgId, email])
  @@index([orgId, documento])
}

/// Automação de envio (LEMBRETE ou MARKETING) com regra de recorrência em JSON.
model Automacao {
  id          String    @id @default(cuid())
  orgId       String
  nome        String
  categoria   String // LEMBRETE | MARKETING | COBRANCA
  canais      String    @default("[\"WHATSAPP\"]") // JSON: WHATSAPP e/ou EMAIL
  channelId   String? // canal WhatsApp (vazio = o conectado da organização)
  assunto     String? // assunto do e-mail
  mensagem    String
  clienteIds  String    @default("[]") // JSON com os ids dos clientes destinatários
  regra       String // JSON: { tipo: UNICO|DIARIO|SEMANAL|MENSAL|DATAS|ANUAL|INTERVALO, ... }
  timezone    String    @default("America/Sao_Paulo")
  inicio      DateTime
  fim         DateTime?
  maxEnvios   Int?
  status      String    @default("RASCUNHO") // RASCUNHO | ATIVA | PAUSADA | CANCELADA | CONCLUIDA
  geradoAte   DateTime? // horizonte até onde as ocorrências já foram geradas
  reenvio     String? // COBRANCA: JSON { offsets: [-1,0,1,3,7], horario: "10:00", maxPorBoleto: 5, mensagem? }
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId, status])
  @@index([status, geradoAte])
}

/// Um envio programado, por cliente e por canal. "chave" garante idempotência (automação + cliente + canal + horário original).
model Ocorrencia {
  id             String    @id @default(cuid())
  orgId          String
  automacaoId    String
  clienteId      String
  canal          String // WHATSAPP | EMAIL
  chave          String    @unique
  agendadoPara   DateTime // horário programado (pode ser alterado em "só esta ocorrência")
  executarEm     DateTime // próximo momento de execução (agendadoPara ou nova tentativa)
  status         String    @default("PENDENTE") // PENDENTE | PROCESSANDO | ENVIADA | FALHOU | IGNORADA | CANCELADA
  tentativas     Int       @default(0)
  erro           String?
  provedorId     String?
  mensagem       String? // texto só desta ocorrência (edição pontual)
  editada        Boolean   @default(false)
  lockedAt       DateTime?
  enviadoEm      DateTime?
  indice         Int? // posição do envio na sequência (1 = primeiro), usada para os anexos por mensagem
  tipo           String    @default("ENVIO") // ENVIO | REENVIO (cobrança relativa ao vencimento)
  boletoId       String? // cobrança: boleto principal desta mensagem
  partesEnviadas Int       @default(0) // WhatsApp: texto + anexos já enviados (retentativa não repete partes)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([boletoId, status])
  @@index([status, executarEm])
  @@index([orgId, agendadoPara])
  @@index([automacaoId, status])
  @@index([clienteId])
}

/// Histórico de mensagens do módulo (um registro por ocorrência, atualizado a cada tentativa).
model MensagemHistorico {
  id            String    @id @default(cuid())
  orgId         String
  ocorrenciaId  String?   @unique
  automacaoId   String?
  clienteId     String?
  categoria     String
  canal         String
  direcao       String    @default("OUT")
  assunto       String?
  conteudo      String
  agendadoPara  DateTime?
  enviadoEm     DateTime?
  provedorId    String?
  status        String // ENVIADA | FALHOU | IGNORADA | CANCELADA | TENTANDO | RECEBIDA
  erro          String?
  tentativas    Int       @default(0)
  operadorId    String?
  anexos        String? // JSON: [{ arquivoId, nome, boletoId? }]
  boletoId      String?
  comprovanteId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([orgId, createdAt])
  @@index([orgId, clienteId])
  @@index([automacaoId])
}

/// Configurações do módulo por organização.
model AutomacaoConfig {
  orgId                 String   @id
  timezone              String   @default("America/Sao_Paulo")
  janelaInicio          String   @default("08:00")
  janelaFim             String   @default("20:00")
  limiteDiario          Int      @default(500)
  maxTentativas         Int      @default(3)
  backoffSeg            Int      @default(60)
  tiposArquivo          String   @default("pdf,png,jpg,webp") // extensões permitidas para anexos e comprovantes
  tamanhoMaxMb          Int      @default(10)
  reenvioPadrao         String   @default("{\"offsets\":[-1,0,1,3,7],\"horario\":\"10:00\",\"maxPorBoleto\":5}")
  notificarComprovantes Boolean  @default(true) // e-mail aos administradores quando chega comprovante
  updatedAt             DateTime @updatedAt
}

/// Modelos de mensagem reutilizáveis, por categoria (LEMBRETE | MARKETING).
model ModeloMensagem {
  id        String   @id @default(cuid())
  orgId     String
  categoria String
  nome      String
  assunto   String?
  corpo     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, categoria])
}

// ---------------- Automações e Cobranças — FASE 2 (boletos, arquivos, comprovantes, pagamentos) ----------------

/// Metadados de um arquivo (boleto, fatura, documento, comprovante). O conteúdo fica em ArquivoConteudo (Postgres bytea).
model Arquivo {
  id          String   @id @default(cuid())
  orgId       String
  clienteId   String? // vazio = documento genérico (pode ir para qualquer cliente)
  nome        String
  mime        String
  tamanho     Int
  sha256      String
  origem      String   @default("UPLOAD") // UPLOAD | WHATSAPP | EMAIL
  descricao   String?
  criadoPorId String?
  createdAt   DateTime @default(now())

  @@index([orgId, clienteId])
  @@index([orgId, sha256])
}

model ArquivoConteudo {
  arquivoId String @id
  dados     Bytes
}

/// Boleto/fatura/parcela de um cliente. status = financeiro; statusEnvio = mensagem (não se confundem).
model Boleto {
  id                      String    @id @default(cuid())
  orgId                   String
  clienteId               String
  descricao               String
  numeroDocumento         String?
  parcela                 Int?
  totalParcelas           Int?
  valorCentavos           Int
  valorAtualizadoCentavos Int?
  jurosCentavos           Int       @default(0)
  multaCentavos           Int       @default(0)
  descontoCentavos        Int       @default(0)
  valorPagoCentavos       Int       @default(0) // soma dos pagamentos não estornados
  emissao                 DateTime?
  vencimento              DateTime // meio-dia UTC da data de vencimento
  codigoBarras            String?
  linhaDigitavel          String?
  linkPagamento           String?
  arquivoId               String?
  status                  String    @default("PENDENTE") // RASCUNHO | PENDENTE | VENCIDO | EM_ANALISE | PARCIAL | PAGO | CANCELADO
  statusEnvio             String    @default("NAO_ENVIADO") // NAO_ENVIADO | ENVIADO | FALHOU
  enviadoEm               DateTime?
  envios                  Int       @default(0)
  pagoEm                  DateTime?
  origemBaixa             String? // MANUAL | COMPROVANTE
  observacoes             String?
  criadoPorId             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([orgId, status])
  @@index([orgId, clienteId])
  @@index([orgId, vencimento])
}

/// Histórico de alterações de um boleto (só inserção: nada é apagado).
model BoletoEvento {
  id         String   @id @default(cuid())
  orgId      String
  boletoId   String
  tipo       String // CRIADO | EDITADO | ENVIADO | VENCIDO | COMPROVANTE | PAGAMENTO | ESTORNO | CANCELADO | REABERTO | ANEXO
  descricao  String
  dados      String? // JSON
  operadorId String?
  createdAt  DateTime @default(now())

  @@index([boletoId, createdAt])
}

/// Pagamento (baixa) de um boleto. Estorno não apaga: marca estornadoEm.
model Pagamento {
  id             String    @id @default(cuid())
  orgId          String
  boletoId       String
  clienteId      String
  valorCentavos  Int
  pagoEm         DateTime
  forma          String?
  origem         String    @default("MANUAL") // MANUAL | COMPROVANTE
  comprovanteId  String?
  observacoes    String?
  operadorId     String?
  estornadoEm    DateTime?
  estornoMotivo  String?
  estornadoPorId String?
  createdAt      DateTime  @default(now())

  @@index([orgId, pagoEm])
  @@index([boletoId])
}

/// Comprovante recebido (WhatsApp/e-mail) ou enviado pelo operador. Receber ≠ pagar: só a revisão gera baixa.
model Comprovante {
  id                     String    @id @default(cuid())
  orgId                  String
  clienteId              String?
  boletoId               String?
  arquivoId              String?
  origem                 String    @default("UPLOAD") // UPLOAD | WHATSAPP | EMAIL
  origemId               String? // id da mensagem no provedor (idempotência)
  texto                  String? // legenda/mensagem recebida
  sha256                 String?
  valorDetectadoCentavos Int?
  dataDetectada          String?
  transacaoId            String?
  instituicao            String?
  confianca              Int       @default(0) // 0–100
  analise                String? // JSON: motivos da identificação
  duplicadoDeId          String?
  status                 String    @default("EM_ANALISE") // EM_ANALISE | APROVADO | REJEITADO
  revisadoPorId          String?
  revisadoEm             DateTime?
  motivoRevisao          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([orgId, origemId])
  @@index([orgId, status])
  @@index([orgId, clienteId])
  @@index([orgId, sha256])
}

/// Anexo de uma automação. envio = N → vai só na N-ésima mensagem da sequência; vazio → em todas. ordem = ordem dentro da mensagem.
model AutomacaoAnexo {
  id          String  @id @default(cuid())
  orgId       String
  automacaoId String
  envio       Int?
  ordem       Int     @default(0)
  arquivoId   String?
  boletoId    String? // COBRANCA: envia o arquivo do boleto e usa os dados da parcela nas variáveis

  @@index([automacaoId])
  @@index([boletoId])
}

// ===================== Agenda (reuniões e tarefas na agenda do celular) =====================

/// Reunião ou tarefa com data/hora. Vai para a agenda do celular via .ics, link "Adicionar à agenda",
/// feed assinável (webcal) e, se conectado, Google Agenda (OAuth).
model Appointment {
  id              String    @id @default(cuid())
  orgId           String
  kind            String    @default("MEETING") // MEETING | TASK
  title           String
  description     String?
  location        String?
  startAt         DateTime
  durationMin     Int       @default(30)
  reminderMin     Int       @default(60) // lembrete antes do início (0 = sem lembrete)
  status          String    @default("SCHEDULED") // SCHEDULED | DONE | CANCELLED
  source          String    @default("MANUAL") // MANUAL | AI | KANBAN
  contactId       String?
  conversationId  String?
  /// WhatsApp (canal) pelo qual o compromisso foi marcado/conversado — aparece nos avisos internos ("📲 Via: WhatsApp 2 · Amanda").
  channelId       String?
  assignedUserId  String?
  createdById     String?
  notifyContact   Boolean   @default(true)
  /// Versão do evento (SEQUENCE do iCalendar): sobe a cada alteração para o celular atualizar.
  sequence        Int       @default(0)
  googleEventId   String?
  googleAccountId String?
  /// Link do Google Meet gerado pelo Google Agenda (conferenceData) — nulo sem Google conectado.
  meetLink        String?
  /// Contatos adicionais (equipe) que recebem o aviso/link por WhatsApp: JSON [{ "name": string|null, "phone": "5511…" }] (máx. 5).
  extraContacts   String    @default("[]")
  /// Destinatários dos avisos: cliente = notifyContact; responsável (atendente) e contatos adicionais.
  notifyAssignee  Boolean   @default(false)
  notifyExtras    Boolean   @default(true)
  /// Dono(s) da empresa avisados por WhatsApp; equipe pré-configurada escolhida para este compromisso (JSON [{ name, phone }]).
  notifyOwner     Boolean   @default(false)
  teamContacts    String    @default("[]")
  reminderSentAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId, startAt])
  @@index([orgId, assignedUserId])
  @@index([status, startAt])
}

/// Feed de calendário assinável (URL secreta). userId nulo = agenda da empresa inteira.
model CalendarFeed {
  id         String    @id @default(cuid())
  orgId      String
  userId     String?
  tokenHash  String    @unique
  tokenEnc   String // token cifrado (para mostrar o link de novo ao dono)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([orgId, userId])
}

/// Conta Google Agenda conectada por usuário/empresa (OAuth). Só o refresh token cifrado fica salvo.
model GoogleCalendarAccount {
  id              String   @id @default(cuid())
  orgId           String
  userId          String
  email           String?
  refreshTokenEnc String
  calendarId      String   @default("primary")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, userId])
}

/// Configuração da Agenda por empresa (horário de atendimento e agendamento pela IA).
model AgendaSettings {
  id                 String   @id @default(cuid())
  orgId              String   @unique
  aiBooking          Boolean  @default(false)
  workStart          String   @default("09:00")
  workEnd            String   @default("18:00")
  workDays           String   @default("1,2,3,4,5") // 0=domingo … 6=sábado
  defaultDurationMin Int      @default(30)
  minNoticeMin       Int      @default(60)
  notifyContact      Boolean  @default(true)
  /// Padrões da empresa para os destinatários dos avisos de novos compromissos.
  notifyAssignee     Boolean  @default(false)
  notifyExtras       Boolean  @default(true)
  /// Avisar por WhatsApp o(s) dono(s) da empresa (User.phone) a cada nova reunião.
  notifyOwner        Boolean  @default(true)
  /// Equipe pré-configurada (JSON, máx. 5): [{ name, phone, active }] — "active" = recebe avisos de reunião.
  teamContacts       String   @default("[]")
  reminderMin        Int      @default(60)
  /// O que a IA atende no WhatsApp: REUNIAO (padrão, igual a antes) | PEDIDO | AMBOS.
  aiHandles          String   @default("REUNIAO")
  /// Tipo de pedido: FISICO (pede dados de entrega) | ONLINE (sem entrega) | AMBOS (entrega só para item físico).
  orderType          String   @default("FISICO")
  /// "Solicitar dados de entrega" mesmo em pedidos online (opção do dono).
  orderAskDelivery   Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

/// Pedido registrado pela IA no WhatsApp (ou alterado pela equipe no painel da Agenda).
model Order {
  id             String   @id @default(cuid())
  orgId          String
  /// Código curto exibido ao cliente e no painel (ex.: P-7K2Q9X).
  code           String
  /// FISICO | ONLINE
  type           String   @default("FISICO")
  /// Itens: JSON [{ "nome": string, "quantidade": number, "obs": string|null }]. Sem preços (a IA não inventa valores).
  items          String   @default("[]")
  description    String?
  /// Dados de entrega (JSON { nome, endereco, cep, numero, complemento, telefone }) — nulo quando não coletados.
  delivery       String?
  /// Fluxo: NOVO | CONFIRMADO | EM_SEPARACAO | PRONTO_RETIRADA | EM_TRANSPORTE | SAIU_ENTREGA | ENTREGUE | FINALIZADO
  /// Exceções: CANCELADO | SUSPENSO | ATRASADO | DEVOLVIDO
  status         String   @default("NOVO")
  /// Pagamento (independente do status): AGUARDANDO | PAGO | PARCIAL | ESTORNADO | NAO_SE_APLICA
  paymentStatus  String   @default("AGUARDANDO")
  /// Contatos adicionais do pedido (JSON [{ "name": string|null, "phone": string }]) — recebem os avisos de status.
  extraContacts  String   @default("[]")
  /// Motivo do cancelamento (preenchido pela loja ao cancelar).
  cancelReason   String?
  source         String   @default("AI") // AI | MANUAL
  notes          String?
  /// Assinatura dos itens/tipo — evita registrar o mesmo pedido duas vezes.
  fingerprint    String?
  contactId      String?
  conversationId String?
  /// WhatsApp (canal) pelo qual o pedido foi feito ("📲 Via: WhatsApp 2 · Amanda").
  channelId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId, createdAt])
  @@index([orgId, status])
  @@index([orgId, contactId])
}

/// Histórico do pedido: mudanças de status, de pagamento, edições e cancelamento (quem, quando, de→para, observação).
model OrderStatusHistory {
  id        String   @id @default(cuid())
  orgId     String
  orderId   String
  /// STATUS | PAGAMENTO | EDICAO | CANCELAMENTO
  kind      String   @default("STATUS")
  fromValue String?
  toValue   String?
  note      String?
  /// Usuário que fez a mudança (nulo = IA/sistema).
  userId    String?
  /// Quantos destinatários receberam o aviso por WhatsApp (0 = não notificado).
  notified  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([orgId, orderId, createdAt])
}

// ---------- Avisos (pop-up com imagem para todos os clientes, criado no Painel Master) ----------

/// Aviso com imagem mostrado no centro da tela. A imagem fica no banco (o disco do Render Free é efêmero).
model Announcement {
  id          String   @id @default(cuid())
  title       String?
  body        String?
  linkUrl     String?
  linkLabel   String?
  /// MCKBOT | MCKMENSAGEM | AMBOS
  app         String   @default("AMBOS")
  /// TODOS | TRIAL | ATIVOS | VENCIDOS
  audience    String   @default("TODOS")
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)
  imageData   Bytes?
  /// image/png | image/jpeg | image/webp (detectado pelos bytes, nunca pela extensão)
  imageMime   String?
  imageSize   Int      @default(0)
  imageSha256 String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, startsAt, endsAt])
}

/// Visualização/fechamento de um aviso por usuário e por dia (America/Sao_Paulo): mostra no máximo 1x por dia.
model AnnouncementView {
  id             String    @id @default(cuid())
  announcementId String
  userId         String
  orgId          String?
  /// AAAA-MM-DD no fuso America/Sao_Paulo
  day            String
  viewedAt       DateTime  @default(now())
  dismissedAt    DateTime?

  @@unique([announcementId, userId, day])
  @@index([announcementId])
}

/// Novidades (Painel Master): conta de rede social conectada pelo administrador da plataforma (uma por rede).
/// provider: instagram | youtube | linkedin | tiktok. Tokens sempre cifrados (AES-256-GCM com MASTER_KEY, lib/crypto).
model SocialAccount {
  id           String    @id @default(cuid())
  provider     String    @unique
  /// Instagram: id da conta profissional (IG business); YouTube: id do canal; LinkedIn: URN/id da organização.
  accountId    String
  accountName  String?
  /// Token de acesso cifrado (Instagram: token da Página do Facebook, sem validade).
  accessToken  String
  /// Refresh token cifrado (YouTube).
  refreshToken String?
  expiresAt    DateTime?
  /// Dados extras da conexão (JSON), ex.: { "pageId", "pageName" } da Página ligada ao Instagram.
  extra        String    @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Novidades: publicação criada no Painel Master e (após aprovação explícita) publicada nas redes e no site /empresa.
model SocialPost {
  id          String    @id @default(cuid())
  title       String
  body        String
  mediaUrl    String?
  /// image | video | nulo
  mediaType   String?
  /// JSON: lista de destinos, ex.: ["site","instagram","youtube"]
  targets     String    @default("[]")
  /// draft | approved (publicando) | published | partial | failed
  status      String    @default("draft")
  /// JSON por destino: { "instagram": { "ok": true, "id": "...", "url": "...", "at": "..." }, "youtube": { "ok": false, "error": "..." } }
  results     String    @default("{}")
  createdById String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

/// Produtos (catálogo do cliente): a IA usa para responder preço, disponibilidade e detalhes.
/// Preços em centavos (R$). stock: disponivel | sob_encomenda | esgotado.
model Product {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  category    String?
  priceCents  Int?
  promoCents  Int?
  description String   @default("")
  /// Detalhes livres: cor, tamanho, ano, km, garantia...
  details     String   @default("")
  stock       String   @default("disponivel")
  quantity    Int?
  link        String?
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, active])
  @@index([orgId, name])
}

// ============================================================================
// MCK ERP — Etapa 1: Fundação + CRM. Tabelas com prefixo Erp, isoladas do MCKBOT.
// Convenções: orgId = empresa (tenant); valores em centavos (Int); JSON em String.
// Nada é excluído fisicamente em documentos: cancelamento é estado + auditoria.
// ============================================================================

/// Filial da empresa (filtro de dashboards e documentos).
model ErpFilial {
  id        String   @id @default(cuid())
  orgId     String
  nome      String
  cnpj      String?
  uf        String?
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([orgId])
}

/// Centro de custo (rateio e filtros).
model ErpCentroCusto {
  id        String   @id @default(cuid())
  orgId     String
  codigo    String
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([orgId, codigo])
}

/// Parceiro de negócio: cliente e/ou fornecedor (cadastro 360º).
model ErpParceiro {
  id                 String               @id @default(cuid())
  orgId              String
  filialId           String?
  tipoPessoa         String // PF | PJ
  documento          String // CPF/CNPJ só dígitos
  nome               String // razão social / nome
  fantasia           String?
  ehCliente          Boolean              @default(true)
  ehFornecedor       Boolean              @default(false)
  inscricaoEstadual  String?
  regimeTributario   String? // SIMPLES | MEI | NORMAL
  cnae               String?
  cnaeDescricao      String?
  situacaoCadastral  String? // ATIVA, BAIXADA... (Receita)
  situacaoConsultaEm DateTime?
  email              String?
  telefone           String? // E.164
  cep                String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  municipio          String?
  codigoMunicipio    String? // IBGE
  uf                 String?
  limiteCreditoCents Int                  @default(0)
  score              Int                  @default(500) // 0..1000, adimplência interna
  status             String               @default("ATIVO") // ATIVO | INATIVO | BLOQUEADO
  origem             String? // indicação, site, WhatsApp...
  contactId          String? // vínculo com o contato do MCKBOT (WhatsApp)
  tags               String               @default("[]")
  observacoes        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  contatos           ErpParceiroContato[]
  oportunidades      ErpOportunidade[]
  interacoes         ErpInteracao[]

  @@unique([orgId, documento])
  @@index([orgId, status])
  @@index([orgId, nome])
}

model ErpParceiroContato {
  id         String      @id @default(cuid())
  parceiroId String
  parceiro   ErpParceiro @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  nome       String
  cargo      String?
  email      String?
  telefone   String?
  principal  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([parceiroId])
}

/// Etapas do funil de vendas (Kanban), configuráveis por empresa.
model ErpEtapaFunil {
  id            String @id @default(cuid())
  orgId         String
  nome          String
  posicao       Int
  cor           String @default("#64748b")
  probabilidade Int    @default(10) // % padrão de fechamento
  tipo          String @default("ABERTA") // ABERTA | GANHA | PERDIDA

  @@index([orgId, posicao])
}

/// Oportunidade (card do funil). Gera orçamento/pedido na etapa 2.
model ErpOportunidade {
  id                  String      @id @default(cuid())
  orgId               String
  filialId            String?
  centroCustoId       String?
  parceiroId          String
  parceiro            ErpParceiro @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  titulo              String
  etapaId             String
  status              String      @default("ABERTA") // ABERTA | GANHA | PERDIDA | CANCELADA
  valorCents          Int         @default(0)
  probabilidade       Int         @default(10)
  custoAquisicaoCents Int         @default(0) // base do CAC
  origem              String?
  responsavelId       String? // userId
  previsaoFechamento  DateTime?
  motivoPerda         String?
  fechadaEm           DateTime?
  correlationId       String // rastreio ponta a ponta (lead → pedido → NF → título)
  posicao             Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([orgId, etapaId, posicao])
  @@index([orgId, status])
  @@index([parceiroId])
}

/// Linha do tempo unificada do cliente: WhatsApp, e-mail, ligação, nota, chamado, eventos do sistema.
model ErpInteracao {
  id             String      @id @default(cuid())
  orgId          String
  parceiroId     String
  parceiro       ErpParceiro @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  oportunidadeId String?
  tipo           String // WHATSAPP | EMAIL | LIGACAO | NOTA | CHAMADO | SISTEMA
  direcao        String? // ENTRADA | SAIDA
  assunto        String?
  conteudo       String      @default("")
  status         String? // ENVIADO | FALHOU | LIDO | ABERTO (chamado) | RESOLVIDO
  canalRef       String? // id externo (mensagem WhatsApp, e-mail)
  userId         String?
  createdAt      DateTime    @default(now())

  @@index([orgId, parceiroId, createdAt])
}

/// Outbox de eventos de domínio: gravado na MESMA transação da mudança.
model ErpEvento {
  id               String    @id @default(cuid())
  orgId            String
  tipo             String // ex.: crm.oportunidade.ganha
  agregado         String // ex.: oportunidade
  agregadoId       String
  correlationId    String?
  payload          String    @default("{}")
  status           String    @default("PENDENTE") // PENDENTE | PROCESSADO | FALHOU (DLQ)
  tentativas       Int       @default(0)
  proximaTentativa DateTime  @default(now())
  ultimoErro       String?
  processadoEm     DateTime?
  createdAt        DateTime  @default(now())

  @@index([status, proximaTentativa])
  @@index([orgId, agregado, agregadoId])
}

/// Idempotência: cada consumidor processa cada evento uma única vez.
model ErpEventoConsumo {
  id         String   @id @default(cuid())
  eventoId   String
  consumidor String
  createdAt  DateTime @default(now())

  @@unique([eventoId, consumidor])
}

/// Grafo de rastreabilidade entre documentos (oportunidade → pedido → OP → NF → título → baixa → lote).
model ErpTraceLink {
  id          String   @id @default(cuid())
  orgId       String
  origemTipo  String
  origemId    String
  destinoTipo String
  destinoId   String
  vinculo     String // gerou, consumiu, faturou, liquidou...
  createdAt   DateTime @default(now())

  @@unique([origemTipo, origemId, destinoTipo, destinoId, vinculo])
  @@index([orgId, destinoTipo, destinoId])
}

/// Fila do hub de integrações (SEFAZ, bancos, transportadoras, WhatsApp, e-mail) com retry.
model ErpIntegracaoJob {
  id               String   @id @default(cuid())
  orgId            String
  provedor         String // brasilapi | sefaz | banco | frete | whatsapp | email
  operacao         String
  payload          String   @default("{}")
  status           String   @default("PENDENTE") // PENDENTE | OK | FALHOU
  tentativas       Int      @default(0)
  proximaTentativa DateTime @default(now())
  ultimoErro       String?
  resultado        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, proximaTentativa])
}

// ======================= MCK ERP · Etapa 2: Produtos, Estoque/WMS, Vendas/OMS =======================
// Quantidades em milésimos (Int): 1 un = 1000; 0,250 kg = 250. Valores em centavos. Percentuais em pontos-base (1% = 100).

model ErpConfig {
  orgId                 String   @id
  descontoMaxBp         Int      @default(1000) // alçada do vendedor (10%); acima disso o pedido vai para aprovação
  bloquearSemCredito    Boolean  @default(true)
  validadeOrcamentoDias Int      @default(15)
  proximoPedido         Int      @default(1)
  proximoLoteInterno    Int      @default(1)
  proximaSolicitacao    Int      @default(1)
  proximaCotacao        Int      @default(1)
  proximoPedidoCompra   Int      @default(1)
  proximaOp             Int      @default(1)
  alcadaCompraCents     Int      @default(500000) // pedido de compra até este valor é aprovado ao enviar; acima, só OWNER/ADMIN aprova
  toleranciaPrecoBp     Int      @default(200) // recebimento: diferença de preço NF × pedido aceita sem aprovação
  recebimentoCego       Boolean  @default(false) // conferência da NF-e sem mostrar a quantidade da nota
  multaAtrasoBp         Int      @default(200) // multa por atraso (2%)
  jurosMesBp            Int      @default(100) // juros de mora ao mês (1%), pro rata dia
  formatoLote           String   @default("{AA}{MM}{DD}-{SEQ}") // {AAAA} {AA} {MM} {DD} {SKU} {SEQ}
  etiquetaLarguraMm     Int      @default(100)
  etiquetaAlturaMm      Int      @default(50)
  etiquetaDpi           Int      @default(203) // 203 ou 300 (Zebra)
  // Alertas diários por WhatsApp para a administração (financeiro e estoque)
  alertaAtivo           Boolean  @default(false)
  alertaTelefones       String? // JSON: ["+55..."]
  alertaHora            Int      @default(8) // hora local (fuso da organização)
  alertaDiasAntes       Int      @default(3) // contas a pagar que vencem em até N dias (e as vencidas)
  alertaPagar           Boolean  @default(true)
  alertaEstoqueMinimo   Boolean  @default(true)
  alertaSemSaidaDias    Int      @default(15) // produto com saldo e sem saída há N dias; 0 = desligado
  alertaUltimoDia       String? // AAAA-MM-DD do último envio automático
  alertaStatus          String? // JSON: { at, ok, detail }
  relatorioUltimoDia    String? // "YYYY-MM-DD" do último relatório diário enviado ao proprietário
  updatedAt             DateTime @updatedAt
}

model ErpProduto {
  id                 String   @id @default(cuid())
  orgId              String
  sku                String
  nome               String
  descricao          String?
  codigoBarras       String?
  unidade            String   @default("UN") // UN, KG, CX, M...
  ncm                String?
  cest               String?
  origem             Int      @default(0) // 0 nacional ... 8 (tabela SEFAZ)
  pesoGramas         Int      @default(0)
  controlaLote       Boolean  @default(false)
  controlaValidade   Boolean  @default(false)
  regraSaida         String   @default("FIFO") // FIFO | FEFO
  estoqueMinimoMil   Int      @default(0)
  pontoPedidoMil     Int      @default(0)
  precoBaseCents     Int      @default(0)
  custoMedioCents    Int      @default(0) // por unidade (1000 mil)
  custosAdicionais   String   @default("[]") // JSON [{ nome, valorCents }] por unidade: embalagem, rótulo, frete... somados ao custo
  tipo               String   @default("REVENDA") // REVENDA | PRODUZIDO | INSUMO | SERVICO
  leadTimeDias       Int      @default(0) // prazo de compra ou de fabricação (MRP)
  loteMinimoMil      Int      @default(0) // lote mínimo de compra/produção (MRP)
  fornecedorPadraoId String?
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([orgId, sku])
  @@index([orgId, nome])
  @@index([orgId, codigoBarras])
}

model ErpTabelaPreco {
  id        String               @id @default(cuid())
  orgId     String
  nome      String
  uf        String? // tabela regional (opcional)
  ativa     Boolean              @default(true)
  createdAt DateTime             @default(now())
  itens     ErpTabelaPrecoItem[]

  @@index([orgId])
}

model ErpTabelaPrecoItem {
  id           String         @id @default(cuid())
  tabelaId     String
  tabela       ErpTabelaPreco @relation(fields: [tabelaId], references: [id], onDelete: Cascade)
  produtoId    String
  qtdMinimaMil Int            @default(0) // preço por volume: vale a partir desta quantidade
  precoCents   Int

  @@unique([tabelaId, produtoId, qtdMinimaMil])
}

model ErpCondicaoPagamento {
  id        String   @id @default(cuid())
  orgId     String
  nome      String // "30/60/90", "À vista"
  prazos    String   @default("[0]") // JSON: dias de cada parcela
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([orgId])
}

model ErpDeposito {
  id        String               @id @default(cuid())
  orgId     String
  filialId  String?
  nome      String
  ativo     Boolean              @default(true)
  createdAt DateTime             @default(now())
  enderecos ErpEnderecoEstoque[]

  @@index([orgId])
}

model ErpEnderecoEstoque {
  id         String      @id @default(cuid())
  orgId      String
  depositoId String
  deposito   ErpDeposito @relation(fields: [depositoId], references: [id], onDelete: Cascade)
  codigo     String // rua-prateleira-posição, ex.: A-01-03 (vai na etiqueta QR)
  ativo      Boolean     @default(true)

  @@unique([depositoId, codigo])
  @@index([orgId])
}

model ErpLote {
  id             String    @id @default(cuid())
  orgId          String
  produtoId      String
  numero         String
  fabricacao     DateTime?
  validade       DateTime?
  status         String    @default("LIBERADO") // LIBERADO | QUARENTENA | BLOQUEADO
  loteFornecedor String? // lote impresso pelo fornecedor (rastro da NF-e)
  fornecedorId   String? // ErpParceiro
  origemTipo     String? // nfe_entrada | op | ajuste | inicial
  origemId       String?
  createdAt      DateTime  @default(now())

  @@unique([orgId, produtoId, numero])
  @@index([orgId, produtoId, validade])
}

/**
 * Saldo por produto + lote + endereço. Disponível = físico − reservado − quarentena (nunca negativo).
 */
model ErpSaldo {
  id            String   @id @default(cuid())
  orgId         String
  produtoId     String
  loteId        String
  enderecoId    String
  fisicoMil     Int      @default(0)
  reservadoMil  Int      @default(0)
  quarentenaMil Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([produtoId, loteId, enderecoId])
  @@index([orgId, produtoId])
}

/**
 * Razão de estoque: só inserção. Toda mudança de saldo físico tem um movimento na mesma transação.
 */
model ErpMovimento {
  id             String   @id @default(cuid())
  orgId          String
  produtoId      String
  loteId         String
  enderecoId     String
  tipo           String // ENTRADA | SAIDA | AJUSTE | TRANSFERENCIA_SAIDA | TRANSFERENCIA_ENTRADA | QUARENTENA | LIBERACAO
  qtdMil         Int // com sinal: + entra, − sai
  custoUnitCents Int      @default(0)
  saldoAposMil   Int
  docTipo        String? // pedido_venda | ajuste | compra | op | inventario
  docId          String?
  motivo         String?
  userId         String?
  correlationId  String?
  createdAt      DateTime @default(now())

  @@index([orgId, produtoId, createdAt])
  @@index([orgId, docTipo, docId])
}

model ErpReserva {
  id           String   @id @default(cuid())
  orgId        String
  pedidoItemId String // id do item de origem: item do pedido de venda ou componente da OP (ver origemTipo)
  origemTipo   String   @default("pedido_venda") // pedido_venda | op
  saldoId      String
  produtoId    String
  loteId       String
  enderecoId   String
  qtdMil       Int
  separadoMil  Int      @default(0)
  status       String   @default("ATIVA") // ATIVA | BAIXADA | LIBERADA
  createdAt    DateTime @default(now())

  @@index([orgId, pedidoItemId])
  @@index([saldoId, status])
}

model ErpPedidoVenda {
  id                  String          @id @default(cuid())
  orgId               String
  numero              Int
  filialId            String?
  centroCustoId       String?
  depositoId          String?
  parceiroId          String
  oportunidadeId      String?
  vendedorId          String?
  tabelaPrecoId       String?
  condicaoPagamentoId String?
  statusOperacional   String          @default("RASCUNHO")
  statusFinanceiro    String          @default("SEM_TITULO")
  subtotalCents       Int             @default(0)
  descontoCents       Int             @default(0)
  freteCents          Int             @default(0)
  totalCents          Int             @default(0)
  descontoMaxItemBp   Int             @default(0)
  motivoBloqueio      String?
  aprovadoPorId       String?
  aprovadoEm          DateTime?
  validadeOrcamento   DateTime?
  nfNumero            String? // nota emitida (externa até a Etapa 4)
  transportadora      String?
  rastreio            String?
  entregueEm          DateTime?
  previsaoEntrega     DateTime?
  motivoCancelamento  String?
  observacoes         String?
  correlationId       String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  itens               ErpPedidoItem[]

  @@unique([orgId, numero])
  @@index([orgId, statusOperacional])
  @@index([orgId, parceiroId])
}

model ErpPedidoItem {
  id             String         @id @default(cuid())
  pedidoId       String
  pedido         ErpPedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId      String
  descricao      String
  qtdMil         Int
  precoUnitCents Int // por unidade
  descontoBp     Int            @default(0)
  totalCents     Int
  reservadoMil   Int            @default(0)
  separadoMil    Int            @default(0)
  posicao        Int            @default(0)

  @@index([pedidoId])
  @@index([produtoId])
}

/**
 * De-para: código do produto no fornecedor → produto interno, com fator (ex.: 1 CX do fornecedor = 12 UN = 12000).
 */
model ErpProdutoFornecedor {
  id               String   @id @default(cuid())
  orgId            String
  parceiroId       String
  codigoFornecedor String
  produtoId        String
  fatorMil         Int      @default(1000)
  createdAt        DateTime @default(now())

  @@unique([orgId, parceiroId, codigoFornecedor])
  @@index([orgId, produtoId])
}

/**
 * NF-e de entrada importada pelo XML: confere, vincula produtos e lança no estoque com lote.
 */
model ErpNfeEntrada {
  id              String              @id @default(cuid())
  orgId           String
  chave           String
  numero          String
  serie           String
  dataEmissao     DateTime?
  parceiroId      String
  emitenteCnpj    String
  emitenteNome    String
  valorTotalCents Int
  autorizada      Boolean             @default(false) // tem protNFe com cStat 100
  pedidoCompraId  String?
  status          String              @default("PENDENTE") // PENDENTE | LANCADA | CANCELADA
  xml             String
  lancadaEm       DateTime?
  lancadaPorId    String?
  createdAt       DateTime            @default(now())
  itens           ErpNfeEntradaItem[]

  @@unique([orgId, chave])
  @@index([orgId, status])
}

model ErpNfeEntradaItem {
  id              String        @id @default(cuid())
  nfeId           String
  nfe             ErpNfeEntrada @relation(fields: [nfeId], references: [id], onDelete: Cascade)
  nItem           Int
  codigo          String
  descricao       String
  ean             String?
  ncm             String?
  cfop            String?
  unidade         String
  qtdMil          Int // na unidade do fornecedor
  valorUnitCents  Int
  custoTotalCents Int // produto + IPI + ST + frete + seguro + outras − desconto
  lotes           String        @default("[]") // JSON do rastro: [{numero, qtdMil, fabricacao, validade}]
  produtoId       String?
  fatorMil        Int           @default(1000)
  lotesGerados    String        @default("[]") // ids dos lotes internos criados no lançamento
  conferidoMil    Int? // conferência física (na unidade do fornecedor)
}

/**
 * Inventário (geral ou cíclico): foto do saldo, contagem (cega opcional), aprovação das divergências e ajuste.
 */
model ErpInventario {
  id            String                  @id @default(cuid())
  orgId         String
  descricao     String
  depositoId    String?
  cego          Boolean                 @default(true)
  status        String                  @default("CONTANDO") // CONTANDO | EM_APROVACAO | CONCLUIDO | CANCELADO
  criadoPorId   String?
  aprovadoPorId String?
  concluidoEm   DateTime?
  createdAt     DateTime                @default(now())
  contagens     ErpInventarioContagem[]

  @@index([orgId, status])
}

model ErpInventarioContagem {
  id           String        @id @default(cuid())
  inventarioId String
  inventario   ErpInventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  produtoId    String
  loteId       String
  enderecoId   String
  sistemaMil   Int // saldo físico na abertura
  contadoMil   Int?
  contadoPorId String?
  contadoEm    DateTime?

  @@unique([inventarioId, produtoId, loteId, enderecoId])
}

// ======================= Compras =======================
model ErpSolicitacaoCompra {
  id            String               @id @default(cuid())
  orgId         String
  numero        Int
  solicitanteId String?
  centroCustoId String?
  justificativa String?
  origem        String               @default("MANUAL") // MANUAL | MRP
  necessidadeEm DateTime?
  status        String               @default("RASCUNHO") // RASCUNHO | EM_APROVACAO | APROVADA | REPROVADA | ATENDIDA | CANCELADA
  aprovadoPorId String?
  motivo        String?
  createdAt     DateTime             @default(now())
  itens         ErpSolicitacaoItem[]

  @@unique([orgId, numero])
  @@index([orgId, status])
}

model ErpSolicitacaoItem {
  id            String               @id @default(cuid())
  solicitacaoId String
  solicitacao   ErpSolicitacaoCompra @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  produtoId     String
  qtdMil        Int
  atendidoMil   Int                  @default(0)
}

model ErpCotacao {
  id            String               @id @default(cuid())
  orgId         String
  numero        Int
  solicitacaoId String?
  prazoResposta DateTime?
  status        String               @default("ABERTA") // ABERTA | ENCERRADA | CANCELADA
  fornecedores  String               @default("[]") // JSON ids de ErpParceiro convidados
  createdAt     DateTime             @default(now())
  itens         ErpCotacaoItem[]
  respostas     ErpCotacaoResposta[]

  @@unique([orgId, numero])
  @@index([orgId, status])
}

model ErpCotacaoItem {
  id                String     @id @default(cuid())
  cotacaoId         String
  cotacao           ErpCotacao @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  produtoId         String
  qtdMil            Int
  solicitacaoItemId String?
}

model ErpCotacaoResposta {
  id               String     @id @default(cuid())
  cotacaoId        String
  cotacao          ErpCotacao @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  itemId           String
  parceiroId       String
  precoUnitCents   Int
  prazoEntregaDias Int        @default(0)
  condicao         String?
  vencedora        Boolean    @default(false)

  @@unique([itemId, parceiroId])
}

model ErpPedidoCompra {
  id              String                @id @default(cuid())
  orgId           String
  numero          Int
  parceiroId      String
  status          String                @default("RASCUNHO") // RASCUNHO | EM_APROVACAO | APROVADO | ENVIADO | RECEBIDO_PARCIAL | RECEBIDO | CANCELADO
  totalCents      Int                   @default(0)
  freteCents      Int                   @default(0)
  previsaoEntrega DateTime?
  condicao        String?
  observacoes     String?
  cotacaoId       String?
  centroCustoId   String?
  aprovadoPorId   String?
  motivo          String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  itens           ErpPedidoCompraItem[]

  @@unique([orgId, numero])
  @@index([orgId, status])
  @@index([orgId, parceiroId])
}

model ErpPedidoCompraItem {
  id                String          @id @default(cuid())
  pedidoId          String
  pedido            ErpPedidoCompra @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId         String
  descricao         String
  qtdMil            Int
  precoUnitCents    Int
  totalCents        Int
  recebidoMil       Int             @default(0)
  solicitacaoItemId String?
}

// ======================= Produção =======================
/**
 * Estrutura do produto (BOM): componentes por 1 unidade do produto pai, com perda.
 */
model ErpEstruturaItem {
  id           String @id @default(cuid())
  orgId        String
  produtoId    String
  componenteId String
  qtdMil       Int
  perdaBp      Int    @default(0)
  posicao      Int    @default(0)

  @@unique([produtoId, componenteId])
  @@index([orgId, componenteId])
}

/**
 * Roteiro: operações por unidade, para custo padrão e carga dos centros de trabalho.
 */
model ErpOperacao {
  id             String @id @default(cuid())
  orgId          String
  produtoId      String
  sequencia      Int
  descricao      String
  centroTrabalho String
  segundosPorUn  Int    @default(0)
  setupMinutos   Int    @default(0)
  custoHoraCents Int    @default(0)

  @@index([orgId, produtoId])
}

model ErpOrdemProducao {
  id                 String             @id @default(cuid())
  orgId              String
  numero             Int
  produtoId          String
  qtdPlanejadaMil    Int
  qtdProduzidaMil    Int                @default(0)
  qtdRefugoMil       Int                @default(0)
  status             String             @default("PLANEJADA") // PLANEJADA | LIBERADA | EM_PRODUCAO | ENCERRADA | CANCELADA
  origem             String             @default("MANUAL") // MANUAL | MRP | PEDIDO
  pedidoVendaId      String?
  depositoId         String?
  inicioPrevisto     DateTime?
  fimPrevisto        DateTime?
  encerradaEm        DateTime?
  custoMaterialCents Int                @default(0)
  custoOperacaoCents Int                @default(0)
  motivo             String?
  createdAt          DateTime           @default(now())
  componentes        ErpOpComponente[]
  apontamentos       ErpOpApontamento[]

  @@unique([orgId, numero])
  @@index([orgId, status])
}

model ErpOpComponente {
  id              String           @id @default(cuid())
  opId            String
  op              ErpOrdemProducao @relation(fields: [opId], references: [id], onDelete: Cascade)
  produtoId       String
  qtdPrevistaMil  Int
  qtdReservadaMil Int              @default(0)
  qtdConsumidaMil Int              @default(0)
}

model ErpOpApontamento {
  id             String           @id @default(cuid())
  opId           String
  op             ErpOrdemProducao @relation(fields: [opId], references: [id], onDelete: Cascade)
  qtdBoaMil      Int
  qtdRefugoMil   Int              @default(0)
  loteId         String?
  custoUnitCents Int              @default(0)
  userId         String?
  createdAt      DateTime         @default(now())
}

// ======================= Financeiro =======================
model ErpContaFinanceira {
  id                String   @id @default(cuid())
  orgId             String
  nome              String
  tipo              String   @default("BANCO") // BANCO | CAIXA | CARTAO
  banco             String?
  agencia           String?
  conta             String?
  chavePix          String? // chave Pix do cliente (para gerar Pix copia-e-cola)
  saldoInicialCents Int      @default(0)
  ativa             Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([orgId])
}

/**
 * Plano de contas gerencial (DRE): código hierárquico 1, 1.01, 1.01.001.
 */
model ErpCategoriaFinanceira {
  id     String  @id @default(cuid())
  orgId  String
  codigo String
  nome   String
  tipo   String // RECEITA | DESPESA
  grupo  String  @default("OPERACIONAL") // RECEITA_BRUTA | DEDUCAO | CUSTO | OPERACIONAL | FINANCEIRA | IMPOSTO
  ativa  Boolean @default(true)

  @@unique([orgId, codigo])
}

model ErpTitulo {
  id              String     @id @default(cuid())
  orgId           String
  tipo            String // RECEBER | PAGAR
  parceiroId      String?
  descricao       String
  docTipo         String? // pedido_venda | nfe_entrada | manual
  docId           String?
  parcela         Int        @default(1)
  parcelas        Int        @default(1)
  valorCents      Int
  pagoCents       Int        @default(0)
  jurosCents      Int        @default(0)
  descontoCents   Int        @default(0)
  emissao         DateTime   @default(now())
  competencia     DateTime   @default(now())
  vencimento      DateTime
  status          String     @default("EM_ABERTO") // EM_ABERTO | PARCIAL | PAGO | CANCELADO
  categoriaId     String?
  centroCustoId   String?
  contaPrevistaId String?
  natureza        String? // a pagar: FORNECEDOR (nulo = fornecedor) | AGUA | LUZ | INTERNET | TELEFONE | ALUGUEL | IMPOSTO | OUTRA_CONTA
  observacoes     String?
  createdAt       DateTime   @default(now())
  baixas          ErpBaixa[]

  @@unique([orgId, tipo, docTipo, docId, parcela])
  @@index([orgId, tipo, status, vencimento])
  @@index([orgId, parceiroId])
}

model ErpBaixa {
  id            String    @id @default(cuid())
  tituloId      String
  titulo        ErpTitulo @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  contaId       String
  data          DateTime
  valorCents    Int // principal abatido
  jurosCents    Int       @default(0)
  descontoCents Int       @default(0)
  forma         String    @default("PIX") // PIX | BOLETO | TED | DINHEIRO | CARTAO
  estornada     Boolean   @default(false)
  userId        String?
  createdAt     DateTime  @default(now())
}

/**
 * Movimento da conta (baixas, transferências, tarifas). Base do saldo e da conciliação.
 */
model ErpLancamento {
  id          String   @id @default(cuid())
  orgId       String
  contaId     String
  data        DateTime
  valorCents  Int // + entrada, − saída
  descricao   String
  origemTipo  String // baixa | transferencia | avulso | estorno
  origemId    String?
  categoriaId String?
  conciliado  Boolean  @default(false)
  extratoId   String?
  createdAt   DateTime @default(now())

  @@index([orgId, contaId, data])
}

/**
 * Linha do extrato bancário importado (OFX) para conciliação.
 */
model ErpExtratoLinha {
  id           String   @id @default(cuid())
  orgId        String
  contaId      String
  fitId        String
  data         DateTime
  valorCents   Int
  descricao    String
  lancamentoId String?
  createdAt    DateTime @default(now())

  @@unique([contaId, fitId])
  @@index([orgId, contaId, data])
}

// ======================= Fiscal =======================
/**
 * Dados do emitente e certificado A1 do próprio cliente (cifrado com MASTER_KEY).
 */
model ErpConfigFiscal {
  orgId         String    @id
  razaoSocial   String    @default("")
  fantasia      String?
  cnpj          String    @default("")
  ie            String    @default("")
  crt           Int       @default(1) // 1 Simples Nacional | 2 Simples excesso | 3 Regime normal
  uf            String    @default("SP")
  codMunicipio  String    @default("")
  municipio     String    @default("")
  logradouro    String    @default("")
  numero        String    @default("")
  bairro        String    @default("")
  cep           String    @default("")
  fone          String?
  ambiente      Int       @default(2) // 1 produção | 2 homologação
  serie         Int       @default(1)
  proximoNumero Int       @default(1)
  certPfx       String? // cifrado
  certSenha     String? // cifrado
  certTitular   String?
  certValidade  DateTime?
  updatedAt     DateTime  @updatedAt
}

/**
 * Regra de tributação: por produto, por prefixo de NCM ou padrão (sem produto e sem NCM).
 */
model ErpRegraFiscal {
  id           String  @id @default(cuid())
  orgId        String
  nome         String
  produtoId    String?
  ncmPrefixo   String?
  cfopDentro   String  @default("5102")
  cfopFora     String  @default("6102")
  csosn        String  @default("102") // Simples Nacional
  cstIcms      String  @default("00") // regime normal
  aliqIcmsBp   Int     @default(0)
  cstIpi       String  @default("53")
  aliqIpiBp    Int     @default(0)
  cstPis       String  @default("49")
  aliqPisBp    Int     @default(0)
  cstCofins    String  @default("49")
  aliqCofinsBp Int     @default(0)
  prioridade   Int     @default(0)

  @@index([orgId, produtoId])
}

model ErpNfeSaida {
  id           String    @id @default(cuid())
  orgId        String
  pedidoId     String?
  parceiroId   String
  numero       Int
  serie        Int
  chave        String
  ambiente     Int
  status       String    @default("ASSINADA") // RASCUNHO | ASSINADA | AUTORIZADA | REJEITADA | CANCELADA
  totalCents   Int
  xml          String
  protocolo    String?
  cStat        String?
  motivo       String?
  autorizadaEm DateTime?
  canceladaEm  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([orgId, chave])
  @@unique([orgId, serie, numero, ambiente])
  @@index([orgId, status])
  @@index([pedidoId])
}
