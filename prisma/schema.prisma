// MCKBOT — schema principal (PostgreSQL em produção).
// Para dev/testes, scripts/sqlite-schema.mjs gera prisma/sqlite/schema.prisma trocando o provider.
// Campos JSON são armazenados como texto (String) para manter compatibilidade entre PostgreSQL e SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  phone           String?
  passwordHash    String
  isSuperAdmin    Boolean       @default(false)
  disabledAt      DateTime?
  emailVerifiedAt DateTime?
  /// Verificação em duas etapas (TOTP): segredo cifrado (AES-GCM com MASTER_KEY); pendente = em configuração.
  totpSecretEnc   String?
  totpPendingEnc  String?
  totpEnabledAt   DateTime?
  totpLastStep    Int?
  /// Hashes SHA-256 dos códigos de recuperação ainda não usados (JSON).
  recoveryCodes   String        @default("[]")
  /// Bloqueio temporário após senhas/códigos errados seguidos.
  failedLogins    Int           @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  memberships     Membership[]
  sessions        Session[]
  authTokens      AuthToken[]
  knownDevices    KnownDevice[]
}

/// Aparelhos (navegadores) já usados para entrar; login de aparelho novo gera alerta por e-mail.
model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceHash  String // sha256 do cookie mck_did
  userAgent   String?
  ip          String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
}

/// Execuções do backup diário do banco.
model BackupRun {
  id          String    @id @default(cuid())
  trigger     String    @default("AUTO") // AUTO | MANUAL
  status      String    @default("RUNNING") // RUNNING | OK | FAILED
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  sizeBytes   Int?
  rows        Int?
  destination String?
  location    String?
  error       String?

  @@index([startedAt])
}

/// Tokens de uso único enviados por e-mail (redefinição de senha e verificação de e-mail). Só o hash fica salvo.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  kind      String // RESET_PASSWORD | VERIFY_EMAIL
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  timezone    String       @default("America/Sao_Paulo")
  plan        String       @default("gratis")
  // Aviso "Aguardando atendente": número de WhatsApp reserva (E.164 BR) e minutos de espera até o aviso.
  backupPhone         String?
  handoffAlertMinutes Int          @default(5)
  createdAt   DateTime     @default(now())
  memberships Membership[]
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      String // OWNER | ADMIN | AGENT
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        String
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId])
}

model Session {
  id         String    @id // sha256 do token do cookie
  userId     String
  orgId      String?
  csrfToken  String
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      String   @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

model Channel {
  id             String    @id @default(cuid())
  orgId          String
  name           String
  provider       String    @default("whatsapp_cloud") // whatsapp_cloud (API oficial) | whatsapp_qr (WhatsApp Web via QR code)
  phoneNumberId  String?
  wabaId         String?
  displayPhone   String?
  accessTokenEnc String?
  appSecretEnc   String?
  verifyToken    String
  status         String    @default("NOT_CONNECTED") // NOT_CONNECTED | CONNECTING | QR_PENDING | CONNECTED | ERROR
  waJid          String? // modo QR: JID do aparelho conectado
  connectedAt    DateTime? // modo QR: quando a sessão foi aberta pela última vez
  lastError      String?
  lastWebhookAt  DateTime?
  lastCheckedAt  DateTime?
  qrLeaseOwner   String? // modo QR: instância do servidor que segura a sessão (evita 2 conexões no deploy)
  qrLeaseUntil   DateTime? // modo QR: validade da trava; expira sozinha se a instância cair
  replySavedContacts  Boolean   @default(false) // modo QR: responder automaticamente contatos salvos na agenda do celular (padrão: não)
  addressBookSyncedAt DateTime? // modo QR: quando a agenda do celular foi sincronizada por completo pela última vez
  autoReplyMode       String    @default("both") // quem responde automaticamente neste canal: flows (só fluxos) | ai (só IA) | both (fluxos + IA, padrão)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orgId])
}

/// Estado de autenticação do Baileys (modo QR), cifrado com a MASTER_KEY. Nada de sessão em disco local.
/// type = "creds" (keyId vazio) ou o tipo de chave do Signal (pre-key, session, sender-key, app-state-sync-key...).
model WaAuthState {
  id        String   @id @default(cuid())
  channelId String
  type      String
  keyId     String
  dataEnc   String
  updatedAt DateTime @updatedAt

  @@unique([channelId, type, keyId])
  @@index([channelId])
}

/// Agenda do celular conectado (modo QR): quais números/LIDs estão salvos como contato no aparelho.
/// Vem da sincronização do WhatsApp (app-state "contactAction"). Só o fato de estar salvo — o nome não é guardado.
/// jidKey = dígitos do número (5511999990000) ou "lid:<id>" para contatos identificados por LID.
model WaPhoneContact {
  id        String   @id @default(cuid())
  channelId String
  jidKey    String
  saved     Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([channelId, jidKey])
  @@index([channelId])
}

/// Mensagens enviadas pelo modo QR (conteúdo completo, cifrado), para reenvio fiel quando o celular
/// do cliente pede de novo ("Aguardando mensagem"). Guardadas por 14 dias.
model WaSentMessage {
  id          String   @id @default(cuid())
  channelId   String
  waMessageId String
  dataEnc     String
  createdAt   DateTime @default(now())

  @@unique([channelId, waMessageId])
  @@index([createdAt])
}

model KanbanStage {
  id       String @id @default(cuid())
  orgId    String
  name     String
  position Int
  color    String @default("#64748b")

  @@index([orgId])
}

model Contact {
  id            String    @id @default(cuid())
  orgId         String
  waId          String
  phone         String
  name          String?
  email         String?
  tags          String    @default("[]")
  notes         String?
  vars          String    @default("{}")
  stageId       String?
  optOut        Boolean   @default(false)
  savedInPhone  Boolean   @default(false) // salvo na agenda do celular de algum número QR conectado (informativo)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([orgId, waId])
  @@index([orgId, stageId])
}

model Conversation {
  id              String    @id @default(cuid())
  orgId           String
  contactId       String
  channelId       String?
  status          String    @default("OPEN") // OPEN | PENDING | CLOSED
  mode            String    @default("BOT") // BOT | HUMAN
  assignedUserId  String?
  unreadCount     Int       @default(0)
  lastInboundAt   DateTime?
  lastMessageAt   DateTime?
  firstResponseAt DateTime?
  closedAt        DateTime?
  // "Aguardando atendente": quando a IA/fluxo transferiu para humano (limpo quando o atendente responde).
  waitingSince       DateTime?
  handoffAlertSentAt DateTime?
  createdAt       DateTime  @default(now())

  @@index([orgId, status])
  @@index([contactId])
  @@index([orgId, waitingSince])
}

model Message {
  id             String   @id @default(cuid())
  orgId          String
  conversationId String
  channelId      String?
  direction      String // IN | OUT
  sender         String // contact | bot | ai | agent | system
  type           String   @default("text")
  body           String?
  mediaUrl       String?
  waMessageId    String?
  status         String // RECEIVED | QUEUED | SENT | DELIVERED | READ | FAILED
  error          String?
  attempts       Int      @default(0)
  authorUserId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([channelId, waMessageId])
  @@index([orgId, createdAt])
  @@index([conversationId, createdAt])
}

model Flow {
  id             String        @id @default(cuid())
  orgId          String
  name           String
  description    String?
  status         String        @default("DRAFT") // DRAFT | ACTIVE | PAUSED
  priority       Int           @default(0)
  currentVersion Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  versions       FlowVersion[]

  @@index([orgId, status])
}

model FlowVersion {
  id          String   @id @default(cuid())
  flowId      String
  version     Int
  graph       String
  createdById String?
  createdAt   DateTime @default(now())
  flow        Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, version])
}

model FlowRun {
  id               String    @id @default(cuid())
  orgId            String
  flowId           String
  flowVersion      Int
  conversationId   String
  contactId        String
  status           String // RUNNING | WAITING | COMPLETED | FAILED | HANDOFF | CANCELLED
  currentNodeId    String?
  waitType         String? // reply | timer
  resumeAt         DateTime?
  vars             String    @default("{}")
  stepCount        Int       @default(0)
  error            String?
  triggerMessageId String?   @unique
  startedAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  finishedAt       DateTime?

  @@index([orgId, status])
  @@index([conversationId, status])
}

model FlowRunStep {
  id        String   @id @default(cuid())
  orgId     String
  runId     String
  flowId    String
  nodeId    String
  nodeType  String
  status    String // ok | warn | error
  detail    String?
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([flowId, nodeId])
}

model AiSettings {
  orgId             String   @id
  enabled           Boolean  @default(false)
  autoReply         Boolean  @default(false)
  provider          String   @default("gemini") // openai | gemini | fake (somente testes)
  model             String   @default("gemini-3.5-flash-lite")
  baseUrl           String?
  apiKeyEnc         String?
  instructions      String   @default("")
  tone              String   @default("cordial e objetivo")
  temperature       Float    @default(0.3)
  maxTokens         Int      @default(400)
  dailyLimit        Int      @default(200)
  monthlyTokenLimit Int      @default(500000)
  handoffKeywords   String   @default("[\"atendente\",\"humano\",\"pessoa\"]")
  fallbackMessage   String   @default("Vou transferir você para um atendente humano. Aguarde um momento, por favor.")
  updatedAt         DateTime @updatedAt
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  orgId     String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model KnowledgeChunk {
  id    String @id @default(cuid())
  orgId String
  docId String
  idx   Int
  text  String

  @@index([orgId])
  @@index([docId])
}

model AiUsage {
  id               String   @id @default(cuid())
  orgId            String
  conversationId   String?
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  success          Boolean
  handoff          Boolean  @default(false)
  error            String?
  latencyMs        Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([orgId, createdAt])
}

model Integration {
  id             String    @id @default(cuid())
  orgId          String
  name           String
  slug           String
  baseUrl        String
  authHeaderName String?
  authValueEnc   String?
  lastTestAt     DateTime?
  lastTestStatus String?
  createdAt      DateTime  @default(now())

  @@unique([orgId, slug])
}

// ---------- MCKMENSAGEM: disparo para leads com consentimento ----------

model Lead {
  id              String    @id @default(cuid())
  orgId           String
  phone           String // E.164, ex.: +5511999998888
  name            String?
  tags            String    @default("[]")
  status          String    @default("NOVO") // NOVO | CONTATADO | RESPONDEU | CONVERTIDO | DESCARTADO
  consentSource   String // FORMULARIO | IMPORTACAO | ANUNCIO_CTWA | MANUAL
  consentAt       DateTime
  optOutAt        DateTime?
  campaignId      String?
  contactId       String?
  // IA de qualificação (MCK Mensagens)
  qualifyAttempts Int       @default(0) // respostas negativas recebidas (cada uma gera uma nova tentativa)
  nextAttemptAt   DateTime? // quando AGUARDANDO: próxima tentativa automática
  lastIntent      String? // POSITIVO | NEGATIVO | DUVIDA | SAIR
  aiSummary       String? // resumo curto da IA sobre o lead
  qualifiedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([orgId, phone])
  @@index([orgId, status])
  @@index([contactId])
  @@index([status, nextAttemptAt])
}

/**
 * IA de qualificação de leads do MCK Mensagens (usa o provedor/chave configurados em IA do MCKBOT).
 */
model LeadAiSettings {
  orgId           String   @id
  enabled         Boolean  @default(false)
  instructions    String   @default("") // o que a empresa vende, público, como abordar
  offer           String   @default("") // próximo passo oferecido a quem tem interesse (ex.: teste grátis de 1h)
  positiveAction  String   @default("HANDOFF") // HANDOFF (atendente) | FLOW (inicia um fluxo do MCKBOT) | BOT (segue no robô/IA)
  positiveFlowId  String?
  promptTemplate  String? // prompt editável pelo cliente; vazio = padrão do sistema
  positiveMessage String   @default("") // mensagem fixa extra enviada depois da resposta da IA no positivo
  negativeAction  String   @default("RETRY") // RETRY | FLOW | HANDOFF | DISCARD
  negativeFlowId  String?
  doubtAction     String   @default("AI") // AI | FLOW | HANDOFF
  doubtFlowId     String?
  tagPositive     String   @default("lead-qualificado")
  tagWaiting      String   @default("lead-aguardando")
  tagDiscarded    String   @default("lead-descartado")
  retryDays       Int      @default(3)
  maxAttempts     Int      @default(3)
  retryMessage    String   @default("Oi {nome}! Passando de novo por aqui 😊 Ainda posso te ajudar? Se quiser, libero um teste grátis pra você conhecer, sem compromisso.")
  updatedAt       DateTime @updatedAt
}

model Campaign {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  message        String
  channelId      String
  status         String   @default("RASCUNHO") // RASCUNHO | AGENDADA | EM_ANDAMENTO | PAUSADA | CONCLUIDA
  dailyLimit     Int      @default(50)
  minIntervalSec Int      @default(45)
  maxIntervalSec Int      @default(120)
  windowStart    String   @default("09:00")
  windowEnd      String   @default("20:00")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId, status])
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  leadId     String
  status     String    @default("PENDENTE") // PENDENTE | ENVIADA | FALHOU | IGNORADA
  sentAt     DateTime?
  error      String?

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
  @@index([leadId])
}

// ---------- Cobrança (Mercado Pago) ----------

model Subscription {
  id         String   @id @default(cuid())
  orgId      String
  product    String // MCKBOT | MCKMENSAGEM
  status     String   @default("TRIAL") // TRIAL | ATIVA | VENCIDA | BLOQUEADA
  cycle      String   @default("MENSAL") // MENSAL | ANUAL
  validUntil DateTime
  source     String   @default("TRIAL") // TRIAL | MANUAL | MP
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([orgId, product])
}

model BillingEvent {
  id             String    @id @default(cuid())
  orgId          String
  product        String // MCKBOT | MCKMENSAGEM | COMBO
  kind           String // TRIAL | MANUAL | MP | BLOCK | UNBLOCK
  cycle          String?
  amountCents    Int?
  mpPaymentId    String?   @unique
  actorUserId    String?
  prevValidUntil DateTime?
  newValidUntil  DateTime?
  createdAt      DateTime  @default(now())

  @@index([orgId, createdAt])
}

model PlatformSettings {
  id                 String   @id @default("default")
  trialDays          Int      @default(7)
  pricesJson         String   @default("{\"MCKBOT\":{\"MENSAL\":3990,\"ANUAL\":39900},\"MCKMENSAGEM\":{\"MENSAL\":4500,\"ANUAL\":45000},\"COMBO\":{\"MENSAL\":6990,\"ANUAL\":69900}}")
  mpWebhookSecretEnc String?
  siteJson           String   @default("{}") // Site oficial (/empresa): contato, Facebook, tutoriais públicos, promoção em destaque
  updatedAt          DateTime @updatedAt
}

// ---------- Cupons de desconto (parcerias com influenciadores/empresas) ----------
model Coupon {
  id          String             @id @default(cuid())
  code        String             @unique // MAIÚSCULO, ex.: INFLU10
  partner     String? // influenciador ou empresa parceira
  type        String // PERCENT | FIXED
  value       Int // PERCENT: 1..99 (%); FIXED: centavos
  product     String             @default("ALL") // ALL | MCKBOT | MCKMENSAGEM | COMBO
  cycles      String             @default("ALL") // ALL | MENSAL | ANUAL
  validUntil  DateTime?
  maxUses     Int?
  active      Boolean            @default(true)
  createdBy   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  redemptions CouponRedemption[]
}

// Uso do cupom: gravado só quando o pagamento é confirmado (webhook/confirm do Mercado Pago).
model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id])
  orgId         String
  product       String
  cycle         String
  mpPaymentId   String   @unique
  originalCents Int
  discountCents Int
  finalCents    Int
  status        String   @default("CONFIRMADO") // CONFIRMADO | ESTORNADO
  createdAt     DateTime @default(now())

  @@index([couponId, status])
}

/// "Voltar ao menu": comando global do cliente final do WhatsApp (por organização).
model FlowSettings {
  orgId              String   @id
  menuCommandEnabled Boolean  @default(true)
  menuCommandWords   String   @default("0,menu,voltar") // separadas por vírgula; comparação sem maiúsculas/acentos
  menuFooterEnabled  Boolean  @default(true)
  menuFooterText     String   @default("↩️ Digite 0 para voltar ao menu")
  menuButtonEnabled  Boolean  @default(true) // botão "Voltar ao menu" na Cloud API (no QR usa-se o texto)
  menuFlowId         String? // fluxo do menu; vazio = automático
  updatedAt          DateTime @updatedAt
}

// ---------- MCK MENSAGENS: Automações e Cobranças (FASE 1: clientes, lembretes, marketing) ----------

/// Cliente do módulo Automações e Cobranças. Deduplicado (no código) por telefone/WhatsApp, e-mail e CPF/CNPJ dentro da organização.
model Cliente {
  id                  String    @id @default(cuid())
  orgId               String
  nome                String
  documento           String? // CPF/CNPJ só com dígitos
  telefone            String? // E.164
  whatsapp            String? // E.164 (com código do país)
  email               String? // minúsculo
  emailSecundario     String?
  empresa             String?
  plano               String?
  dataContratacao     DateTime?
  dataVencimento      DateTime?
  valorCentavos       Int?
  parcelas            Int?
  formaPagamento      String?
  status              String    @default("ATIVO") // ATIVO | INATIVO | INADIMPLENTE | CANCELADO
  observacoes         String?
  prefWhatsapp        Boolean   @default(true)
  prefEmail           Boolean   @default(true)
  consentimentoAt     DateTime?
  consentimentoOrigem String? // FORMULARIO | IMPORTACAO | ANUNCIO_CTWA | MANUAL
  marketingOptOutAt   DateTime?
  contactId           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([orgId, nome])
  @@index([orgId, telefone])
  @@index([orgId, whatsapp])
  @@index([orgId, email])
  @@index([orgId, documento])
}

/// Automação de envio (LEMBRETE ou MARKETING) com regra de recorrência em JSON.
model Automacao {
  id          String    @id @default(cuid())
  orgId       String
  nome        String
  categoria   String // LEMBRETE | MARKETING | COBRANCA
  canais      String    @default("[\"WHATSAPP\"]") // JSON: WHATSAPP e/ou EMAIL
  channelId   String? // canal WhatsApp (vazio = o conectado da organização)
  assunto     String? // assunto do e-mail
  mensagem    String
  clienteIds  String    @default("[]") // JSON com os ids dos clientes destinatários
  regra       String // JSON: { tipo: UNICO|DIARIO|SEMANAL|MENSAL|DATAS|ANUAL|INTERVALO, ... }
  timezone    String    @default("America/Sao_Paulo")
  inicio      DateTime
  fim         DateTime?
  maxEnvios   Int?
  status      String    @default("RASCUNHO") // RASCUNHO | ATIVA | PAUSADA | CANCELADA | CONCLUIDA
  geradoAte   DateTime? // horizonte até onde as ocorrências já foram geradas
  reenvio     String? // COBRANCA: JSON { offsets: [-1,0,1,3,7], horario: "10:00", maxPorBoleto: 5, mensagem? }
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId, status])
  @@index([status, geradoAte])
}

/// Um envio programado, por cliente e por canal. "chave" garante idempotência (automação + cliente + canal + horário original).
model Ocorrencia {
  id             String    @id @default(cuid())
  orgId          String
  automacaoId    String
  clienteId      String
  canal          String // WHATSAPP | EMAIL
  chave          String    @unique
  agendadoPara   DateTime // horário programado (pode ser alterado em "só esta ocorrência")
  executarEm     DateTime // próximo momento de execução (agendadoPara ou nova tentativa)
  status         String    @default("PENDENTE") // PENDENTE | PROCESSANDO | ENVIADA | FALHOU | IGNORADA | CANCELADA
  tentativas     Int       @default(0)
  erro           String?
  provedorId     String?
  mensagem       String? // texto só desta ocorrência (edição pontual)
  editada        Boolean   @default(false)
  lockedAt       DateTime?
  enviadoEm      DateTime?
  indice         Int? // posição do envio na sequência (1 = primeiro), usada para os anexos por mensagem
  tipo           String    @default("ENVIO") // ENVIO | REENVIO (cobrança relativa ao vencimento)
  boletoId       String? // cobrança: boleto principal desta mensagem
  partesEnviadas Int       @default(0) // WhatsApp: texto + anexos já enviados (retentativa não repete partes)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([boletoId, status])
  @@index([status, executarEm])
  @@index([orgId, agendadoPara])
  @@index([automacaoId, status])
  @@index([clienteId])
}

/// Histórico de mensagens do módulo (um registro por ocorrência, atualizado a cada tentativa).
model MensagemHistorico {
  id            String    @id @default(cuid())
  orgId         String
  ocorrenciaId  String?   @unique
  automacaoId   String?
  clienteId     String?
  categoria     String
  canal         String
  direcao       String    @default("OUT")
  assunto       String?
  conteudo      String
  agendadoPara  DateTime?
  enviadoEm     DateTime?
  provedorId    String?
  status        String // ENVIADA | FALHOU | IGNORADA | CANCELADA | TENTANDO | RECEBIDA
  erro          String?
  tentativas    Int       @default(0)
  operadorId    String?
  anexos        String? // JSON: [{ arquivoId, nome, boletoId? }]
  boletoId      String?
  comprovanteId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([orgId, createdAt])
  @@index([orgId, clienteId])
  @@index([automacaoId])
}

/// Configurações do módulo por organização.
model AutomacaoConfig {
  orgId                 String   @id
  timezone              String   @default("America/Sao_Paulo")
  janelaInicio          String   @default("08:00")
  janelaFim             String   @default("20:00")
  limiteDiario          Int      @default(500)
  maxTentativas         Int      @default(3)
  backoffSeg            Int      @default(60)
  tiposArquivo          String   @default("pdf,png,jpg,webp") // extensões permitidas para anexos e comprovantes
  tamanhoMaxMb          Int      @default(10)
  reenvioPadrao         String   @default("{\"offsets\":[-1,0,1,3,7],\"horario\":\"10:00\",\"maxPorBoleto\":5}")
  notificarComprovantes Boolean  @default(true) // e-mail aos administradores quando chega comprovante
  updatedAt             DateTime @updatedAt
}

/// Modelos de mensagem reutilizáveis, por categoria (LEMBRETE | MARKETING).
model ModeloMensagem {
  id        String   @id @default(cuid())
  orgId     String
  categoria String
  nome      String
  assunto   String?
  corpo     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, categoria])
}

// ---------------- Automações e Cobranças — FASE 2 (boletos, arquivos, comprovantes, pagamentos) ----------------

/// Metadados de um arquivo (boleto, fatura, documento, comprovante). O conteúdo fica em ArquivoConteudo (Postgres bytea).
model Arquivo {
  id          String   @id @default(cuid())
  orgId       String
  clienteId   String? // vazio = documento genérico (pode ir para qualquer cliente)
  nome        String
  mime        String
  tamanho     Int
  sha256      String
  origem      String   @default("UPLOAD") // UPLOAD | WHATSAPP | EMAIL
  descricao   String?
  criadoPorId String?
  createdAt   DateTime @default(now())

  @@index([orgId, clienteId])
  @@index([orgId, sha256])
}

model ArquivoConteudo {
  arquivoId String @id
  dados     Bytes
}

/// Boleto/fatura/parcela de um cliente. status = financeiro; statusEnvio = mensagem (não se confundem).
model Boleto {
  id                      String    @id @default(cuid())
  orgId                   String
  clienteId               String
  descricao               String
  numeroDocumento         String?
  parcela                 Int?
  totalParcelas           Int?
  valorCentavos           Int
  valorAtualizadoCentavos Int?
  jurosCentavos           Int       @default(0)
  multaCentavos           Int       @default(0)
  descontoCentavos        Int       @default(0)
  valorPagoCentavos       Int       @default(0) // soma dos pagamentos não estornados
  emissao                 DateTime?
  vencimento              DateTime // meio-dia UTC da data de vencimento
  codigoBarras            String?
  linhaDigitavel          String?
  linkPagamento           String?
  arquivoId               String?
  status                  String    @default("PENDENTE") // RASCUNHO | PENDENTE | VENCIDO | EM_ANALISE | PARCIAL | PAGO | CANCELADO
  statusEnvio             String    @default("NAO_ENVIADO") // NAO_ENVIADO | ENVIADO | FALHOU
  enviadoEm               DateTime?
  envios                  Int       @default(0)
  pagoEm                  DateTime?
  origemBaixa             String? // MANUAL | COMPROVANTE
  observacoes             String?
  criadoPorId             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([orgId, status])
  @@index([orgId, clienteId])
  @@index([orgId, vencimento])
}

/// Histórico de alterações de um boleto (só inserção: nada é apagado).
model BoletoEvento {
  id         String   @id @default(cuid())
  orgId      String
  boletoId   String
  tipo       String // CRIADO | EDITADO | ENVIADO | VENCIDO | COMPROVANTE | PAGAMENTO | ESTORNO | CANCELADO | REABERTO | ANEXO
  descricao  String
  dados      String? // JSON
  operadorId String?
  createdAt  DateTime @default(now())

  @@index([boletoId, createdAt])
}

/// Pagamento (baixa) de um boleto. Estorno não apaga: marca estornadoEm.
model Pagamento {
  id             String    @id @default(cuid())
  orgId          String
  boletoId       String
  clienteId      String
  valorCentavos  Int
  pagoEm         DateTime
  forma          String?
  origem         String    @default("MANUAL") // MANUAL | COMPROVANTE
  comprovanteId  String?
  observacoes    String?
  operadorId     String?
  estornadoEm    DateTime?
  estornoMotivo  String?
  estornadoPorId String?
  createdAt      DateTime  @default(now())

  @@index([orgId, pagoEm])
  @@index([boletoId])
}

/// Comprovante recebido (WhatsApp/e-mail) ou enviado pelo operador. Receber ≠ pagar: só a revisão gera baixa.
model Comprovante {
  id                     String    @id @default(cuid())
  orgId                  String
  clienteId              String?
  boletoId               String?
  arquivoId              String?
  origem                 String    @default("UPLOAD") // UPLOAD | WHATSAPP | EMAIL
  origemId               String? // id da mensagem no provedor (idempotência)
  texto                  String? // legenda/mensagem recebida
  sha256                 String?
  valorDetectadoCentavos Int?
  dataDetectada          String?
  transacaoId            String?
  instituicao            String?
  confianca              Int       @default(0) // 0–100
  analise                String? // JSON: motivos da identificação
  duplicadoDeId          String?
  status                 String    @default("EM_ANALISE") // EM_ANALISE | APROVADO | REJEITADO
  revisadoPorId          String?
  revisadoEm             DateTime?
  motivoRevisao          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([orgId, origemId])
  @@index([orgId, status])
  @@index([orgId, clienteId])
  @@index([orgId, sha256])
}

/// Anexo de uma automação. envio = N → vai só na N-ésima mensagem da sequência; vazio → em todas. ordem = ordem dentro da mensagem.
model AutomacaoAnexo {
  id          String  @id @default(cuid())
  orgId       String
  automacaoId String
  envio       Int?
  ordem       Int     @default(0)
  arquivoId   String?
  boletoId    String? // COBRANCA: envia o arquivo do boleto e usa os dados da parcela nas variáveis

  @@index([automacaoId])
  @@index([boletoId])
}

// ===================== Agenda (reuniões e tarefas na agenda do celular) =====================

/// Reunião ou tarefa com data/hora. Vai para a agenda do celular via .ics, link "Adicionar à agenda",
/// feed assinável (webcal) e, se conectado, Google Agenda (OAuth).
model Appointment {
  id              String    @id @default(cuid())
  orgId           String
  kind            String    @default("MEETING") // MEETING | TASK
  title           String
  description     String?
  location        String?
  startAt         DateTime
  durationMin     Int       @default(30)
  reminderMin     Int       @default(60) // lembrete antes do início (0 = sem lembrete)
  status          String    @default("SCHEDULED") // SCHEDULED | DONE | CANCELLED
  source          String    @default("MANUAL") // MANUAL | AI | KANBAN
  contactId       String?
  conversationId  String?
  assignedUserId  String?
  createdById     String?
  notifyContact   Boolean   @default(true)
  /// Versão do evento (SEQUENCE do iCalendar): sobe a cada alteração para o celular atualizar.
  sequence        Int       @default(0)
  googleEventId   String?
  googleAccountId String?
  reminderSentAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId, startAt])
  @@index([orgId, assignedUserId])
  @@index([status, startAt])
}

/// Feed de calendário assinável (URL secreta). userId nulo = agenda da empresa inteira.
model CalendarFeed {
  id         String    @id @default(cuid())
  orgId      String
  userId     String?
  tokenHash  String    @unique
  tokenEnc   String // token cifrado (para mostrar o link de novo ao dono)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([orgId, userId])
}

/// Conta Google Agenda conectada por usuário/empresa (OAuth). Só o refresh token cifrado fica salvo.
model GoogleCalendarAccount {
  id              String   @id @default(cuid())
  orgId           String
  userId          String
  email           String?
  refreshTokenEnc String
  calendarId      String   @default("primary")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, userId])
}

/// Configuração da Agenda por empresa (horário de atendimento e agendamento pela IA).
model AgendaSettings {
  id                 String   @id @default(cuid())
  orgId              String   @unique
  aiBooking          Boolean  @default(false)
  workStart          String   @default("09:00")
  workEnd            String   @default("18:00")
  workDays           String   @default("1,2,3,4,5") // 0=domingo … 6=sábado
  defaultDurationMin Int      @default(30)
  minNoticeMin       Int      @default(60)
  notifyContact      Boolean  @default(true)
  reminderMin        Int      @default(60)
  updatedAt          DateTime @updatedAt
}
