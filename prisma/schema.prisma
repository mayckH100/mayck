  orgId          String
  name           String
  slug           String
  baseUrl        String
  authHeaderName String?
  authValueEnc   String?
  lastTestAt     DateTime?
  lastTestStatus String?
  createdAt      DateTime  @default(now())

  @@unique([orgId, slug])
