// ---------- MCKMENSAGEM: disparo para leads com consentimento ----------

model Lead {
  id              String    @id @default(cuid())
  orgId           String
  phone           String // E.164, ex.: +5511999998888
  name            String?
  tags            String    @default("[]")
  status          String    @default("NOVO") // NOVO | CONTATADO | RESPONDEU | QUALIFICADO | AGUARDANDO | CONVERTIDO | DESCARTADO | SEM_RESPOSTA (v1.43.0)
  consentSource   String // FORMULARIO | IMPORTACAO | ANUNCIO_CTWA | MANUAL | MCKBOT (veio do MCKBOT, consentimento pendente)
  consentAt       DateTime? // null = consentimento ainda não registrado (contato vindo do MCKBOT): não recebe campanhas
  optOutAt        DateTime?
  campaignId      String?
  contactId       String? // contato do MCKBOT (mesma pessoa): nome, telefone e opt-out ficam sincronizados
  // IA de qualificação (MCK Mensagens)
  qualifyAttempts Int       @default(0) // respostas negativas recebidas (cada uma gera uma nova tentativa)
  nextAttemptAt   DateTime? // quando AGUARDANDO: próxima tentativa automática
  lastIntent      String? // POSITIVO | NEGATIVO | DUVIDA | SAIR
  aiSummary       String? // resumo curto da IA sobre o lead
  qualifiedAt     DateTime?
  // v1.53.0: Consulta CNPJ / Prospecção — dados do cadastro público da empresa (nunca dado pessoal de sócio além do nome).
  cnpj            String?
  empresa         String? // nome fantasia ou razão social ({empresa} na mensagem)
  dono            String? // nome do sócio/administrador como a fonte devolve ({dono} na mensagem)
  origemDado      String? // ex.: "Cadastro CNPJ – BrasilAPI – 25/11/2026"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([orgId, phone])
  @@index([orgId, status])
  @@index([contactId])
  @@index([status, nextAttemptAt])
}

/**
 * IA de qualificação de leads do MCK Mensagens (usa o provedor/chave configurados em IA do MCKBOT).
 */
model LeadAiSettings {
  orgId           String   @id
  enabled         Boolean  @default(false)
  instructions    String   @default("") // o que a empresa vende, público, como abordar
  offer           String   @default("") // próximo passo oferecido a quem tem interesse (ex.: teste grátis de 1h)
  positiveAction  String   @default("HANDOFF") // HANDOFF (atendente) | FLOW (inicia um fluxo do MCKBOT) | BOT (segue no robô/IA)
  positiveFlowId  String?
  promptTemplate  String? // prompt editável pelo cliente; vazio = padrão do sistema
  positiveMessage String   @default("") // mensagem fixa extra enviada depois da resposta da IA no positivo
  negativeAction  String   @default("RETRY") // RETRY | FLOW | HANDOFF | DISCARD
  negativeFlowId  String?
  doubtAction     String   @default("AI") // AI | FLOW | HANDOFF
  doubtFlowId     String?
  tagPositive     String   @default("lead-qualificado")
  tagWaiting      String   @default("lead-aguardando")
  tagDiscarded    String   @default("lead-descartado")
  retryDays       Int      @default(3)
  maxAttempts     Int      @default(3)
  retryMessage    String   @default("Oi {nome}! Passando de novo por aqui 😊 Ainda posso te ajudar? Se quiser, libero um teste grátis pra você conhecer, sem compromisso.")
  updatedAt       DateTime @updatedAt
}

model Campaign {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  message        String
  channelId      String
  status         String   @default("RASCUNHO") // RASCUNHO | AGENDADA | EM_ANDAMENTO | PAUSADA | CONCLUIDA
  dailyLimit     Int      @default(50)
  minIntervalSec Int      @default(45)
  maxIntervalSec Int      @default(120)
  windowStart    String   @default("09:00")
  windowEnd      String   @default("20:00")
  /// v1.43.0: repescagem automática de quem não respondeu (campanhas antigas ficam desligadas; novas nascem ligadas pela API).
  repescagemAtiva  Boolean   @default(false)
  /// Dias de espera depois do último envio (original ou repescagem) sem resposta.
  repescagemDias   Int       @default(2)
  /// Máximo de repescagens por contato; depois da última sem resposta o lead vira SEM_RESPOSTA.
  repescagemMax    Int       @default(2)
  /// Texto modelo (com {nome} e variações {a|b}) usado quando a IA não está disponível. Vazio = modelo padrão.
  repescagemModelo String    @default("")
  /// Aviso de pausa automática (ex.: número em nível Risco). Nulo = rodando normalmente.
  repescagemPausa  String?
  repescagemPausaEm DateTime?
  /// v1.44.0: pausa automática quando o número da campanha fica em nível Risco. auto = volta sozinha | manual = fica PAUSADA.
  riscoRetomada  String    @default("auto")
  riscoPausa     String?
  riscoPausaEm   DateTime?
  /// v1.46.1: campanha aguardando porque o WhatsApp do canal desconectou (nulo = conectado). Volta sozinha ao reconectar.
  offlinePausa   String?
  offlinePausaEm DateTime?
  /// v1.48.0: até 3 versões extras da mensagem (JSON de textos). Cada contato recebe sempre a mesma versão.
  variacoes       String    @default("[]")
  /// v1.48.0: teste A/B — escolher a versão vencedora sozinha (desligado por padrão) depois de N envios por versão.
  abAutoVencedora Boolean   @default(false)
  abMinimo        Int       @default(30)
  /// Índice da versão vencedora (0 = principal). Nulo = ainda testando.
  abVencedora     Int?
  abVencedoraEm   DateTime?
  /// v1.48.0: início agendado (status AGENDADA até esta hora) e dias da semana em que envia (0 = domingo; padrão todos).
  iniciarEm       DateTime?
  diasSemana      String    @default("0123456")
  /// v1.49.0: imagem ou PDF da campanha por versão (JSON: índice = versão, valor = Arquivo.id ou null). Versão sem arquivo próprio usa o da versão A.
  midias          String    @default("[]")
  /// v1.49.0: campanha que se repete ('' = não repete | DIARIA | SEMANAL | MENSAL). Cada repetição é uma campanha nova (execução).
  recorrencia         String    @default("")
  recorrenciaFim      DateTime?
  recorrenciaProxima  DateTime?
  /// Na execução: campanha original que a criou. Na original: nulo.
  recorrenciaOrigemId String?
  /// Na original: quantas execuções já foram criadas. Na execução: o número dela.
  recorrenciaExecucao Int       @default(0)
  /// v1.49.0: quem recebe (JSON {modo: vinculados|etiqueta|erp, tag?, erp?}), gravado ao iniciar; as repetições usam o público atual.
  publico         String?
  /// v1.49.0: rodízio entre números da organização (desligado por padrão). canaisRodizio = números extras (JSON de Channel.id).
  rodizio         Boolean   @default(false)
  canaisRodizio   String    @default("[]")
  /// v1.51.0: número de envio escolhido pela responsável (true = só channelId, sem rodízio). false = automático (como antes).
  envioFixo            Boolean   @default(false)
  /// v1.51.0: "Enviar mesmo assim" com o número em Risco: vale só para este número (channelId igual) e com envioFixo.
  riscoLiberadoCanalId String?
  riscoLiberadoPor     String?
  riscoLiberadoPorNome String?
  riscoLiberadoEm      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId, status])
  @@index([recorrenciaOrigemId])
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  leadId     String
  status     String    @default("PENDENTE") // PENDENTE | ENVIADA | FALHOU | IGNORADA
  sentAt     DateTime?
  error      String?
  /// v1.43.0: mensagem original enviada (status enviada/entregue/lida vem de Message.status).
  messageId          String?
  /// v1.43.0: primeira resposta do contato depois do envio (qualquer resposta, inclusive "sim").
  respondeuAt        DateTime?
  /// v1.43.0: repescagens enviadas, última e o estado (null | ENVIANDO | RESPONDEU | SEM_RESPOSTA | PARADA).
  repescagens        Int       @default(0)
  ultimaRepescagemAt DateTime?
  ultimaMensagemId   String?
  repescagemStatus   String?
  repescagemMotivo   String?
  repescagemFalhas   Int       @default(0)
  /// Não tentar antes deste horário (após falha passageira).
  repescagemAposAt   DateTime?
  /// v1.46.1: tentativas do envio original que falharam por conexão (máx. 3; depois vira FALHOU).
  tentativas         Int       @default(0)
  /// v1.48.0: versão da mensagem que este contato recebe (0 = principal). Nulo = ainda não escolhida.
  variante           Int?
  /// v1.49.0: número (canal) que envia para este contato no rodízio; fixo depois do primeiro envio. Nulo = número da campanha.
  channelId          String?

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
  @@index([leadId])
}

// ---------- Cobrança (Mercado Pago) ----------

model Subscription {
  id         String   @id @default(cuid())
  orgId      String
  product    String // MCKBOT | MCKMENSAGEM
  status     String   @default("TRIAL") // TRIAL | ATIVA | VENCIDA | BLOQUEADA
  cycle      String   @default("MENSAL") // MENSAL | ANUAL
  validUntil DateTime
  source     String   @default("TRIAL") // TRIAL | MANUAL | MP
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([orgId, product])
}

model BillingEvent {
  id             String    @id @default(cuid())
  orgId          String
  product        String // MCKBOT | MCKMENSAGEM | COMBO
  kind           String // TRIAL | MANUAL | MP | BLOCK | UNBLOCK
  cycle          String?
  amountCents    Int?
  mpPaymentId    String?   @unique
  actorUserId    String?
  prevValidUntil DateTime?
  newValidUntil  DateTime?
  /// v1.27.0: pagamento contado como mês da promoção de entrada do Plano Completo.
  introOffer     Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([orgId, createdAt])
}

/// Lembrete "seu plano vence em X dias": uma linha por (organização, produto, aviso D3/D1, vencimento).
/// A chave única impede enviar o mesmo lembrete duas vezes; renovar muda o vencimento e libera novos avisos.
model RenewalReminder {
  id         String    @id @default(cuid())
  orgId      String
  product    String // MCKBOT | MCKMENSAGEM
  kind       String // D3 | D1
  validUntil DateTime
  status     String    @default("ENVIANDO") // ENVIANDO | ENVIADO | FALHOU
  channel    String    @default("EMAIL")
  attempts   Int       @default(0)
  lastError  String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([orgId, product, kind, validUntil])
  @@index([status, updatedAt])
}

model PlatformSettings {
  id                 String   @id @default("default")
  trialDays          Int      @default(7)
  pricesJson         String   @default("{\"MCKBOT\":{\"MENSAL\":3990,\"ANUAL\":39900},\"MCKMENSAGEM\":{\"MENSAL\":4500,\"ANUAL\":45000},\"COMBO\":{\"MENSAL\":6990,\"ANUAL\":69900}}")
  mpWebhookSecretEnc String?
  siteJson           String   @default("{}") // Site oficial (/empresa): contato, Facebook, tutoriais públicos, promoção em destaque
  waDigestDay        String? // último dia (AAAA-MM-DD, Brasília) do resumo diário de WhatsApp desconectado para o superadmin
  /// SDR com IA: em quais planos o módulo vem liberado (Painel Master). JSON { COMBO, MCKBOT, MCKMENSAGEM }.
  sdrPlansJson       String   @default("{\"COMBO\":true,\"MCKBOT\":false,\"MCKMENSAGEM\":false}")
  /// Planos editáveis no Painel Master (v1.25.0): nome, descrição, itens, módulos e "visível para venda" por plano.
  /// JSON { MCKBOT?, MCKMENSAGEM?, COMBO? }; plano ausente = padrão do código (os códigos dos planos nunca mudam).
  plansJson          String   @default("{}")
  /// Promoção de entrada do Plano Completo (v1.27.0): JSON { enabled, priceCents, months }; '{}' = padrão do código
  /// (ligada, R$ 58,00 nos 2 primeiros meses do COMBO mensal, só para cliente nova).
  introOfferJson     String   @default("{}")
  /// v1.52.0: reajuste de 25/11/2026. Quem já tinha pagamento confirmado antes de legacyAte mantém estes preços
  /// (cópia do pricesJson e do introOfferJson de antes do reajuste). null = sem preço antigo garantido.
  legacyPricesJson   String?
  legacyIntroJson    String?
  legacyAte          DateTime?
  /// v1.52.0: promoção do 1º mês (ex.: Black Friday) e faixa do topo do site. '{}' = desligada.
  promoJson          String   @default("{}")
  updatedAt          DateTime @updatedAt
}

// ---------- Cupons de desconto (parcerias com influenciadores/empresas) ----------
model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique // MAIÚSCULO, ex.: INFLU10
  partner          String? // influenciador ou empresa parceira
  type             String // PERCENT | FIXED
  value            Int // PERCENT: 1..99 (%); FIXED: centavos
  product          String             @default("ALL") // ALL | MCKBOT | MCKMENSAGEM | COMBO
  cycles           String             @default("ALL") // ALL | MENSAL | ANUAL
  validUntil       DateTime?
  maxUses          Int?
  /// Só vale no primeiro pagamento da organização (cupom de parceria "primeiro mês").
  firstPaymentOnly Boolean            @default(false)
  active           Boolean            @default(true)
  createdBy        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  redemptions      CouponRedemption[]
}

// Uso do cupom: gravado só quando o pagamento é confirmado (webhook/confirm do Mercado Pago).
model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id])
  orgId         String
  product       String
  cycle         String
  mpPaymentId   String   @unique
  originalCents Int
  discountCents Int
  finalCents    Int
  status        String   @default("CONFIRMADO") // CONFIRMADO | ESTORNADO
  createdAt     DateTime @default(now())

  @@index([couponId, status])
}

/// "Voltar ao menu": comando global do cliente final do WhatsApp (por organização).
model FlowSettings {
  orgId              String   @id
  menuCommandEnabled Boolean  @default(true)
  menuCommandWords   String   @default("0,menu,voltar") // separadas por vírgula; comparação sem maiúsculas/acentos
  menuFooterEnabled  Boolean  @default(true)
  menuFooterText     String   @default("↩️ Digite 0 para voltar ao menu")
  menuButtonEnabled  Boolean  @default(true) // botão "Voltar ao menu" na Cloud API (no QR usa-se o texto)
  menuFlowId         String? // fluxo do menu; vazio = automático
  updatedAt          DateTime @updatedAt
}

// ---------- MCK MENSAGENS: Automações e Cobranças (FASE 1: clientes, lembretes, marketing) ----------

/// Cliente do módulo Automações e Cobranças. Deduplicado (no código) por telefone/WhatsApp, e-mail e CPF/CNPJ dentro da organização.
model Cliente {
  id                  String    @id @default(cuid())
  orgId               String
  nome                String
  documento           String? // CPF/CNPJ só com dígitos
  telefone            String? // E.164
  whatsapp            String? // E.164 (com código do país)
  email               String? // minúsculo
  emailSecundario     String?
  empresa             String?
  plano               String?
  dataContratacao     DateTime?
  dataVencimento      DateTime?
  valorCentavos       Int?
  parcelas            Int?
  formaPagamento      String?
  status              String    @default("ATIVO") // ATIVO | INATIVO | INADIMPLENTE | CANCELADO
  observacoes         String?
  prefWhatsapp        Boolean   @default(true)
  prefEmail           Boolean   @default(true)
  consentimentoAt     DateTime?
  consentimentoOrigem String? // FORMULARIO | IMPORTACAO | ANUNCIO_CTWA | MANUAL
  marketingOptOutAt   DateTime?
  contactId           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([orgId, nome])
  @@index([orgId, telefone])
  @@index([orgId, whatsapp])
  @@index([orgId, email])
  @@index([orgId, documento])
}

/// Automação de envio (LEMBRETE ou MARKETING) com regra de recorrência em JSON.
model Automacao {
  id          String    @id @default(cuid())
  orgId       String
  nome        String
  categoria   String // LEMBRETE | MARKETING | COBRANCA
  canais      String    @default("[\"WHATSAPP\"]") // JSON: WHATSAPP e/ou EMAIL
  channelId   String? // canal WhatsApp (vazio = o conectado da organização)
  assunto     String? // assunto do e-mail
  mensagem    String
  clienteIds  String    @default("[]") // JSON com os ids dos clientes destinatários
  regra       String // JSON: { tipo: UNICO|DIARIO|SEMANAL|MENSAL|DATAS|ANUAL|INTERVALO, ... }
  timezone    String    @default("America/Sao_Paulo")
  inicio      DateTime
  fim         DateTime?
  maxEnvios   Int?
  status      String    @default("RASCUNHO") // RASCUNHO | ATIVA | PAUSADA | CANCELADA | CONCLUIDA
  geradoAte   DateTime? // horizonte até onde as ocorrências já foram geradas
  reenvio     String? // COBRANCA: JSON { offsets: [-1,0,1,3,7], horario: "10:00", maxPorBoleto: 5, mensagem? }
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId, status])
  @@index([status, geradoAte])
}

/// Um envio programado, por cliente e por canal. "chave" garante idempotência (automação + cliente + canal + horário original).
model Ocorrencia {
  id             String    @id @default(cuid())
  orgId          String
  automacaoId    String
  clienteId      String
  canal          String // WHATSAPP | EMAIL
  chave          String    @unique
  agendadoPara   DateTime // horário programado (pode ser alterado em "só esta ocorrência")
  executarEm     DateTime // próximo momento de execução (agendadoPara ou nova tentativa)
  status         String    @default("PENDENTE") // PENDENTE | PROCESSANDO | ENVIADA | FALHOU | IGNORADA | CANCELADA
  tentativas     Int       @default(0)
  erro           String?
  provedorId     String?
  mensagem       String? // texto só desta ocorrência (edição pontual)
  editada        Boolean   @default(false)
  lockedAt       DateTime?
  enviadoEm      DateTime?
  indice         Int? // posição do envio na sequência (1 = primeiro), usada para os anexos por mensagem
  tipo           String    @default("ENVIO") // ENVIO | REENVIO (cobrança relativa ao vencimento)
  boletoId       String? // cobrança: boleto principal desta mensagem
  partesEnviadas Int       @default(0) // WhatsApp: texto + anexos já enviados (retentativa não repete partes)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([boletoId, status])
  @@index([status, executarEm])
  @@index([orgId, agendadoPara])
  @@index([automacaoId, status])
  @@index([clienteId])
}

/// Histórico de mensagens do módulo (um registro por ocorrência, atualizado a cada tentativa).
model MensagemHistorico {
  id            String    @id @default(cuid())
  orgId         String
  ocorrenciaId  String?   @unique
  automacaoId   String?
  clienteId     String?
  categoria     String
  canal         String
  direcao       String    @default("OUT")
  assunto       String?
  conteudo      String
  agendadoPara  DateTime?
  enviadoEm     DateTime?
  provedorId    String?
  status        String // ENVIADA | FALHOU | IGNORADA | CANCELADA | TENTANDO | RECEBIDA
  erro          String?
  tentativas    Int       @default(0)
  operadorId    String?
  anexos        String? // JSON: [{ arquivoId, nome, boletoId? }]
  boletoId      String?
  comprovanteId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([orgId, createdAt])
  @@index([orgId, clienteId])
  @@index([automacaoId])
}

/// Configurações do módulo por organização.
model AutomacaoConfig {
  orgId                 String   @id
  timezone              String   @default("America/Sao_Paulo")
  janelaInicio          String   @default("08:00")
  janelaFim             String   @default("20:00")
  limiteDiario          Int      @default(500)
  maxTentativas         Int      @default(3)
  backoffSeg            Int      @default(60)
  tiposArquivo          String   @default("pdf,png,jpg,webp") // extensões permitidas para anexos e comprovantes
  tamanhoMaxMb          Int      @default(10)
  reenvioPadrao         String   @default("{\"offsets\":[-1,0,1,3,7],\"horario\":\"10:00\",\"maxPorBoleto\":5}")
  notificarComprovantes Boolean  @default(true) // e-mail aos administradores quando chega comprovante
  updatedAt             DateTime @updatedAt
}

/// Modelos de mensagem reutilizáveis, por categoria (LEMBRETE | MARKETING).
model ModeloMensagem {
  id        String   @id @default(cuid())
  orgId     String
  categoria String
  nome      String
  assunto   String?
  corpo     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, categoria])
}

// ---------------- Automações e Cobranças — FASE 2 (boletos, arquivos, comprovantes, pagamentos) ----------------

/// Metadados de um arquivo (boleto, fatura, documento, comprovante). O conteúdo fica em ArquivoConteudo (Postgres bytea).
model Arquivo {
  id          String   @id @default(cuid())
  orgId       String
  clienteId   String? // vazio = documento genérico (pode ir para qualquer cliente)
  nome        String
  mime        String
  tamanho     Int
  sha256      String
  origem      String   @default("UPLOAD") // UPLOAD | WHATSAPP | EMAIL
  descricao   String?
  criadoPorId String?
  createdAt   DateTime @default(now())

  @@index([orgId, clienteId])
  @@index([orgId, sha256])
}

model ArquivoConteudo {
  arquivoId String @id
  dados     Bytes
}

/// Boleto/fatura/parcela de um cliente. status = financeiro; statusEnvio = mensagem (não se confundem).
model Boleto {
  id                      String    @id @default(cuid())
  orgId                   String
  clienteId               String
  descricao               String
  numeroDocumento         String?
  parcela                 Int?
  totalParcelas           Int?
  valorCentavos           Int
  valorAtualizadoCentavos Int?
  jurosCentavos           Int       @default(0)
  multaCentavos           Int       @default(0)
  descontoCentavos        Int       @default(0)
  valorPagoCentavos       Int       @default(0) // soma dos pagamentos não estornados
  emissao                 DateTime?
  vencimento              DateTime // meio-dia UTC da data de vencimento
  codigoBarras            String?
  linhaDigitavel          String?
  linkPagamento           String?
  arquivoId               String?
  status                  String    @default("PENDENTE") // RASCUNHO | PENDENTE | VENCIDO | EM_ANALISE | PARCIAL | PAGO | CANCELADO
  statusEnvio             String    @default("NAO_ENVIADO") // NAO_ENVIADO | ENVIADO | FALHOU
  enviadoEm               DateTime?
  envios                  Int       @default(0)
  pagoEm                  DateTime?
  origemBaixa             String? // MANUAL | COMPROVANTE
  observacoes             String?
  criadoPorId             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([orgId, status])
  @@index([orgId, clienteId])
  @@index([orgId, vencimento])
}

/// Histórico de alterações de um boleto (só inserção: nada é apagado).
model BoletoEvento {
  id         String   @id @default(cuid())
  orgId      String
  boletoId   String
  tipo       String // CRIADO | EDITADO | ENVIADO | VENCIDO | COMPROVANTE | PAGAMENTO | ESTORNO | CANCELADO | REABERTO | ANEXO
  descricao  String
  dados      String? // JSON
  operadorId String?
  createdAt  DateTime @default(now())

  @@index([boletoId, createdAt])
}

/// Pagamento (baixa) de um boleto. Estorno não apaga: marca estornadoEm.
model Pagamento {
  id             String    @id @default(cuid())
  orgId          String
  boletoId       String
  clienteId      String
  valorCentavos  Int
  pagoEm         DateTime
  forma          String?
  origem         String    @default("MANUAL") // MANUAL | COMPROVANTE
  comprovanteId  String?
  observacoes    String?
  operadorId     String?
  estornadoEm    DateTime?
  estornoMotivo  String?
  estornadoPorId String?
  createdAt      DateTime  @default(now())

  @@index([orgId, pagoEm])
  @@index([boletoId])
}

/// Comprovante recebido (WhatsApp/e-mail) ou enviado pelo operador. Receber ≠ pagar: só a revisão gera baixa.
model Comprovante {
  id                     String    @id @default(cuid())
  orgId                  String
  clienteId              String?
  boletoId               String?
  arquivoId              String?
  origem                 String    @default("UPLOAD") // UPLOAD | WHATSAPP | EMAIL
  origemId               String? // id da mensagem no provedor (idempotência)
  texto                  String? // legenda/mensagem recebida
  sha256                 String?
  valorDetectadoCentavos Int?
  dataDetectada          String?
  transacaoId            String?
  instituicao            String?
  confianca              Int       @default(0) // 0–100
  analise                String? // JSON: motivos da identificação
  duplicadoDeId          String?
  status                 String    @default("EM_ANALISE") // EM_ANALISE | APROVADO | REJEITADO
  revisadoPorId          String?
  revisadoEm             DateTime?
  motivoRevisao          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([orgId, origemId])
  @@index([orgId, status])
  @@index([orgId, clienteId])
  @@index([orgId, sha256])
}

/// Anexo de uma automação. envio = N → vai só na N-ésima mensagem da sequência; vazio → em todas. ordem = ordem dentro da mensagem.
model AutomacaoAnexo {
  id          String  @id @default(cuid())
  orgId       String
  automacaoId String
  envio       Int?
  ordem       Int     @default(0)
  arquivoId   String?
  boletoId    String? // COBRANCA: envia o arquivo do boleto e usa os dados da parcela nas variáveis

  @@index([automacaoId])
  @@index([boletoId])
}

// ===================== Agenda (reuniões e tarefas na agenda do celular) =====================

/// Reunião ou tarefa com data/hora. Vai para a agenda do celular via .ics, link "Adicionar à agenda",
/// feed assinável (webcal) e, se conectado, Google Agenda (OAuth).
model Appointment {
  id              String    @id @default(cuid())
  orgId           String
  kind            String    @default("MEETING") // MEETING | TASK
  title           String
  description     String?
  location        String?
  startAt         DateTime
  durationMin     Int       @default(30)
  reminderMin     Int       @default(60) // lembrete antes do início (0 = sem lembrete)
  status          String    @default("SCHEDULED") // SCHEDULED | DONE | CANCELLED
  source          String    @default("MANUAL") // MANUAL | AI | KANBAN
  contactId       String?
  conversationId  String?
  /// WhatsApp (canal) pelo qual o compromisso foi marcado/conversado — aparece nos avisos internos ("📲 Via: WhatsApp 2 · Amanda").
  channelId       String?
  assignedUserId  String?
  createdById     String?
  notifyContact   Boolean   @default(true)
  /// Versão do evento (SEQUENCE do iCalendar): sobe a cada alteração para o celular atualizar.
  sequence        Int       @default(0)
  googleEventId   String?
  googleAccountId String?
  /// Link do Google Meet gerado pelo Google Agenda (conferenceData) — nulo sem Google conectado.
  meetLink        String?
  /// Contatos adicionais (equipe) que recebem o aviso/link por WhatsApp: JSON [{ "name": string|null, "phone": "5511…" }] (máx. 5).
  extraContacts   String    @default("[]")
  /// Destinatários dos avisos: cliente = notifyContact; responsável (atendente) e contatos adicionais.
  notifyAssignee  Boolean   @default(false)
  notifyExtras    Boolean   @default(true)
  /// Dono(s) da empresa avisados por WhatsApp; equipe pré-configurada escolhida para este compromisso (JSON [{ name, phone }]).
  notifyOwner     Boolean   @default(false)
  teamContacts    String    @default("[]")
  reminderSentAt  DateTime?
  /// v1.46.0: serviço escolhido na página pública de agendamento (source = LINK).
  bookingServiceId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId, startAt])
  @@index([orgId, assignedUserId])
  @@index([status, startAt])
}

/// Feed de calendário assinável (URL secreta). userId nulo = agenda da empresa inteira.
model CalendarFeed {
  id         String    @id @default(cuid())
  orgId      String
  userId     String?
  tokenHash  String    @unique
  tokenEnc   String // token cifrado (para mostrar o link de novo ao dono)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([orgId, userId])
}

/// Conta Google Agenda conectada por usuário/empresa (OAuth). Só o refresh token cifrado fica salvo.
model GoogleCalendarAccount {
  id              String   @id @default(cuid())
  orgId           String
  userId          String
  email           String?
  refreshTokenEnc String
  calendarId      String   @default("primary")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, userId])
}

/// Configuração da Agenda por empresa (horário de atendimento e agendamento pela IA).
model AgendaSettings {
  id                 String   @id @default(cuid())
  orgId              String   @unique
  aiBooking          Boolean  @default(false)
  workStart          String   @default("09:00")
  workEnd            String   @default("18:00")
  workDays           String   @default("1,2,3,4,5") // 0=domingo … 6=sábado
  defaultDurationMin Int      @default(30)
  minNoticeMin       Int      @default(60)
  notifyContact      Boolean  @default(true)
  /// Padrões da empresa para os destinatários dos avisos de novos compromissos.
  notifyAssignee     Boolean  @default(false)
  notifyExtras       Boolean  @default(true)
  /// Avisar por WhatsApp o(s) dono(s) da empresa (User.phone) a cada nova reunião.
  notifyOwner        Boolean  @default(true)
  /// Equipe pré-configurada (JSON, máx. 5): [{ name, phone, active }] — "active" = recebe avisos de reunião.
  teamContacts       String   @default("[]")
  reminderMin        Int      @default(60)
  /// O que a IA atende no WhatsApp: REUNIAO (padrão, igual a antes) | PEDIDO | AMBOS.
  aiHandles          String   @default("REUNIAO")
  /// Tipo de pedido: FISICO (pede dados de entrega) | ONLINE (sem entrega) | AMBOS (entrega só para item físico).
  orderType          String   @default("FISICO")
  /// "Solicitar dados de entrega" mesmo em pedidos online (opção do dono).
  orderAskDelivery   Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

/// Pedido registrado pela IA no WhatsApp (ou alterado pela equipe no painel da Agenda).
model Order {
  id             String   @id @default(cuid())
  orgId          String
  /// Código curto exibido ao cliente e no painel (ex.: P-7K2Q9X).
  code           String
  /// FISICO | ONLINE
  type           String   @default("FISICO")
  /// Itens: JSON [{ "nome": string, "quantidade": number, "obs": string|null }]. Sem preços (a IA não inventa valores).
  items          String   @default("[]")
  description    String?
  /// Dados de entrega (JSON { nome, endereco, cep, numero, complemento, telefone }) — nulo quando não coletados.
  delivery       String?
  /// Fluxo: NOVO | CONFIRMADO | EM_SEPARACAO | PRONTO_RETIRADA | EM_TRANSPORTE | SAIU_ENTREGA | ENTREGUE | FINALIZADO
  /// Exceções: CANCELADO | SUSPENSO | ATRASADO | DEVOLVIDO
  status         String   @default("NOVO")
  /// Pagamento (independente do status): AGUARDANDO | PAGO | PARCIAL | ESTORNADO | NAO_SE_APLICA
  paymentStatus  String   @default("AGUARDANDO")
  /// Contatos adicionais do pedido (JSON [{ "name": string|null, "phone": string }]) — recebem os avisos de status.
  extraContacts  String   @default("[]")
  /// Motivo do cancelamento (preenchido pela loja ao cancelar).
  cancelReason   String?
  source         String   @default("AI") // AI | MANUAL
  notes          String?
  /// Assinatura dos itens/tipo — evita registrar o mesmo pedido duas vezes.
  fingerprint    String?
  contactId      String?
  conversationId String?
  /// WhatsApp (canal) pelo qual o pedido foi feito ("📲 Via: WhatsApp 2 · Amanda").
  channelId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId, createdAt])
  @@index([orgId, status])
  @@index([orgId, contactId])
}

/// Histórico do pedido: mudanças de status, de pagamento, edições e cancelamento (quem, quando, de→para, observação).
model OrderStatusHistory {
  id        String   @id @default(cuid())
  orgId     String
  orderId   String
  /// STATUS | PAGAMENTO | EDICAO | CANCELAMENTO
  kind      String   @default("STATUS")
  fromValue String?
  toValue   String?
  note      String?
  /// Usuário que fez a mudança (nulo = IA/sistema).
  userId    String?
  /// Quantos destinatários receberam o aviso por WhatsApp (0 = não notificado).
  notified  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([orgId, orderId, createdAt])
}

// ---------- Avisos (pop-up com imagem para todos os clientes, criado no Painel Master) ----------

/// Aviso com imagem mostrado no centro da tela. A imagem fica no banco (o disco do Render Free é efêmero).
model Announcement {
  id          String   @id @default(cuid())
  title       String?
  body        String?
  linkUrl     String?
  linkLabel   String?
  /// MCKBOT | MCKMENSAGEM | AMBOS
  app         String   @default("AMBOS")
  /// TODOS | TRIAL | ATIVOS | VENCIDOS
  audience    String   @default("TODOS")
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)
  imageData   Bytes?
  /// image/png | image/jpeg | image/webp (detectado pelos bytes, nunca pela extensão)
  imageMime   String?
  imageSize   Int      @default(0)
  imageSha256 String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, startsAt, endsAt])
}

/// Visualização/fechamento de um aviso por usuário e por dia (America/Sao_Paulo): mostra no máximo 1x por dia.
model AnnouncementView {
  id             String    @id @default(cuid())
  announcementId String
  userId         String
  orgId          String?
  /// AAAA-MM-DD no fuso America/Sao_Paulo
  day            String
  viewedAt       DateTime  @default(now())
  dismissedAt    DateTime?

  @@unique([announcementId, userId, day])
  @@index([announcementId])
}

/// Novidades (Painel Master): conta de rede social conectada pelo administrador da plataforma (uma por rede).
/// provider: instagram | youtube | linkedin | tiktok. Tokens sempre cifrados (AES-256-GCM com MASTER_KEY, lib/crypto).
model SocialAccount {
  id           String    @id @default(cuid())
  provider     String    @unique
  /// Instagram: id da conta profissional (IG business); YouTube: id do canal; LinkedIn: URN/id da organização.
  accountId    String
  accountName  String?
  /// Token de acesso cifrado (Instagram: token da Página do Facebook, sem validade).
  accessToken  String
  /// Refresh token cifrado (YouTube).
  refreshToken String?
  expiresAt    DateTime?
  /// Dados extras da conexão (JSON), ex.: { "pageId", "pageName" } da Página ligada ao Instagram.
  extra        String    @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Novidades: publicação criada no Painel Master e (após aprovação explícita) publicada nas redes e no site /empresa.
model SocialPost {
  id          String    @id @default(cuid())
  title       String
  body        String
  mediaUrl    String?
  /// image | video | nulo
  mediaType   String?
  /// JSON: lista de destinos, ex.: ["site","instagram","youtube"]
  targets     String    @default("[]")
  /// draft | approved (publicando) | published | partial | failed
  status      String    @default("draft")
  /// JSON por destino: { "instagram": { "ok": true, "id": "...", "url": "...", "at": "..." }, "youtube": { "ok": false, "error": "..." } }
  results     String    @default("{}")
  createdById String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

/// Produtos (catálogo do cliente): a IA usa para responder preço, disponibilidade e detalhes.
/// Preços em centavos (R$). stock: disponivel | sob_encomenda | esgotado.
model Product {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  category    String?
  priceCents  Int?
  promoCents  Int?
  description String   @default("")
  /// Detalhes livres: cor, tamanho, ano, km, garantia...
  details     String   @default("")
  stock       String   @default("disponivel")
  quantity    Int?
  link        String?
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, active])
  @@index([orgId, name])
}

// ============================================================================
// MCK ERP — Etapa 1: Fundação + CRM. Tabelas com prefixo Erp, isoladas do MCKBOT.
// Convenções: orgId = empresa (tenant); valores em centavos (Int); JSON em String.
// Nada é excluído fisicamente em documentos: cancelamento é estado + auditoria.
// ============================================================================

/// Filial da empresa (filtro de dashboards e documentos).
model ErpFilial {
  id        String   @id @default(cuid())
  orgId     String
  nome      String
  cnpj      String?
  uf        String?
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([orgId])
}

/// Centro de custo (rateio e filtros).
model ErpCentroCusto {
  id        String   @id @default(cuid())
  orgId     String
  codigo    String
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([orgId, codigo])
}

/// Parceiro de negócio: cliente e/ou fornecedor (cadastro 360º).
model ErpParceiro {
  id                  String               @id @default(cuid())
  orgId               String
  filialId            String?
  tipoPessoa          String // PF | PJ
  documento           String // CPF/CNPJ só dígitos
  nome                String // razão social / nome
  fantasia            String?
  ehCliente           Boolean              @default(true)
  ehFornecedor        Boolean              @default(false)
  inscricaoEstadual   String?
  regimeTributario    String? // SIMPLES | MEI | NORMAL
  cnae                String?
  cnaeDescricao       String?
  situacaoCadastral   String? // ATIVA, BAIXADA... (Receita)
  situacaoConsultaEm  DateTime?
  email               String?
  telefone            String? // E.164
  cep                 String?
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  municipio           String?
  codigoMunicipio     String? // IBGE
  uf                  String?
  limiteCreditoCents  Int                  @default(0)
  score               Int                  @default(500) // 0..1000, adimplência interna
  status              String               @default("ATIVO") // ATIVO | INATIVO | BLOQUEADO
  origem              String? // indicação, site, WhatsApp...
  contactId           String? // vínculo com o contato do MCKBOT (WhatsApp)
  tags                String               @default("[]")
  observacoes         String?
  inscricaoMunicipal  String? // v1.33.0
  condicaoPagamentoId String? // v1.33.0: condição comercial padrão (cliente: vendas; fornecedor: compras)
  tabelaPrecoId       String? // v1.33.0: tabela de preço padrão do cliente
  prazoEntregaDias    Int                  @default(0) // v1.33.0: prazo de entrega do fornecedor (dias), usado em "O que comprar" quando o produto não tem prazo próprio
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  contatos            ErpParceiroContato[]
  oportunidades       ErpOportunidade[]
  interacoes          ErpInteracao[]

  @@unique([orgId, documento])
  @@index([orgId, status])
  @@index([orgId, nome])
}

model ErpParceiroContato {
  id         String      @id @default(cuid())
  parceiroId String
  parceiro   ErpParceiro @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  nome       String
  cargo      String?
  email      String?
  telefone   String?
  principal  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([parceiroId])
}

/// Etapas do funil de vendas (Kanban), configuráveis por empresa.
model ErpEtapaFunil {
  id            String @id @default(cuid())
  orgId         String
  nome          String
  posicao       Int
  cor           String @default("#64748b")
  probabilidade Int    @default(10) // % padrão de fechamento
  tipo          String @default("ABERTA") // ABERTA | GANHA | PERDIDA

  @@index([orgId, posicao])
}

/// Oportunidade (card do funil). Gera orçamento/pedido na etapa 2.
model ErpOportunidade {
  id                  String      @id @default(cuid())
  orgId               String
  filialId            String?
  centroCustoId       String?
  parceiroId          String
  parceiro            ErpParceiro @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  titulo              String
  etapaId             String
  status              String      @default("ABERTA") // ABERTA | GANHA | PERDIDA | CANCELADA
  valorCents          Int         @default(0)
  probabilidade       Int         @default(10)
  custoAquisicaoCents Int         @default(0) // base do CAC
  origem              String?
  responsavelId       String? // userId
  previsaoFechamento  DateTime?
  motivoPerda         String?
  fechadaEm           DateTime?
  correlationId       String // rastreio ponta a ponta (lead → pedido → NF → título)
  posicao             Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([orgId, etapaId, posicao])
  @@index([orgId, status])
  @@index([parceiroId])
}

/// Linha do tempo unificada do cliente: WhatsApp, e-mail, ligação, nota, chamado, eventos do sistema.
model ErpInteracao {
  id             String      @id @default(cuid())
  orgId          String
  parceiroId     String
  parceiro       ErpParceiro @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  oportunidadeId String?
  tipo           String // WHATSAPP | EMAIL | LIGACAO | NOTA | CHAMADO | SISTEMA
  direcao        String? // ENTRADA | SAIDA
  assunto        String?
  conteudo       String      @default("")
  status         String? // ENVIADO | FALHOU | LIDO | ABERTO (chamado) | RESOLVIDO
  canalRef       String? // id externo (mensagem WhatsApp, e-mail)
  userId         String?
  createdAt      DateTime    @default(now())

  @@index([orgId, parceiroId, createdAt])
}

/// Outbox de eventos de domínio: gravado na MESMA transação da mudança.
model ErpEvento {
  id               String    @id @default(cuid())
  orgId            String
  tipo             String // ex.: crm.oportunidade.ganha
  agregado         String // ex.: oportunidade
  agregadoId       String
  correlationId    String?
  payload          String    @default("{}")
  status           String    @default("PENDENTE") // PENDENTE | PROCESSADO | FALHOU (DLQ)
  tentativas       Int       @default(0)
  proximaTentativa DateTime  @default(now())
  ultimoErro       String?
  processadoEm     DateTime?
  createdAt        DateTime  @default(now())

  @@index([status, proximaTentativa])
  @@index([orgId, agregado, agregadoId])
}

/// Idempotência: cada consumidor processa cada evento uma única vez.
model ErpEventoConsumo {
  id         String   @id @default(cuid())
  eventoId   String
  consumidor String
  createdAt  DateTime @default(now())

  @@unique([eventoId, consumidor])
}

/// Grafo de rastreabilidade entre documentos (oportunidade → pedido → OP → NF → título → baixa → lote).
model ErpTraceLink {
  id          String   @id @default(cuid())
  orgId       String
  origemTipo  String
  origemId    String
  destinoTipo String
  destinoId   String
  vinculo     String // gerou, consumiu, faturou, liquidou...
  createdAt   DateTime @default(now())

  @@unique([origemTipo, origemId, destinoTipo, destinoId, vinculo])
  @@index([orgId, destinoTipo, destinoId])
}

/// Fila do hub de integrações (SEFAZ, bancos, transportadoras, WhatsApp, e-mail) com retry.
model ErpIntegracaoJob {
  id               String   @id @default(cuid())
  orgId            String
  provedor         String // brasilapi | sefaz | banco | frete | whatsapp | email
  operacao         String
  payload          String   @default("{}")
  status           String   @default("PENDENTE") // PENDENTE | OK | FALHOU
  tentativas       Int      @default(0)
  proximaTentativa DateTime @default(now())
  ultimoErro       String?
  resultado        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, proximaTentativa])
}

// ======================= MCK ERP · Etapa 2: Produtos, Estoque/WMS, Vendas/OMS =======================
// Quantidades em milésimos (Int): 1 un = 1000; 0,250 kg = 250. Valores em centavos. Percentuais em pontos-base (1% = 100).

model ErpConfig {
  orgId                        String   @id
  descontoMaxBp                Int      @default(1000) // alçada do vendedor (10%); acima disso o pedido vai para aprovação
  bloquearSemCredito           Boolean  @default(true)
  validadeOrcamentoDias        Int      @default(15)
  proximoPedido                Int      @default(1)
  proximoLoteInterno           Int      @default(1)
  proximaSolicitacao           Int      @default(1)
  proximaCotacao               Int      @default(1)
  proximoPedidoCompra          Int      @default(1)
  proximaOp                    Int      @default(1)
  alcadaCompraCents            Int      @default(500000) // pedido de compra até este valor é aprovado ao enviar; acima, só OWNER/ADMIN aprova
  toleranciaPrecoBp            Int      @default(200) // recebimento: diferença de preço NF × pedido aceita sem aprovação
  recebimentoCego              Boolean  @default(false) // conferência da NF-e sem mostrar a quantidade da nota
  multaAtrasoBp                Int      @default(200) // multa por atraso (2%)
  jurosMesBp                   Int      @default(100) // juros de mora ao mês (1%), pro rata dia
  formatoLote                  String   @default("{AA}{MM}{DD}-{SEQ}") // {AAAA} {AA} {MM} {DD} {SKU} {SEQ}
  etiquetaLarguraMm            Int      @default(100)
  etiquetaAlturaMm             Int      @default(50)
  etiquetaDpi                  Int      @default(203) // 203 ou 300 (Zebra)
  // v1.58.0: etiqueta impressa pela balança (EAN-13 começando com 2): dígitos do código do produto (4, 5 ou 6) e o que vem no valor
  balancaDigitos               Int      @default(4)
  balancaValor                 String   @default("PRECO") // PRECO (total em centavos) | PESO (gramas)
  // Alertas diários por WhatsApp para a administração (financeiro e estoque)
  alertaAtivo                  Boolean  @default(false)
  alertaTelefones              String? // JSON: ["+55..."]
  alertaHora                   Int      @default(8) // hora local (fuso da organização)
  alertaDiasAntes              Int      @default(3) // contas a pagar que vencem em até N dias (e as vencidas)
  alertaPagar                  Boolean  @default(true)
  alertaEstoqueMinimo          Boolean  @default(true)
  alertaSemSaidaDias           Int      @default(15) // produto com saldo e sem saída há N dias; 0 = desligado
  alertaUltimoDia              String? // AAAA-MM-DD do último envio automático
  alertaStatus                 String? // JSON: { at, ok, detail }
  relatorioUltimoDia           String? // "YYYY-MM-DD" do último relatório diário enviado ao proprietário
  alertaOpcoes                 String? // JSON (v1.30.0): seções do alerta ligadas/desligadas, dias de validade, consumo, compra pelo WhatsApp
  // v1.36.0: ciclo da ordem de compra (prazos e avisos)
  compraQualidadePadrao        Boolean  @default(false) // toda OC nova passa pela liberação da qualidade
  compraEmBreveDias            Int      @default(2) // "chega em breve" quando faltam até N dias
  compraAvisoEquipeWhats       Boolean  @default(true) // avisos de compras também no WhatsApp dos números de alerta do ERP (se o alerta estiver ligado)
  compraAvisoFornecedor        Boolean  @default(false) // lembrete e cobrança ao fornecedor (DESLIGADO por padrão)
  compraAvisoFornCanal         String   @default("EMAIL") // EMAIL | WHATSAPP | AMBOS
  compraAvisoFornDias          Int      @default(2) // lembrete N dias antes da data prevista
  compraAvisoFornTextoLembrete String? // texto modelo; null = padrão
  compraAvisoFornTextoAtraso   String? // texto modelo; null = padrão
  compraRotinaDia              String? // AAAA-MM-DD da última rotina diária de prazos
  updatedAt                    DateTime @updatedAt
}

/**
 * Aprovação de compra pelo WhatsApp (v1.30.0): o alerta diário lista os itens com estoque baixo com um código;
 * um número autorizado responde "APROVADO" e o sistema cria os pedidos de compra em rascunho. Expira em 48 h.
 * status: PENDENTE | PROCESSANDO | AGUARDANDO_FORNECEDOR | CONCLUIDA | RECUSADA | SUBSTITUIDA | EXPIRADA
 */
model ErpAprovacaoCompra {
  id          String    @id @default(cuid())
  orgId       String
  codigo      String
  dia         String // AAAA-MM-DD do alerta
  status      String    @default("PENDENTE")
  itens       String    @default("[]") // JSON: itens sugeridos (produto, quantidade, fornecedor, custo)
  telefones   String    @default("[]") // JSON: números autorizados a responder (alerta + proprietário)
  estado      String    @default("{}") // JSON: conversa (itens escolhidos, perguntas de fornecedor, pedidos criados)
  mensagens   String    @default("[]") // JSON: ids de mensagens do WhatsApp já tratadas (idempotência)
  versao      Int       @default(0) // trava otimista: cada passo só grava se ninguém gravou antes
  aprovadoPor String?
  aprovadoEm  DateTime?
  expiraEm    DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([orgId, codigo])
  @@index([orgId, status, expiraEm])
}

model ErpProduto {
  id                 String   @id @default(cuid())
  orgId              String
  sku                String
  nome               String
  descricao          String?
  codigoBarras       String?
  unidade            String   @default("UN") // UN, KG, CX, M...
  unidadeCompra      String? // v1.32.0: embalagem de compra (PCT, CX, RL...); vazio = compra na própria unidade
  fatorCompraMil     Int      @default(1000) // v1.32.0: unidades base por embalagem, em milésimos (10 peças = 10000; 2,5 kg = 2500)
  ncm                String?
  cest               String?
  origem             Int      @default(0) // 0 nacional ... 8 (tabela SEFAZ)
  pesoGramas         Int      @default(0)
  controlaLote       Boolean  @default(false)
  controlaValidade   Boolean  @default(false)
  exigeQualidade     Boolean  @default(false) // v1.36.0: compra deste produto passa pela liberação da qualidade antes da conferência
  regraSaida         String   @default("FIFO") // FIFO | FEFO
  estoqueMinimoMil   Int      @default(0)
  pontoPedidoMil     Int      @default(0)
  precoBaseCents     Int      @default(0)
  custoMedioCents    Int      @default(0) // por unidade (1000 mil)
  custosAdicionais   String   @default("[]") // JSON [{ nome, valorCents }] por unidade: embalagem, rótulo, frete... somados ao custo
  tipo               String   @default("REVENDA") // REVENDA | PRODUZIDO | INSUMO | SERVICO
  leadTimeDias       Int      @default(0) // prazo de compra ou de fabricação (MRP)
  loteMinimoMil      Int      @default(0) // lote mínimo de compra/produção (MRP)
  fornecedorPadraoId String?
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([orgId, sku])
  @@index([orgId, nome])
  @@index([orgId, codigoBarras])
}

model ErpTabelaPreco {
  id        String               @id @default(cuid())
  orgId     String
  nome      String
  uf        String? // tabela regional (opcional)
  ativa     Boolean              @default(true)
  createdAt DateTime             @default(now())
  itens     ErpTabelaPrecoItem[]

  @@index([orgId])
}

model ErpTabelaPrecoItem {
  id           String         @id @default(cuid())
  tabelaId     String
  tabela       ErpTabelaPreco @relation(fields: [tabelaId], references: [id], onDelete: Cascade)
  produtoId    String
  qtdMinimaMil Int            @default(0) // preço por volume: vale a partir desta quantidade
  precoCents   Int

  @@unique([tabelaId, produtoId, qtdMinimaMil])
}

model ErpCondicaoPagamento {
  id        String   @id @default(cuid())
  orgId     String
  nome      String // "30/60/90", "À vista"
  prazos    String   @default("[0]") // JSON: dias de cada parcela
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([orgId])
}

model ErpDeposito {
  id        String               @id @default(cuid())
  orgId     String
  filialId  String?
  nome      String
  ativo     Boolean              @default(true)
  createdAt DateTime             @default(now())
  enderecos ErpEnderecoEstoque[]

  @@index([orgId])
}

model ErpEnderecoEstoque {
  id         String      @id @default(cuid())
  orgId      String
  depositoId String
  deposito   ErpDeposito @relation(fields: [depositoId], references: [id], onDelete: Cascade)
  codigo     String // rua-prateleira-posição, ex.: A-01-03 (vai na etiqueta QR)
  ativo      Boolean     @default(true)

  @@unique([depositoId, codigo])
  @@index([orgId])
}

model ErpLote {
  id             String    @id @default(cuid())
  orgId          String
  produtoId      String
  numero         String
  fabricacao     DateTime?
  validade       DateTime?
  status         String    @default("LIBERADO") // LIBERADO | QUARENTENA | BLOQUEADO
  loteFornecedor String? // lote impresso pelo fornecedor (rastro da NF-e)
  fornecedorId   String? // ErpParceiro
  origemTipo     String? // nfe_entrada | op | ajuste | inicial
  origemId       String?
  createdAt      DateTime  @default(now())

  @@unique([orgId, produtoId, numero])
  @@index([orgId, produtoId, validade])
}

/**
 * Saldo por produto + lote + endereço. Disponível = físico − reservado − quarentena (nunca negativo).
 */
model ErpSaldo {
  id            String   @id @default(cuid())
  orgId         String
  produtoId     String
  loteId        String
  enderecoId    String
  fisicoMil     Int      @default(0)
  reservadoMil  Int      @default(0)
  quarentenaMil Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([produtoId, loteId, enderecoId])
  @@index([orgId, produtoId])
}

/**
 * Razão de estoque: só inserção. Toda mudança de saldo físico tem um movimento na mesma transação.
 */
model ErpMovimento {
  id             String   @id @default(cuid())
  orgId          String
  produtoId      String
  loteId         String
  enderecoId     String
  tipo           String // ENTRADA | SAIDA | AJUSTE | TRANSFERENCIA_SAIDA | TRANSFERENCIA_ENTRADA | QUARENTENA | LIBERACAO
  qtdMil         Int // com sinal: + entra, − sai
  custoUnitCents Int      @default(0)
  saldoAposMil   Int
  docTipo        String? // pedido_venda | ajuste | compra | op | inventario
  docId          String?
  motivo         String?
  userId         String?
  correlationId  String?
  createdAt      DateTime @default(now())

  @@index([orgId, produtoId, createdAt])
  @@index([orgId, docTipo, docId])
}

model ErpReserva {
  id           String   @id @default(cuid())
  orgId        String
  pedidoItemId String // id do item de origem: item do pedido de venda ou componente da OP (ver origemTipo)
  origemTipo   String   @default("pedido_venda") // pedido_venda | op
  saldoId      String
  produtoId    String
  loteId       String
  enderecoId   String
  qtdMil       Int
  separadoMil  Int      @default(0)
  status       String   @default("ATIVA") // ATIVA | BAIXADA | LIBERADA
  createdAt    DateTime @default(now())

  @@index([orgId, pedidoItemId])
  @@index([saldoId, status])
}

model ErpPedidoVenda {
  id                  String          @id @default(cuid())
  orgId               String
  numero              Int
  filialId            String?
  centroCustoId       String?
  depositoId          String?
  parceiroId          String
  oportunidadeId      String?
  vendedorId          String?
  tabelaPrecoId       String?
  condicaoPagamentoId String?
  statusOperacional   String          @default("RASCUNHO")
  statusFinanceiro    String          @default("SEM_TITULO")
  subtotalCents       Int             @default(0)
  descontoCents       Int             @default(0)
  freteCents          Int             @default(0)
  totalCents          Int             @default(0)
  descontoMaxItemBp   Int             @default(0)
  motivoBloqueio      String?
  aprovadoPorId       String?
  aprovadoEm          DateTime?
  validadeOrcamento   DateTime?
  nfNumero            String? // nota emitida (externa até a Etapa 4)
  transportadora      String?
  rastreio            String?
  entregueEm          DateTime?
  previsaoEntrega     DateTime?
  motivoCancelamento  String?
  observacoes         String?
  correlationId       String
  caixaSessaoId       String? // venda balcão: sessão de caixa em que foi feita
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  itens               ErpPedidoItem[]

  @@unique([orgId, numero])
  @@index([orgId, statusOperacional])
  @@index([orgId, parceiroId])
  @@index([caixaSessaoId])
}

model ErpPedidoItem {
  id             String         @id @default(cuid())
  pedidoId       String
  pedido         ErpPedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId      String
  descricao      String
  qtdMil         Int
  precoUnitCents Int // por unidade
  descontoBp     Int            @default(0)
  totalCents     Int
  reservadoMil   Int            @default(0)
  separadoMil    Int            @default(0)
  posicao        Int            @default(0)
  loteId         String? // v1.34.0: lote lido no balcão (etiqueta GS1/QR): a baixa sai deste lote

  @@index([pedidoId])
  @@index([produtoId])
}

/**
 * De-para: código do produto no fornecedor → produto interno, com fator (ex.: 1 CX do fornecedor = 12 UN = 12000).
 */
model ErpProdutoFornecedor {
  id               String   @id @default(cuid())
  orgId            String
  parceiroId       String
  codigoFornecedor String
  produtoId        String
  fatorMil         Int      @default(1000)
  createdAt        DateTime @default(now())

  @@unique([orgId, parceiroId, codigoFornecedor])
  @@index([orgId, produtoId])
}

/**
 * NF-e de entrada importada pelo XML: confere, vincula produtos e lança no estoque com lote.
 */
model ErpNfeEntrada {
  id              String              @id @default(cuid())
  orgId           String
  chave           String
  numero          String
  serie           String
  dataEmissao     DateTime?
  parceiroId      String
  emitenteCnpj    String
  emitenteNome    String
  valorTotalCents Int
  autorizada      Boolean             @default(false) // tem protNFe com cStat 100
  pedidoCompraId  String?
  status          String              @default("PENDENTE") // PENDENTE | LANCADA | CANCELADA
  xml             String
  lancadaEm       DateTime?
  lancadaPorId    String?
  createdAt       DateTime            @default(now())
  itens           ErpNfeEntradaItem[]

  @@unique([orgId, chave])
  @@index([orgId, status])
}

model ErpNfeEntradaItem {
  id              String        @id @default(cuid())
  nfeId           String
  nfe             ErpNfeEntrada @relation(fields: [nfeId], references: [id], onDelete: Cascade)
  nItem           Int
  codigo          String
  descricao       String
  ean             String?
  ncm             String?
  cfop            String?
  unidade         String
  qtdMil          Int // na unidade do fornecedor
  valorUnitCents  Int
  custoTotalCents Int // produto + IPI + ST + frete + seguro + outras − desconto
  lotes           String        @default("[]") // JSON do rastro: [{numero, qtdMil, fabricacao, validade}]
  produtoId       String?
  fatorMil        Int           @default(1000)
  lotesGerados    String        @default("[]") // ids dos lotes internos criados no lançamento
  conferidoMil    Int? // conferência física (na unidade do fornecedor)
}

/**
 * Inventário (geral ou cíclico): foto do saldo, contagem (cega opcional), aprovação das divergências e ajuste.
 */
model ErpInventario {
  id            String                  @id @default(cuid())
  orgId         String
  descricao     String
  depositoId    String?
  cego          Boolean                 @default(true)
  status        String                  @default("CONTANDO") // CONTANDO | EM_APROVACAO | CONCLUIDO | CANCELADO
  criadoPorId   String?
  aprovadoPorId String?
  concluidoEm   DateTime?
  fechadoEm     DateTime? // v1.33.0: contagem encerrada (relatório Físico x Sistema congelado)
  fechadoPorId  String?
  notificadoEm  DateTime? // v1.33.0: aviso de divergência enviado ao proprietário (app + WhatsApp)
  resumoJson    String? // v1.33.0: totais do relatório no fechamento (itens divergentes, sobras, faltas, líquido)
  motivoAjuste  String? // v1.33.0: motivo informado na aprovação com a senha do proprietário
  createdAt     DateTime                @default(now())
  contagens     ErpInventarioContagem[]

  @@index([orgId, status])
}

model ErpInventarioContagem {
  id             String        @id @default(cuid())
  inventarioId   String
  inventario     ErpInventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  produtoId      String
  loteId         String
  enderecoId     String
  sistemaMil     Int // saldo físico na abertura
  contadoMil     Int?
  contadoPorId   String?
  contadoEm      DateTime?
  leituras       Int           @default(0) // v1.33.0: quantas leituras de QR somaram nesta linha
  modo           String? // v1.33.0: QR | MANUAL (última forma de contagem)
  custoUnitCents Int           @default(0) // v1.33.0: custo por unidade no fechamento (diferença em R$)

  @@unique([inventarioId, produtoId, loteId, enderecoId])
}

// ======================= Compras =======================
model ErpSolicitacaoCompra {
  id            String               @id @default(cuid())
  orgId         String
  numero        Int
  solicitanteId String?
  centroCustoId String?
  justificativa String?
  origem        String               @default("MANUAL") // MANUAL | MRP
  necessidadeEm DateTime?
  status        String               @default("RASCUNHO") // RASCUNHO | EM_APROVACAO | APROVADA | REPROVADA | ATENDIDA | CANCELADA
  aprovadoPorId String?
  motivo        String?
  createdAt     DateTime             @default(now())
  itens         ErpSolicitacaoItem[]

  @@unique([orgId, numero])
  @@index([orgId, status])
}

model ErpSolicitacaoItem {
  id            String               @id @default(cuid())
  solicitacaoId String
  solicitacao   ErpSolicitacaoCompra @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  produtoId     String
  qtdMil        Int
  atendidoMil   Int                  @default(0)
}

model ErpCotacao {
  id            String               @id @default(cuid())
  orgId         String
  numero        Int
  solicitacaoId String?
  prazoResposta DateTime?
  status        String               @default("ABERTA") // ABERTA | ENCERRADA | CANCELADA
  fornecedores  String               @default("[]") // JSON ids de ErpParceiro convidados
  createdAt     DateTime             @default(now())
  itens         ErpCotacaoItem[]
  respostas     ErpCotacaoResposta[]

  @@unique([orgId, numero])
  @@index([orgId, status])
}

model ErpCotacaoItem {
  id                String     @id @default(cuid())
  cotacaoId         String
  cotacao           ErpCotacao @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  produtoId         String
  qtdMil            Int
  solicitacaoItemId String?
}

model ErpCotacaoResposta {
  id               String     @id @default(cuid())
  cotacaoId        String
  cotacao          ErpCotacao @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  itemId           String
  parceiroId       String
  precoUnitCents   Int
  prazoEntregaDias Int        @default(0)
  condicao         String?
  vencedora        Boolean    @default(false)

  @@unique([itemId, parceiroId])
}

model ErpPedidoCompra {
  id               String                     @id @default(cuid())
  orgId            String
  numero           Int
  parceiroId       String
  status           String                     @default("RASCUNHO") // RASCUNHO | EM_APROVACAO | APROVADO | ENVIADO | RECEBIDO_PARCIAL | AGUARDANDO_NF | AGUARDANDO_QUALIDADE | EM_CONFERENCIA | LIBERADA_ESTOQUE | RECEBIDO | CANCELADO (rótulos em compra.machine.ts)
  totalCents       Int                        @default(0)
  freteCents       Int                        @default(0)
  previsaoEntrega  DateTime?
  condicao         String?
  observacoes      String?
  cotacaoId        String?
  centroCustoId    String?
  aprovadoPorId    String?
  motivo           String?
  // v1.36.0: prazo e etapas
  prazoEntregaDias Int? // prazo da cotação vencedora (dias); previsão = emissão + prazo
  previsaoManual   Boolean                    @default(false) // previsão editada à mão: a emissão não recalcula
  emitidoEm        DateTime?
  entregueEm       DateTime?
  exigeQualidade   Boolean                    @default(false)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  itens            ErpPedidoCompraItem[]
  historico        ErpPedidoCompraHistorico[]

  @@unique([orgId, numero])
  @@index([orgId, status])
  @@index([orgId, parceiroId])
}

/**
 * v1.36.0: linha do tempo da ordem de compra (quem, quando, de → para, observação).
 */
model ErpPedidoCompraHistorico {
  id         String          @id @default(cuid())
  orgId      String
  pedidoId   String
  pedido     ErpPedidoCompra @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  de         String?
  para       String
  evento     String
  userId     String?
  userNome   String?
  observacao String?
  createdAt  DateTime        @default(now())

  @@index([pedidoId, createdAt])
}

/**
 * v1.36.0: avisos de compras (central de avisos da aba Compras + WhatsApp da equipe + fornecedor).
 * Um por OC/tipo/dia (chave única), então a rotina pode rodar várias vezes sem duplicar.
 * tipo: AGUARDANDO_APROVACAO | CHEGA_EM_BREVE | ATRASADO | NF_LANCADA | LIBERADA_ESTOQUE | FORN_LEMBRETE | FORN_ATRASO
 */
model ErpAvisoCompra {
  id        String    @id @default(cuid())
  orgId     String
  pedidoId  String
  tipo      String
  dia       String // AAAA-MM-DD (fuso da empresa)
  destino   String    @default("EQUIPE") // EQUIPE | FORNECEDOR
  titulo    String
  texto     String
  envio     String? // resultado do envio externo (WhatsApp/e-mail), quando houver
  lidoEm    DateTime?
  createdAt DateTime  @default(now())

  @@unique([pedidoId, tipo, dia])
  @@index([orgId, createdAt])
}

model ErpPedidoCompraItem {
  id                String          @id @default(cuid())
  pedidoId          String
  pedido            ErpPedidoCompra @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId         String
  descricao         String
  qtdMil            Int
  precoUnitCents    Int
  totalCents        Int
  recebidoMil       Int             @default(0)
  solicitacaoItemId String?
}

// ======================= Produção =======================
/**
 * Estrutura do produto (BOM): componentes por 1 unidade do produto pai, com perda.
 */
model ErpEstruturaItem {
  id           String @id @default(cuid())
  orgId        String
  produtoId    String
  componenteId String
  qtdMil       Int
  perdaBp      Int    @default(0)
  posicao      Int    @default(0)

  @@unique([produtoId, componenteId])
  @@index([orgId, componenteId])
}

/**
 * Roteiro: operações por unidade, para custo padrão e carga dos centros de trabalho.
 */
model ErpOperacao {
  id             String @id @default(cuid())
  orgId          String
  produtoId      String
  sequencia      Int
  descricao      String
  centroTrabalho String
  segundosPorUn  Int    @default(0)
  setupMinutos   Int    @default(0)
  custoHoraCents Int    @default(0)

  @@index([orgId, produtoId])
}

model ErpOrdemProducao {
  id                 String             @id @default(cuid())
  orgId              String
  numero             Int
  produtoId          String
  qtdPlanejadaMil    Int
  qtdProduzidaMil    Int                @default(0)
  qtdRefugoMil       Int                @default(0)
  status             String             @default("PLANEJADA") // PLANEJADA | LIBERADA | EM_PRODUCAO | ENCERRADA | CANCELADA
  origem             String             @default("MANUAL") // MANUAL | MRP | PEDIDO
  pedidoVendaId      String?
  depositoId         String?
  inicioPrevisto     DateTime?
  fimPrevisto        DateTime?
  encerradaEm        DateTime?
  custoMaterialCents Int                @default(0)
  custoOperacaoCents Int                @default(0)
  motivo             String?
  createdAt          DateTime           @default(now())
  componentes        ErpOpComponente[]
  apontamentos       ErpOpApontamento[]

  @@unique([orgId, numero])
  @@index([orgId, status])
}

model ErpOpComponente {
  id              String           @id @default(cuid())
  opId            String
  op              ErpOrdemProducao @relation(fields: [opId], references: [id], onDelete: Cascade)
  produtoId       String
  qtdPrevistaMil  Int
  qtdReservadaMil Int              @default(0)
  qtdConsumidaMil Int              @default(0)
}

model ErpOpApontamento {
  id             String           @id @default(cuid())
  opId           String
  op             ErpOrdemProducao @relation(fields: [opId], references: [id], onDelete: Cascade)
  qtdBoaMil      Int
  qtdRefugoMil   Int              @default(0)
  loteId         String?
  custoUnitCents Int              @default(0)
  userId         String?
  createdAt      DateTime         @default(now())
}

// ======================= Financeiro =======================
model ErpContaFinanceira {
  id                String   @id @default(cuid())
  orgId             String
  nome              String
  tipo              String   @default("BANCO") // BANCO | CAIXA | CARTAO
  banco             String?
  agencia           String?
  conta             String?
  chavePix          String? // chave Pix do cliente (para gerar Pix copia-e-cola)
  saldoInicialCents Int      @default(0)
  ativa             Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([orgId])
}

/**
 * Plano de contas gerencial (DRE): código hierárquico 1, 1.01, 1.01.001.
 */
model ErpCategoriaFinanceira {
  id     String  @id @default(cuid())
  orgId  String
  codigo String
  nome   String
  tipo   String // RECEITA | DESPESA
  grupo  String  @default("OPERACIONAL") // RECEITA_BRUTA | DEDUCAO | CUSTO | OPERACIONAL | FINANCEIRA | IMPOSTO
  ativa  Boolean @default(true)
  paiId  String? // subcategoria: id da categoria-mãe (mesma organização e mesmo tipo; só 2 níveis)

  @@unique([orgId, codigo])
  @@index([orgId, paiId])
}

/// Tipos de conta a pagar criados pela empresa (além dos fixos: água, luz, internet...).
model ErpTipoConta {
  id          String   @id @default(cuid())
  orgId       String
  nome        String
  categoriaId String? // categoria sugerida quando o usuário não escolhe
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([orgId])
}

model ErpTitulo {
  id              String     @id @default(cuid())
  orgId           String
  tipo            String // RECEBER | PAGAR
  parceiroId      String?
  descricao       String
  docTipo         String? // pedido_venda | nfe_entrada | manual
  docId           String?
  parcela         Int        @default(1)
  parcelas        Int        @default(1)
  valorCents      Int
  pagoCents       Int        @default(0)
  jurosCents      Int        @default(0)
  descontoCents   Int        @default(0)
  emissao         DateTime   @default(now())
  competencia     DateTime   @default(now())
  vencimento      DateTime
  status          String     @default("EM_ABERTO") // EM_ABERTO | PARCIAL | PAGO | CANCELADO
  categoriaId     String?
  centroCustoId   String?
  contaPrevistaId String?
  natureza        String? // a pagar: FORNECEDOR (nulo = fornecedor) | AGUA | LUZ | INTERNET | TELEFONE | ALUGUEL | IMPOSTO | OUTRA_CONTA
  tipoContaId     String? // a pagar: tipo criado pela empresa (ErpTipoConta); natureza fica OUTRA_CONTA
  observacoes     String?
  createdAt       DateTime   @default(now())
  baixas          ErpBaixa[]

  @@unique([orgId, tipo, docTipo, docId, parcela])
  @@index([orgId, tipo, status, vencimento])
  @@index([orgId, parceiroId])
}

model ErpBaixa {
  id            String    @id @default(cuid())
  tituloId      String
  titulo        ErpTitulo @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  contaId       String
  data          DateTime
  valorCents    Int // principal abatido
  jurosCents    Int       @default(0)
  descontoCents Int       @default(0)
  forma         String    @default("PIX") // PIX | BOLETO | TED | DINHEIRO | CARTAO
  estornada     Boolean   @default(false)
  userId        String?
  caixaSessaoId String? // recebimento da venda balcão: sessão de caixa (totais por forma no fechamento)
  createdAt     DateTime  @default(now())

  @@index([caixaSessaoId])
}

/**
 * Movimento da conta (baixas, transferências, tarifas). Base do saldo e da conciliação.
 */
model ErpLancamento {
  id          String   @id @default(cuid())
  orgId       String
  contaId     String
  data        DateTime
  valorCents  Int // + entrada, − saída
  descricao   String
  origemTipo  String // baixa | transferencia | avulso | estorno
  origemId    String?
  categoriaId String?
  conciliado  Boolean  @default(false)
  extratoId   String?
  createdAt   DateTime @default(now())

  @@index([orgId, contaId, data])
}

/**
 * Sessão de caixa do PDV (venda balcão): abertura com o dinheiro inicial, fechamento com o dinheiro contado.
 * Uma sessão aberta por conta do tipo CAIXA: `contaAberta` = contaFinanceiraId enquanto aberta (único), nulo depois.
 * Esperado em dinheiro = abertura + vendas em dinheiro + suprimentos − sangrias; diferença = contado − esperado.
 */
model ErpCaixaSessao {
  id                    String    @id @default(cuid())
  orgId                 String
  contaFinanceiraId     String
  contaAberta           String?   @unique
  status                String    @default("ABERTO") // ABERTO | FECHADO
  abertoPorUserId       String?
  abertoEm              DateTime  @default(now())
  valorAberturaCents    Int       @default(0)
  observacaoAbertura    String?
  qtdVendas             Int       @default(0)
  fechadoPorUserId      String?
  fechadoEm             DateTime?
  valorContadoCents     Int?
  valorEsperadoCents    Int?
  diferencaCents        Int?
  totalVendasCents      Int?
  totalSangriasCents    Int?
  totalSuprimentosCents Int?
  totaisPorForma        String? // JSON: { DINHEIRO: { qtd, valorCents }, PIX: ..., CARTAO: ... }
  observacaoFechamento  String?
  updatedAt             DateTime  @updatedAt

  @@index([orgId, abertoEm])
  @@index([orgId, status])
}

/**
 * Sangria (retirada de dinheiro do caixa) e suprimento (reforço de troco) durante uma sessão.
 */
model ErpCaixaMovimento {
  id           String   @id @default(cuid())
  orgId        String
  sessaoId     String
  tipo         String // SANGRIA | SUPRIMENTO
  valorCents   Int
  motivo       String
  contaOutraId String? // conta de destino (sangria) ou de origem (suprimento), quando o dinheiro vai/vem de outra conta
  userId       String?
  em           DateTime @default(now())

  @@index([sessaoId])
  @@index([orgId, em])
}

/**
 * Maquininha de cartão integrada ao PDV (uma configuração por empresa). Cada empresa usa a PRÓPRIA credencial do
 * provedor (ex.: access token do Mercado Pago dela), guardada cifrada (AES-256-GCM, lib/crypto). Terminal padrão do caixa.
 */
model ErpMaquininhaConfig {
  orgId            String   @id
  provedor         String   @default("mercadopago_point") // mercadopago_point | stone_connect | pagbank_smart | cielo
  ativo            Boolean  @default(true)
  accessTokenEnc   String?
  terminalPadraoId String?
  webhookChave     String   @unique // parte secreta da URL do webhook desta empresa
  webhookSecretEnc String? // chave secreta das notificações (x-signature), opcional
  updatedAt        DateTime @updatedAt
}

/**
 * Cobrança enviada à maquininha a partir do PDV. A venda (pedido, baixa de estoque e recebimento no caixa) só é criada
 * quando o provedor confirma o pagamento; recusada/cancelada/expirada não gera venda.
 */
model ErpCobrancaCartao {
  id                     String   @id @default(cuid())
  orgId                  String
  provedor               String
  terminalId             String
  referencia             String   @unique // external_reference enviado ao provedor
  externalId             String? // id da cobrança no provedor (ex.: ORD... do Mercado Pago)
  valorCents             Int
  tipo                   String // CREDITO | DEBITO
  parcelas               Int      @default(1)
  status                 String   @default("PENDENTE") // PENDENTE | APROVADA | RECUSADA | CANCELADA | EXPIRADA | ERRO_VENDA
  statusProvedor         String?
  detalhe                String?
  cancelamentoSolicitado Boolean  @default(false)
  venda                  String // JSON com os dados da venda balcão (itens, cliente, desconto, conta)
  userId                 String?
  gestor                 Boolean  @default(false)
  caixaSessaoId          String
  pedidoId               String?  @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([orgId, createdAt])
  @@index([orgId, externalId])
}

/**
 * Linha do extrato bancário importado (OFX) para conciliação.
 */
model ErpExtratoLinha {
  id           String   @id @default(cuid())
  orgId        String
  contaId      String
  fitId        String
  data         DateTime
  valorCents   Int
  descricao    String
  lancamentoId String?
  createdAt    DateTime @default(now())

  @@unique([contaId, fitId])
  @@index([orgId, contaId, data])
}

// ======================= Fiscal =======================
/**
 * Dados do emitente e certificado A1 do próprio cliente (cifrado com MASTER_KEY).
 */
model ErpConfigFiscal {
  orgId         String    @id
  razaoSocial   String    @default("")
  fantasia      String?
  cnpj          String    @default("")
  ie            String    @default("")
  crt           Int       @default(1) // 1 Simples Nacional | 2 Simples excesso | 3 Regime normal
  uf            String    @default("SP")
  codMunicipio  String    @default("")
  municipio     String    @default("")
  logradouro    String    @default("")
  numero        String    @default("")
  bairro        String    @default("")
  cep           String    @default("")
  fone          String?
  ambiente      Int       @default(2) // 1 produção | 2 homologação
  serie         Int       @default(1)
  proximoNumero Int       @default(1)
  certPfx       String? // cifrado
  certSenha     String? // cifrado
  certTitular   String?
  certValidade  DateTime?
  updatedAt     DateTime  @updatedAt
}

/**
 * v1.54.0: identidade dos documentos impressos (pedido, orçamento, romaneio, recibo, OC, OP, financeiro, inventário).
 * Cabeçalho configurado pelo cliente (logo + dados). O rodapé "Gerado pelo MCK ERP · MCK DESENVOLVIMENTO · site"
 * é fixo no código e NÃO tem coluna aqui: o cliente não consegue alterar nem desligar.
 */
model ErpDocumentoConfig {
  orgId        String   @id
  nomeExibicao String   @default("")
  cnpj         String   @default("")
  ie           String   @default("")
  logradouro   String   @default("")
  numero       String   @default("")
  bairro       String   @default("")
  cidade       String   @default("")
  uf           String   @default("")
  cep          String   @default("")
  telefone     String   @default("")
  whatsapp     String   @default("")
  email        String   @default("")
  site         String   @default("")
  textoLivre   String   @default("")
  logo         String? // data URL (PNG/JPEG/WEBP, ≤ 500 KB), tipo conferido pelos bytes
  posicaoLogo  String   @default("ESQUERDA") // v1.55.0: ESQUERDA | CENTRO (validado no servidor)
  updatedAt    DateTime @updatedAt
}

/**
 * Regra de tributação: por produto, por prefixo de NCM ou padrão (sem produto e sem NCM).
 */
model ErpRegraFiscal {
  id           String  @id @default(cuid())
  orgId        String
  nome         String
  produtoId    String?
  ncmPrefixo   String?
  cfopDentro   String  @default("5102")
  cfopFora     String  @default("6102")
  csosn        String  @default("102") // Simples Nacional
  cstIcms      String  @default("00") // regime normal
  aliqIcmsBp   Int     @default(0)
  cstIpi       String  @default("53")
  aliqIpiBp    Int     @default(0)
  cstPis       String  @default("49")
  aliqPisBp    Int     @default(0)
  cstCofins    String  @default("49")
  aliqCofinsBp Int     @default(0)
  prioridade   Int     @default(0)

  @@index([orgId, produtoId])
}

model ErpNfeSaida {
  id           String    @id @default(cuid())
  orgId        String
  pedidoId     String?
  parceiroId   String
  numero       Int
  serie        Int
  chave        String
  ambiente     Int
  status       String    @default("ASSINADA") // RASCUNHO | ASSINADA | AUTORIZADA | REJEITADA | CANCELADA
  totalCents   Int
  xml          String
  protocolo    String?
  cStat        String?
  motivo       String?
  autorizadaEm DateTime?
  canceladaEm  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([orgId, chave])
  @@unique([orgId, serie, numero, ambiente])
  @@index([orgId, status])
  @@index([pedidoId])
}

/// Programa "Indique e ganhe": uma linha por empresa indicada (no máximo uma indicação por organização).
/// Quando a indicada tem o primeiro pagamento aprovado, quem indicou ganha 30 dias a mais no plano (uma vez).
model Referral {
  id            String    @id @default(cuid())
  referrerOrgId String
  referredOrgId String    @unique
  code          String
  status        String    @default("PENDENTE") // PENDENTE | CREDITADO | RECUSADO | ESTORNADO
  reason        String? // motivo da recusa (autoindicacao) ou do estorno
  mpPaymentId   String?   @unique // pagamento da indicada que liberou o crédito
  products      String? // JSON: produtos de quem indicou que ganharam os 30 dias
  rewardDays    Int       @default(30)
  creditedAt    DateTime?
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([referrerOrgId, status])
}

// ---------- SDR com IA (v1.18.0) ----------
// Evolui o funil de leads automático: o lead do SDR liga-se ao Contact (MCKBOT) e ao Lead (MCK Mensagens) da mesma
// pessoa; opt-out e consentimento continuam valendo nos dois lados. Lead só com e-mail (prospecção fria) também cabe aqui.

/// Configuração do SDR por empresa. Linha criada na primeira vez que a tela/serviço lê (padrões abaixo).
model SdrSettings {
  orgId           String   @id
  /// SDR ligado na empresa (um clique; tudo já vem configurado).
  enabled         Boolean  @default(false)
  /// Modo automático: cadência, qualificação, funil e agendamento sem aprovação de cada passo.
  autoMode        Boolean  @default(true)
  /// Captura automática de quem chama no WhatsApp (contato novo vira lead).
  captureWhatsapp Boolean  @default(true)
  /// A IA pode marcar a reunião sozinha na Agenda (com confirmação do lead).
  autoBook        Boolean  @default(true)
  /// Segmento padrão (escolhe a cadência pronta).
  segment         String   @default("geral")
  /// Perguntas de qualificação: JSON [{ id, pergunta, peso }].
  questionsJson   String   @default("[]")
  warmScore       Int      @default(40)
  hotScore        Int      @default(70)
  workStart       String   @default("09:00")
  workEnd         String   @default("18:00")
  workDays        String   @default("1,2,3,4,5")
  dailyLimit      Int      @default(40)
  /// Horas sem resposta para começar o acompanhamento de quem chamou no WhatsApp.
  silenceHours    Int      @default(3)
  /// Formulário público: token do link /f/<token>.
  formToken       String?  @unique
  formEnabled     Boolean  @default(true)
  formTitle       String   @default("Fale com a gente")
  alertHot        Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

/// Cadência: passos com atraso em dias a partir da entrada (JSON [{ dia, canal: WHATSAPP|EMAIL, assunto?, texto }]).
model SdrCadence {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  segment   String   @default("geral")
  stepsJson String   @default("[]")
  active    Boolean  @default(true)
  /// Cadência padrão pronta (criada pelo sistema; pode ser editada).
  builtIn   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, segment])
}

model SdrLead {
  id               String    @id @default(cuid())
  orgId            String
  name             String?
  company          String?
  segment          String?
  phone            String? // E.164
  email            String?
  source           String    @default("MANUAL") // MANUAL | IMPORTACAO | WHATSAPP | FORMULARIO
  stage            String    @default("NOVO") // NOVO | CONTATADO | RESPONDEU | QUALIFICADO | REUNIAO | GANHO | PERDIDO
  score            Int       @default(0)
  temperature      String    @default("FRIO") // FRIO | MORNO | QUENTE
  ownerUserId      String?
  consentAt        DateTime?
  consentSource    String?
  optOutAt         DateTime?
  /// Token do link de descadastro do e-mail (/descadastro/<token>).
  unsubToken       String    @unique
  contactId        String?
  leadId           String?
  answersJson      String    @default("{}")
  aiSummary        String?
  cadenceId        String?
  cadenceStep      Int       @default(0)
  /// ESPERA (aguardando silêncio do WhatsApp) | ATIVA | APROVACAO | PARADA | CONCLUIDA | SEM
  cadenceStatus    String    @default("SEM")
  cadenceStartedAt DateTime?
  nextStepAt       DateTime?
  stopReason       String?
  lastContactAt    DateTime?
  lastReplyAt      DateTime?
  hotAlertAt       DateTime?
  appointmentId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([orgId, phone])
  @@unique([orgId, email])
  @@index([orgId, stage])
  @@index([orgId, contactId])
  @@index([cadenceStatus, nextStepAt])
}

/// Histórico do lead (entrada, envios, respostas, qualificação, reunião, avisos). Base das métricas.
model SdrEvent {
  id        String   @id @default(cuid())
  orgId     String
  leadId    String
  type      String // CRIADO | ETAPA | ENVIO | PULO | RESPOSTA | QUALIFICACAO | QUENTE | REUNIAO | PARADA | OPTOUT | NOTA
  channel   String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([orgId, leadId, createdAt])
  @@index([orgId, type, createdAt])
}

// ---------- v1.41.0: Inbox — respostas rápidas, distribuição, horário, pesquisa de satisfação e mensagens agendadas ----------

/// Configuração do atendimento do Inbox por organização (sem registro = tudo desligado, comportamento antigo).
model InboxSettings {
  orgId              String   @id
  /// Distribuição automática de conversas que vão para humano.
  autoAssign         Boolean  @default(false)
  /// rodizio | menos_ocupado
  assignStrategy     String   @default("rodizio")
  /// Só distribui para quem está com o app aberto (sessão ativa nos últimos 15 min).
  assignOnlineOnly   Boolean  @default(true)
  /// Membros que participam (JSON: [userId,...]); vazio = todos com acesso ao Inbox e ao canal.
  assignUserIds      String   @default("[]")
  lastAssignedUserId String?
  /// Horário de atendimento (JSON: [{ dia: 0-6, inicio: "08:00", fim: "18:00" }]) no fuso da organização.
  hoursEnabled       Boolean  @default(false)
  hours              String   @default("[]")
  awayMessage        String   @default("")
  awayEveryHours     Int      @default(12)
  /// Pesquisa de satisfação (nota 1 a 5) ao encerrar a conversa.
  csatEnabled        Boolean  @default(false)
  csatQuestion       String   @default("")
  csatThanks         String   @default("")
  updatedAt          DateTime @updatedAt
}

/// Resposta rápida do Inbox: digitar "/atalho" no campo de mensagem insere o texto (variáveis {nome} e {atendente}).
model QuickReply {
  id          String   @id @default(cuid())
  orgId       String
  shortcut    String
  text        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, shortcut])
}

/// Pesquisa de satisfação enviada ao encerrar a conversa; a nota (1 a 5) vem da resposta seguinte, em até 24 h.
model CsatRating {
  id             String    @id @default(cuid())
  orgId          String
  conversationId String
  contactId      String
  assignedUserId String?
  askedAt        DateTime  @default(now())
  /// Nota 1–5 (nulo = não respondeu ou respondeu outra coisa).
  score          Int?
  answeredAt     DateTime?
  /// PENDENTE | RESPONDIDA | IGNORADA (respondeu sem nota) | EXPIRADA
  status         String    @default("PENDENTE")

  @@index([orgId, askedAt])
  @@index([contactId, status])
}

/// Mensagem agendada pelo atendente no Inbox (enviada pelo agendador do servidor na data/hora).
model ScheduledMessage {
  id             String   @id @default(cuid())
  orgId          String
  conversationId String
  contactId      String
  body           String
  sendAt         DateTime
  /// PENDENTE | ENVIANDO | ENVIADA | FALHOU | CANCELADA
  status         String   @default("PENDENTE")
  createdById    String?
  messageId      String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, sendAt])
  @@index([orgId, conversationId])
}

/// v1.44.0: chave Pix da empresa para cobranças na conversa (BR Code estático, sem intermediário).
model PixSettings {
  orgId     String   @id
  /// cpf | cnpj | email | telefone | aleatoria
  keyType   String
  key       String
  name      String
  city      String
  updatedAt DateTime @updatedAt
}

/// v1.44.0: cobrança Pix enviada numa conversa do Inbox (baixa manual).
model PixCharge {
  id             String    @id @default(cuid())
  orgId          String
  conversationId String
  contactId      String
  amountCents    Int
  description    String    @default("")
  txid           String
  code           String
  /// PENDENTE | PAGA | CANCELADA
  status         String    @default("PENDENTE")
  /// Token aleatório da imagem pública do QR (chat do site).
  publicToken    String    @unique
  createdById    String?
  paidAt         DateTime?
  paidById       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orgId, createdAt])
  @@index([conversationId])
}

/// v1.44.0: links wa.me rastreáveis ("Olá! [ref:instagram-bio]") para saber de onde veio cada conversa.
model OrigemLink {
  id        String   @id @default(cuid())
  orgId     String
  code      String
  name      String
  channelId String?
  text      String   @default("Olá!")
  createdAt DateTime @default(now())

  @@unique([orgId, code])
}

/// v1.44.0: chat para o site do cliente (um por canal do tipo "site").
model SiteWidget {
  channelId      String   @id
  orgId          String
  /// Identificador público usado no <script data-org="...">.
  publicKey      String   @unique
  color          String   @default("#d90429")
  title          String   @default("Fale com a gente")
  welcome        String   @default("Olá! Como podemos ajudar?")
  /// Domínios autorizados (um por linha). Vazio = qualquer site.
  allowedOrigins String   @default("")
  /// Pedir nome (e WhatsApp opcional) antes da 1ª mensagem.
  askName        Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

/// v1.46.0: página pública de agendamento da empresa (/agendar/:slug).
model BookingPage {
  orgId        String   @id
  slug         String   @unique
  enabled      Boolean  @default(false)
  title        String   @default("")
  intro        String   @default("")
  /// Até quantos dias à frente o cliente pode marcar.
  maxDaysAhead Int      @default(30)
  updatedAt    DateTime @updatedAt
}

/// v1.46.0: serviço oferecido na página pública de agendamento (nome, duração, preço opcional).
model BookingService {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  durationMin Int      @default(30)
  priceCents  Int?
  description String   @default("")
  active      Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
}

/// v1.47.0: áudio gravado pelo vendedor/responsável (biblioteca). A IA escolhe pelo contexto e envia como áudio gravado (PTT).
model VoiceClip {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  /// Quando usar (a IA lê isto para escolher o áudio).
  whenToUse   String    @default("")
  /// O que é dito no áudio (a IA não promete nada além disto).
  transcript  String    @default("")
  /// OGG/Opus pronto para o WhatsApp.
  audio       Bytes
  seconds     Float     @default(0)
  waveform    Bytes?
  active      Boolean   @default(true)
  useCount    Int       @default(0)
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId, active])
}

/// v1.47.0: voz clonada (dado biométrico, LGPD art. 11): aceite por escrito do dono da voz, amostra cifrada, exclusão a pedido.
model VoiceProfile {
  id                String    @id @default(cuid())
  orgId             String
  /// Nome do dono da voz (vendedor ou responsável da empresa).
  ownerName         String
  ownerRole         String    @default("")
  ownerEmail        String    @default("")
  /// Texto do termo aceito (guardado como foi aceito) e quem/quando/de onde aceitou.
  consentText       String
  consentVersion    String    @default("")
  consentAt         DateTime
  consentIp         String?
  consentUserId     String?
  /// Amostra (OGG/Opus) cifrada com AES-256-GCM; apagada na exclusão.
  sampleEnc         Bytes?
  sampleSeconds     Float     @default(0)
  /// Id da voz no servidor de voz (worker); não identifica a pessoa.
  workerVoiceId     String    @unique
  /// Voz-base do modo rápido (Gemini TTS): Puck (masculina) ou Kore (feminina); o timbre é trocado pelo clonado.
  baseVoice         String    @default("Puck")
  /// AGUARDANDO_AMOSTRA | NA_FILA | PROCESSANDO | PRONTA | ATIVA | ERRO | EXCLUIDA
  status            String    @default("AGUARDANDO_AMOSTRA")
  error             String?
  attempts          Int       @default(0)
  previewOgg        Bytes?
  previewText       String    @default("")
  activatedAt       DateTime?
  deletedAt         DateTime?
  deletedReason     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([orgId, status])
}

/// v1.47.0: cache das frases já geradas na voz clonada (mesma frase não é gerada de novo).
model VoiceCloneCache {
  id        String   @id @default(cuid())
  orgId     String
  profileId String
  textHash  String
  ogg       Bytes
  seconds   Float
  waveform  Bytes?
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@unique([profileId, textHash])
  @@index([orgId, createdAt])
}

/** v1.53.0: cache da Consulta CNPJ (dados públicos do cadastro da empresa; 30 dias). Compartilhado entre empresas. */
model CnpjCache {
  cnpj         String   @id
  fonte        String
  dados        String // JSON da ficha (sem CPF de sócio)
  consultadoEm DateTime @default(now())
}

/** v1.53.0: uso diário da Consulta CNPJ por empresa (limite de consultas na fonte por dia). */
model CnpjUso {
  orgId     String
  dia       String // AAAA-MM-DD (Brasília)
  consultas Int    @default(0)
  fonte     Int    @default(0)

  @@id([orgId, dia])
}
